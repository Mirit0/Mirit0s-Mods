// capri-mod: 1
// id: mk002-emoji-default
// name: Emoji Smileys & Emotion
// version: 2.1.14
// author: Mirit0
// description: Default emoji's for Caprichat

// Twemoji 17.0.1 (c) Twitter and contributors, CC BY 4.0.
// https://github.com/jdecked/twemoji
// Artwork repacked into PNG sprite atlases.

using System;
using System.IO;
using CapriDesktop;
public sealed class MK002EmojiSmileys : ICapriMod
{
    private string published;
    public void Start(ICapriHost host)
    {
        string root = Directory.GetParent(host.Folder).FullName;
        string folder = Path.Combine(root, "mk002-caprichat-data", "emoji-packs");
        Directory.CreateDirectory(folder);
        published = Path.Combine(folder, "smileys.png");
        string temp = published + ".new";
        File.WriteAllBytes(temp, Convert.FromBase64String(Art));
        if (File.Exists(published)) File.Delete(published);
        File.Move(temp, published);
        host.Log("MK002 Smileys emoji pack enabled.");
    }
    public bool Heard(string words) { return false; }
    public void Stop()
    {
        try { if (published != null && File.Exists(published)) File.Delete(published); }
        catch (IOException) { }
        catch (UnauthorizedAccessException) { }
    }
    private const string Art = "";
}
