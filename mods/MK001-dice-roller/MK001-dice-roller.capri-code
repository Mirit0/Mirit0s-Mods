private const uint WHDR_DONE = 1;
private byte[][] clips;
private ICapriHost logger;
private readonly object chooseLock = new object();
private readonly Random choose = new Random();
[StructLayout(LayoutKind.Sequential, Pack = 2)]
private struct WaveFormat
{
public ushort FormatTag, Channels;
public uint SamplesPerSecond, BytesPerSecond;
public ushort BlockAlign, BitsPerSample, Size;
}
[StructLayout(LayoutKind.Sequential)]
private struct WaveHeader
{
public IntPtr Data;
public uint Length, Recorded;
public IntPtr User;
public uint Flags, Loops;
public IntPtr Next, Reserved;
}
[DllImport("winmm.dll", EntryPoint = "waveOutOpen")]
private static extern uint WaveOutOpen(out IntPtr device, IntPtr deviceId,
ref WaveFormat format, IntPtr callback, IntPtr instance, uint flags);
[DllImport("winmm.dll", EntryPoint = "waveOutPrepareHeader")]
private static extern uint WaveOutPrepareHeader(IntPtr device, IntPtr header, uint size);
[DllImport("winmm.dll", EntryPoint = "waveOutWrite")]
private static extern uint WaveOutWrite(IntPtr device, IntPtr header, uint size);
[DllImport("winmm.dll", EntryPoint = "waveOutUnprepareHeader")]
private static extern uint WaveOutUnprepareHeader(IntPtr device, IntPtr header, uint size);
[DllImport("winmm.dll", EntryPoint = "waveOutReset")]
private static extern uint WaveOutReset(IntPtr device);
[DllImport("winmm.dll", EntryPoint = "waveOutClose")]
private static extern uint WaveOutClose(IntPtr device);
internal void Prepare(ICapriHost host)
{
logger = host;
clips = new byte[ClipData.Length][];
for (int i = 0; i < ClipData.Length; ++i)
{
byte[] compressed = Convert.FromBase64String(ClipData[i]);
using (MemoryStream input = new MemoryStream(compressed, false))
using (System.IO.Compression.DeflateStream unzip =
new System.IO.Compression.DeflateStream(input,
System.IO.Compression.CompressionMode.Decompress))
using (MemoryStream output = new MemoryStream())
{
unzip.CopyTo(output);
clips[i] = output.ToArray();
}
if (clips[i].Length < 2000 || clips[i].Length > Rate * 5)
throw new InvalidDataException("Dice sound #" + (i + 1) + " is invalid.");
}
host.Log("MK001: 15 PCM clips decoded (nine dice, party horn, five coins).");
}
private const double PitchVariationPercent = 5.0;
private const double VolumeVariationPercent = 5.0;
private sealed class DiceSoundEvent
{
internal int Index, Offset;
internal double Pitch, Volume;
}
internal void PlayDice(int physicalCount, bool perfect, double revealSeconds, int extraPerDie)
{
if (clips == null || (physicalCount == 0 && !perfect)) return;
extraPerDie = Math.Max(0, Math.Min(3, extraPerDie));
List<DiceSoundEvent> events = new List<DiceSoundEvent>();
lock (chooseLock)
{
int overlap = Math.Max(0, DiceRoller.DiceSoundOverlapMilliseconds) * Rate / 1000;
for (int i = 0; i < physicalCount; ++i)
{
DiceSoundEvent previous = PickSound((int)(Rate * Math.Min(0.55, i * 0.11)));
events.Add(previous);
for (int j = 0; j < extraPerDie; ++j)
{
int length = clips[previous.Index].Length;
int nextStart = previous.Offset + Math.Max(1, length - overlap);
previous = PickSound(nextStart);
events.Add(previous);
}
}
}
Thread thread = new Thread(new ThreadStart(delegate
{
try { PlayMixed(Mix(events, physicalCount, perfect, revealSeconds, extraPerDie > 0)); }
catch (Exception error)
{
if (logger != null) logger.Log("MK001: dice playback failed: " + error.Message);
}
}));
thread.IsBackground = true;
thread.Name = "MK001 mixed dice audio";
thread.Start();
}
internal void PlayCoin(Action whenPlaying)
{
if (clips == null || clips.Length < 15)
{
if (whenPlaying != null) whenPlaying();
return;
}
DiceSoundEvent sound;
lock (chooseLock)
{
int index = 10 + choose.Next(5);
sound = new DiceSoundEvent {
Index = index, Offset = 0,
Pitch = 1.0 + ((choose.NextDouble() * 2.0 - 1.0) * PitchVariationPercent / 100.0),
Volume = 1.0 + ((choose.NextDouble() * 2.0 - 1.0) * VolumeVariationPercent / 100.0)
};
}
Thread thread = new Thread(new ThreadStart(delegate
{
bool notified = false;
Action start = delegate
{
if (notified) return;
notified = true;
if (whenPlaying != null) whenPlaying();
};
try { PlayMixed(Mix(new List<DiceSoundEvent> { sound }, 1, false, 0, false), start); }
catch (Exception error)
{
if (logger != null) logger.Log("MK001: coin sound failed: " + error.Message);
}
finally { start(); } // Even an unavailable sound device must not freeze the flip.
}));
thread.IsBackground = true;
thread.Name = "MK001 coin audio first";
thread.Start();
}
private DiceSoundEvent PickSound(int offset)
{
return new DiceSoundEvent {
Index = choose.Next(9), Offset = offset,
Pitch = 1.0 + ((choose.NextDouble() * 2.0 - 1.0) * PitchVariationPercent / 100.0),
Volume = 1.0 + ((choose.NextDouble() * 2.0 - 1.0) * VolumeVariationPercent / 100.0)
};
}
private byte[] Mix(List<DiceSoundEvent> sounds, int physicalCount,
bool confetti, double revealSeconds, bool extended)
{
int revealSample = (int)(Rate * revealSeconds);
int total = 0;
foreach (DiceSoundEvent sound in sounds)
{
int length = clips[sound.Index].Length;
total = Math.Max(total, sound.Offset + length);
}
if (confetti) total = Math.Max(total, revealSample + clips[9].Length);
if (total < 1) return new byte[0];
int[] accum = new int[total];
double diceVolume = Math.Min(1.0, 1.22 / Math.Sqrt(Math.Max(1, physicalCount)));
if (extended) diceVolume *= 0.68;
foreach (DiceSoundEvent sound in sounds)
{
byte[] clip = clips[sound.Index];
double[] pitched = PitchWithoutSpeedup(clip, sound.Pitch);
double gain = diceVolume * sound.Volume;
for (int j = 0; j < clip.Length; ++j)
accum[sound.Offset + j] += (int)Math.Round(pitched[j] * gain);
}
if (confetti)
{
// The previous celebration sound is gone. The ninth-index clip is now the
// supplied party horn, and it plays only on a perfect dice result.
// Use the existing pitch-preserving sound shifter and the exact same
// random +/-5 percent pitch / volume ranges as other MK001 sounds.
byte[] horn = clips[9];
double hornPitch;
double hornVolume;
lock (chooseLock)
{
hornPitch = 1.0 + ((choose.NextDouble() * 2.0 - 1.0) * PitchVariationPercent / 100.0);
hornVolume = 1.0 + ((choose.NextDouble() * 2.0 - 1.0) * VolumeVariationPercent / 100.0);
}
double[] pitchedHorn = PitchWithoutSpeedup(horn, hornPitch);
for (int j = 0; j < horn.Length; ++j)
accum[revealSample + j] += (int)Math.Round(pitchedHorn[j] * 0.90 * hornVolume);
}
byte[] mixed = new byte[total];
for (int i = 0; i < total; ++i)
{
int v = accum[i] + 128;
mixed[i] = (byte)(v < 0 ? 0 : v > 255 ? 255 : v);
}
return mixed;
}
private static double[] PitchWithoutSpeedup(byte[] clip, double pitch)
{
int count = clip.Length;
double[] result = new double[count];
double[] weight = new double[count];
const int grain = 720; // 40 ms at 18 kHz
const int hop = grain / 2;
for (int start = -hop; start < count; start += hop)
{
for (int k = 0; k < grain; ++k)
{
int dest = start + k;
if (dest < 0 || dest >= count) continue;
double src = start + k * pitch;
src = Math.Max(0, Math.Min(count - 1, src));
int ix = (int)src;
int iy = Math.Min(count - 1, ix + 1);
double sample = (clip[ix] - 128) * (1 - (src - ix)) +
(clip[iy] - 128) * (src - ix);
double w = k < hop ? (k + 0.5) / hop : (grain - k - 0.5) / hop;
result[dest] += sample * w;
weight[dest] += w;
}
}
for (int i = 0; i < count; ++i)
result[i] = weight[i] > 0 ? result[i] / weight[i] : clip[i] - 128;
return result;
}
private void PlayMixed(byte[] pcm, Action whenPlaying = null)
{
if (pcm.Length == 0)
{
if (whenPlaying != null) whenPlaying();
return;
}
uint error = 0;
IntPtr device = IntPtr.Zero;
IntPtr headerPtr = IntPtr.Zero;
GCHandle pinned = new GCHandle();
bool prepared = false;
uint headerBytes = (uint)Marshal.SizeOf(typeof(WaveHeader));
try
{
WaveFormat format = new WaveFormat {
FormatTag = 1, Channels = 1, SamplesPerSecond = Rate,
BytesPerSecond = Rate, BlockAlign = 1, BitsPerSample = 8, Size = 0
};
error = WaveOutOpen(out device, new IntPtr(-1), ref format,
IntPtr.Zero, IntPtr.Zero, 0);
if (error != 0) throw new InvalidOperationException("waveOutOpen error " + error);
pinned = GCHandle.Alloc(pcm, GCHandleType.Pinned);
headerPtr = Marshal.AllocHGlobal((int)headerBytes);
WaveHeader header = new WaveHeader {
Data = pinned.AddrOfPinnedObject(), Length = (uint)pcm.Length, Loops = 1
};
Marshal.StructureToPtr(header, headerPtr, false);
error = WaveOutPrepareHeader(device, headerPtr, headerBytes);
if (error != 0) throw new InvalidOperationException("waveOutPrepareHeader error " + error);
prepared = true;
error = WaveOutWrite(device, headerPtr, headerBytes);
if (error != 0) throw new InvalidOperationException("waveOutWrite error " + error);
if (whenPlaying != null) whenPlaying();
int limit = Environment.TickCount;
while (true)
{
WaveHeader status = (WaveHeader)Marshal.PtrToStructure(headerPtr, typeof(WaveHeader));
if ((status.Flags & WHDR_DONE) != 0) break;
if (unchecked(Environment.TickCount - limit) > 1000 + pcm.Length * 1000L / Rate)
throw new TimeoutException("waveOut completion timed out.");
Thread.Sleep(25);
}
}
catch (Exception error1)
{
if (logger != null) logger.Log("MK001: waveOut unavailable (" + error1.Message + "); trying WAV fallback.");
try { PlayFallback(pcm, whenPlaying); }
catch (Exception fallback)
{
if (logger != null) logger.Log("MK001: both audio backends failed: " + fallback.Message);
}
}
finally
{
if (device != IntPtr.Zero)
{
if (prepared)
{
WaveOutReset(device);
WaveOutUnprepareHeader(device, headerPtr, headerBytes);
}
WaveOutClose(device);
}
if (headerPtr != IntPtr.Zero) Marshal.FreeHGlobal(headerPtr);
if (pinned.IsAllocated) pinned.Free();
}
}
private static void PlayFallback(byte[] pcm, Action whenPlaying)
{
using (MemoryStream stream = new MemoryStream())
{
using (BinaryWriter write = new BinaryWriter(stream, Encoding.ASCII, true))
{
write.Write(Encoding.ASCII.GetBytes("RIFF"));
write.Write(36 + pcm.Length);
write.Write(Encoding.ASCII.GetBytes("WAVEfmt "));
write.Write(16); write.Write((short)1); write.Write((short)1);
write.Write(Rate); write.Write(Rate); write.Write((short)1);
write.Write((short)8);
write.Write(Encoding.ASCII.GetBytes("data"));
write.Write(pcm.Length); write.Write(pcm);
write.Flush();
stream.Position = 0;
using (System.Media.SoundPlayer player = new System.Media.SoundPlayer(stream))
{
player.Load();
if (whenPlaying != null) whenPlaying();
player.PlaySync();
}
}
}
}
}
private struct V3
{
internal double X, Y, Z;
internal V3(double x, double y, double z) { X = x; Y = y; Z = z; }
public static V3 operator +(V3 a, V3 b) { return new V3(a.X+b.X,a.Y+b.Y,a.Z+b.Z); }
public static V3 operator -(V3 a, V3 b) { return new V3(a.X-b.X,a.Y-b.Y,a.Z-b.Z); }
public static V3 operator *(V3 a, double f) { return new V3(a.X*f,a.Y*f,a.Z*f); }
internal static double Dot(V3 a, V3 b) { return a.X*b.X+a.Y*b.Y+a.Z*b.Z; }
internal static V3 Cross(V3 a, V3 b) { return new V3(a.Y*b.Z-a.Z*b.Y,a.Z*b.X-a.X*b.Z,a.X*b.Y-a.Y*b.X); }
internal V3 Unit() { double d=Math.Sqrt(X*X+Y*Y+Z*Z); return d>0?this*(1.0/d):this; }
}
private struct Q
{
internal double W, X, Y, Z;
internal Q(double w, double x, double y, double z) { W=w;X=x;Y=y;Z=z; }
internal static Q Identity { get { return new Q(1,0,0,0); } }
public static Q operator *(Q a, Q b) { return new Q(a.W*b.W-a.X*b.X-a.Y*b.Y-a.Z*b.Z,a.W*b.X+a.X*b.W+a.Y*b.Z-a.Z*b.Y,a.W*b.Y-a.X*b.Z+a.Y*b.W+a.Z*b.X,a.W*b.Z+a.X*b.Y-a.Y*b.X+a.Z*b.W); }
internal Q Unit() { double d=Math.Sqrt(W*W+X*X+Y*Y+Z*Z); return d>0?new Q(W/d,X/d,Y/d,Z/d):Identity; }
internal static Q AxisAngle(V3 axis, double a) { axis=axis.Unit(); double s=Math.Sin(a/2); return new Q(Math.Cos(a/2),axis.X*s,axis.Y*s,axis.Z*s); }
internal static Q Euler(double x, double y, double z) { return AxisAngle(new V3(0,0,1),z)*AxisAngle(new V3(0,1,0),y)*AxisAngle(new V3(1,0,0),x); }
internal V3 Apply(V3 p) { V3 v=new V3(X,Y,Z),t=V3.Cross(v,p)*2; return p+t*W+V3.Cross(v,t); }
internal static Q Between(V3 from, V3 to)
{
V3 a=from.Unit(),b=to.Unit(); double d=V3.Dot(a,b);
if(d>0.999999999)return Identity;
if(d<-0.999999999){V3 seed=Math.Abs(a.X)<0.8?new V3(1,0,0):new V3(0,1,0);return AxisAngle(V3.Cross(a,seed),Math.PI);}
V3 c=V3.Cross(a,b);return new Q(1+d,c.X,c.Y,c.Z).Unit();
}
internal static Q Slerp(Q a, Q b, double t)
{
double dot=a.W*b.W+a.X*b.X+a.Y*b.Y+a.Z*b.Z;
if(dot<0){b=new Q(-b.W,-b.X,-b.Y,-b.Z);dot=-dot;}
double ka=1-t,kb=t;
if(dot<0.9995){dot=Math.Max(-1,Math.Min(1,dot));double th=Math.Acos(dot),de=Math.Sin(th);ka=Math.Sin((1-t)*th)/de;kb=Math.Sin(t*th)/de;}
return new Q(ka*a.W+kb*b.W,ka*a.X+kb*b.X,ka*a.Y+kb*b.Y,ka*a.Z+kb*b.Z).Unit();
}
}
private const double SettleStart = 1.13, SettleEnd = 1.86;
private static double Angle(double t, double phase, double velocity)
{
double f=Math.Max(0,Math.Min(1,t/SettleEnd));
return phase+velocity*SettleEnd*(1-Math.Pow(1-f,3))/3+Math.Sin(t*27)*0.07*Math.Pow(1-f,2);
}
private static Q TumbleRotation(double t, int slot) { return Q.Euler(Angle(t,0.35+slot*.41,13.6+slot*.7),Angle(t,0.55+slot*.33,18.3+slot*.4),Angle(t,0.12+slot*.18,11.4+slot*.5)); }
private sealed class Mesh { internal V3[] Vertices; internal int[][] Faces; }
private static Mesh Make(V3[] verts, int[][] faces)
{
double max=0;
for(int i=0;i<verts.Length;i++){double l=Math.Sqrt(V3.Dot(verts[i],verts[i]));if(l>max)max=l;}
for(int i=0;i<verts.Length;i++)verts[i]=verts[i]*(1.0/max);
for(int i=0;i<faces.Length;i++)
{
int[]f=faces[i];V3 a=verts[f[0]],b=verts[f[1]],c=verts[f[2]],ctr=new V3(0,0,0);
foreach(int k in f)ctr+=verts[k];
if(V3.Dot(V3.Cross(b-a,c-a),ctr)<0)Array.Reverse(f);
}
return new Mesh{Vertices=verts,Faces=faces};
}
private static Mesh Tetra(){return Make(new V3[]{new V3(1,1,1),new V3(-1,-1,1),new V3(-1,1,-1),new V3(1,-1,-1)},new int[][]{new int[]{0,1,2},new int[]{0,3,1},new int[]{0,2,3},new int[]{1,3,2}});}
private static Mesh Cube(){return Make(new V3[]{new V3(-1,-1,-1),new V3(1,-1,-1),new V3(1,1,-1),new V3(-1,1,-1),new V3(-1,-1,1),new V3(1,-1,1),new V3(1,1,1),new V3(-1,1,1)},new int[][]{new int[]{0,1,2,3},new int[]{4,7,6,5},new int[]{0,4,5,1},new int[]{1,5,6,2},new int[]{2,6,7,3},new int[]{3,7,4,0}});}
private static Mesh Octa(){V3[]a=new V3[]{new V3(1,0,0),new V3(-1,0,0),new V3(0,1,0),new V3(0,-1,0),new V3(0,0,1),new V3(0,0,-1)};return Make(a,new int[][]{new int[]{4,0,2},new int[]{4,2,1},new int[]{4,1,3},new int[]{4,3,0},new int[]{5,2,0},new int[]{5,1,2},new int[]{5,3,1},new int[]{5,0,3}});}
private static Mesh Ten()
{
V3[]v=new V3[12];double apex=1.6,rZ=apex*(1-Math.Cos(Math.PI/5))/(1+Math.Cos(Math.PI/5));
v[0]=new V3(0,0,apex);v[1]=new V3(0,0,-apex);
for(int i=0;i<5;i++){double a=i*Math.PI*2/5;v[2+i]=new V3(Math.Cos(a),Math.Sin(a),rZ);v[7+i]=new V3(Math.Cos(a+Math.PI/5),Math.Sin(a+Math.PI/5),-rZ);}
int[][]f=new int[10][];for(int i=0;i<5;i++){f[i]=new int[]{0,2+i,7+i,2+(i+1)%5};f[5+i]=new int[]{1,7+i,2+(i+1)%5,7+(i+1)%5};}
return Make(v,f);
}
private static Mesh Icosa()
{
double p=(1+Math.Sqrt(5))/2;
V3[]v=new V3[]{new V3(0,1,p),new V3(0,-1,p),new V3(0,1,-p),new V3(0,-1,-p),new V3(1,p,0),new V3(-1,p,0),new V3(1,-p,0),new V3(-1,-p,0),new V3(p,0,1),new V3(-p,0,1),new V3(p,0,-1),new V3(-p,0,-1)};
double smallest=double.MaxValue;
for(int i=0;i<v.Length;i++)for(int j=i+1;j<v.Length;j++){double d=V3.Dot(v[i]-v[j],v[i]-v[j]);if(d<smallest)smallest=d;}
List<int[]> faces=new List<int[]>();
for(int i=0;i<v.Length;i++)for(int j=i+1;j<v.Length;j++)for(int k=j+1;k<v.Length;k++)
{double a=V3.Dot(v[i]-v[j],v[i]-v[j]),b=V3.Dot(v[i]-v[k],v[i]-v[k]),c=V3.Dot(v[j]-v[k],v[j]-v[k]);if(Math.Abs(a-smallest)<0.0001&&Math.Abs(b-smallest)<0.0001&&Math.Abs(c-smallest)<0.0001)faces.Add(new int[]{i,j,k});}
return Make(v,faces.ToArray());
}
private static Mesh Dodeca(Mesh ico)
{
V3[]vert=new V3[ico.Faces.Length];
for(int i=0;i<ico.Faces.Length;i++){int[]t=ico.Faces[i];vert[i]=(ico.Vertices[t[0]]+ico.Vertices[t[1]]+ico.Vertices[t[2]])*(1.0/3);}
int[][]faces=new int[ico.Vertices.Length][];
for(int i=0;i<ico.Vertices.Length;i++)
{
List<int> touching=new List<int>();
for(int j=0;j<ico.Faces.Length;j++)foreach(int k in ico.Faces[j])if(k==i){touching.Add(j);break;}
V3 n=ico.Vertices[i].Unit(),axis=Math.Abs(n.Z)<0.8?new V3(0,0,1):new V3(0,1,0);
V3 right=V3.Cross(axis,n).Unit(),up=V3.Cross(n,right);
for(int a=0;a<touching.Count;a++)for(int b=a+1;b<touching.Count;b++)
{V3 u=vert[touching[a]],vv=vert[touching[b]];if(Math.Atan2(V3.Dot(u,up),V3.Dot(u,right))>Math.Atan2(V3.Dot(vv,up),V3.Dot(vv,right))){int tmp=touching[a];touching[a]=touching[b];touching[b]=tmp;}}
faces[i]=touching.ToArray();
}
return Make(vert,faces);
}
private static readonly Mesh IcoMesh = Icosa();
private static readonly Mesh[] Models = new Mesh[]{Tetra(),Cube(),Octa(),Ten(),Dodeca(IcoMesh),IcoMesh};
private static Mesh ModelFor(int s){switch(s){case 4:return Models[0];case 6:return Models[1];case 8:return Models[2];case 10:return Models[3];case 12:return Models[4];default:return Models[5];}}
private sealed class RenderFace{internal PointF[]Points;internal bool Visible;internal double Depth,Brightness;internal float X,Y,Area;internal int Id;}
private sealed class DieView
{
internal Mesh Geometry;
internal V3[] Rotated;
internal RenderFace[] Faces;
internal int[] Order;
internal int TargetFace;
internal Q LandingStart, LandingEnd;
internal DieView(Mesh mesh, int chosenFace, int slot)
{
Geometry=mesh;TargetFace=chosenFace;
Rotated=new V3[mesh.Vertices.Length];
Faces=new RenderFace[mesh.Faces.Length];Order=new int[mesh.Faces.Length];
for(int i=0;i<Faces.Length;i++){Faces[i]=new RenderFace{Points=new PointF[mesh.Faces[i].Length],Id=i};Order[i]=i;}
int[]f=mesh.Faces[chosenFace];
V3 a=mesh.Vertices[f[0]],b=mesh.Vertices[f[1]],c=mesh.Vertices[f[2]];
V3 n=V3.Cross(b-a,c-a).Unit();
LandingStart=TumbleRotation(SettleStart,slot);
Q align=Q.Between(LandingStart.Apply(n),new V3(0,0,1));
Q front=align*LandingStart;
V3 edge=front.Apply(b-a);
LandingEnd=(Q.AxisAngle(new V3(0,0,1),-Math.Atan2(edge.Y,edge.X))*front).Unit();
}
}
private static readonly Color CpBg     = Color.FromArgb(255,  8,  2, 14);
private static readonly Color CpRed    = Color.FromArgb(255,220, 30, 55);
private static readonly Color CpCyan   = Color.FromArgb(255,  0,230,255);
private static readonly Color CpYellow = Color.FromArgb(255,250,220, 50);
private static readonly Color CpPurple = Color.FromArgb(255,206, 30,255);
private sealed class NeonShard
{
internal float X0, Y0, Dx, Dy, Size, Delay;
internal int Color;
internal bool Slash;
}
private static bool IsPerfectRoll(Roll roll)
{
if (roll.Sides <= 0 || roll.Values == null || roll.Values.Length == 0) return false;
foreach (int face in roll.Values) if (face != roll.Sides) return false;
return true;
}
private sealed class CapriAboveDice
{
private readonly object capri;
private readonly MethodInfo post;
private readonly Dictionary<IntPtr, bool> original = new Dictionary<IntPtr, bool>();
private int queued, finished;
private static readonly IntPtr Top = new IntPtr(-1);
private static readonly IntPtr Normal = new IntPtr(-2);
private const uint NoFocusMoveResize = 0x0001 | 0x0002 | 0x0010;
[DllImport("user32.dll")] private static extern bool SetWindowPos(IntPtr h, IntPtr after, int x, int y, int w, int height, uint flags);
[DllImport("user32.dll")] private static extern int GetWindowLong(IntPtr h, int index);
[DllImport("user32.dll")] private static extern bool IsWindow(IntPtr h);
internal CapriAboveDice(object companion, MethodInfo dispatcher) { capri = companion; post = dispatcher; }
private IEnumerable<Form> VisibleCapriForms()
{
Form primary = capri as Form;
if (primary != null) yield return primary;
string[] fields = { "player", "pill", "box", "typer", "callPanel", "callPill" };
foreach (string name in fields)
{
FieldInfo field = capri.GetType().GetField(name, Fields);
Form form = field == null ? null : field.GetValue(capri) as Form;
if (form != null) yield return form;
}
}
internal void Keep()
{
if (Thread.VolatileRead(ref finished) != 0 ||
Interlocked.CompareExchange(ref queued, 1, 0) != 0) return;
try
{
post.Invoke(capri, new object[] { (Action)delegate
{
Interlocked.Exchange(ref queued, 0);
if (Thread.VolatileRead(ref finished) != 0) return;
foreach (Form form in VisibleCapriForms())
{
if (form.IsDisposed || !form.IsHandleCreated || !form.Visible) continue;
IntPtr handle = form.Handle;
if (!original.ContainsKey(handle))
original.Add(handle, (GetWindowLong(handle, -20) & 0x8) != 0);
SetWindowPos(handle, Top, 0, 0, 0, 0, NoFocusMoveResize);
}
} });
}
catch { Interlocked.Exchange(ref queued, 0); }
}
internal void Restore()
{
if (Interlocked.Exchange(ref finished, 1) != 0) return;
try
{
post.Invoke(capri, new object[] { (Action)delegate
{
bool setting = false, hasSetting = false;
FieldInfo pf = capri.GetType().GetField("preferences", Fields);
object settings = pf == null ? null : pf.GetValue(capri);
FieldInfo onTop = settings == null ? null : settings.GetType().GetField("OnTop", Fields);
if (onTop != null) { setting = (bool)onTop.GetValue(settings); hasSetting = true; }
foreach (KeyValuePair<IntPtr, bool> entry in original)
{
if (!IsWindow(entry.Key)) continue;
bool shouldBeTop = hasSetting ? setting : entry.Value;
SetWindowPos(entry.Key, shouldBeTop ? Top : Normal,
0, 0, 0, 0, NoFocusMoveResize);
}
original.Clear();
} });
}
catch { /* Never prevent the dice window from closing. */ }
}
}
private sealed class RollWindow : Form
{
private readonly double revealAt, endAt, addedRollSeconds;
private readonly int additionalDiceSounds;
private readonly Roll roll;
private readonly Func<bool> wasStopped;
private readonly DiceSounds soundEffects;
private readonly Action onReveal;
private readonly CapriAboveDice capriAbove;
private bool revealAnnounced;
private readonly bool perfect;
private readonly NeonShard[] shards;
private readonly SolidBrush[] burstBrushes = new SolidBrush[]
{
new SolidBrush(Color.FromArgb(235,   0, 230, 255)),
new SolidBrush(Color.FromArgb(235, 220,  30,  55)),
new SolidBrush(Color.FromArgb(235, 250, 220,  50)),
new SolidBrush(Color.FromArgb(235, 206,  30, 255)),
new SolidBrush(Color.FromArgb(235, 255, 255, 255))
};
private readonly Pen[] burstPens = new Pen[]
{
new Pen(Color.FromArgb(210,   0, 230, 255), 2.6f),
new Pen(Color.FromArgb(210, 220,  30,  55), 2.6f),
new Pen(Color.FromArgb(210, 250, 220,  50), 2.6f),
new Pen(Color.FromArgb(210, 206,  30, 255), 2.6f),
new Pen(Color.FromArgb(210, 255, 255, 255), 2.6f)
};
private readonly Stopwatch clock = new Stopwatch();
private readonly System.Windows.Forms.Timer tick = new System.Windows.Forms.Timer();
private readonly DieView[] dice;
private readonly Font fntHeader  = new Font("Courier New", 11, FontStyle.Bold);
private readonly Font fntFace    = new Font("Courier New", 13, FontStyle.Bold);
private readonly Font fntFaceSm  = new Font("Courier New", 10, FontStyle.Bold);
private readonly Font fntNumber  = new Font("Courier New", 22, FontStyle.Bold);
private readonly Font fntLabel   = new Font("Courier New",  9, FontStyle.Regular);
private readonly Pen penEdge     = new Pen(Color.FromArgb(220, 220, 30, 55), 1.6f);
private readonly Pen penHalo     = new Pen(Color.FromArgb( 50, 220, 30, 55), 6f);
private readonly Pen penSep      = new Pen(Color.FromArgb( 90, 180, 20, 40), 1f);
private readonly Pen penEdgeCyan = new Pen(Color.FromArgb(200,   0,230,255), 1.4f);
private readonly Pen penHaloCyan = new Pen(Color.FromArgb( 45,   0,200,255), 5f);
private readonly SolidBrush[] bFaceRed  = new SolidBrush[9];
private readonly SolidBrush[] bFaceCyan = new SolidBrush[9];
private readonly SolidBrush bWhite   = new SolidBrush(Color.FromArgb(255,255,255,255));
private readonly SolidBrush bSecond  = new SolidBrush(Color.FromArgb(200,220, 30, 55));
private readonly SolidBrush bSecCyan = new SolidBrush(Color.FromArgb(180,  0,230,255));
private readonly SolidBrush bDark    = new SolidBrush(Color.FromArgb(220,  8,  2, 14));
private bool cheap;
internal bool Completed { get; private set; }
internal RollWindow(Roll req, Func<bool> cancel, DiceSounds sounds, Action revealed,
int extraRollMilliseconds, int extraSoundsPerDie, CapriAboveDice frontLayer)
{
capriAbove = frontLayer;
additionalDiceSounds = Math.Max(0, Math.Min(3, extraSoundsPerDie));
addedRollSeconds = req.Sides == 0 ? 0.0 :
Math.Max(0, Math.Min(10000, extraRollMilliseconds)) / 1000.0;
revealAt = req.Sides == 0 ? CoinSpinSeconds : SettleEnd + addedRollSeconds;
endAt = revealAt + 3.02;
roll=req;wasStopped=cancel; soundEffects=sounds; onReveal=revealed; perfect=IsPerfectRoll(req);
int n=req.Sides==100?req.Count*2:req.Count;
dice=new DieView[req.Sides==0?0:n];
for(int i=0;i<dice.Length;i++)
{
int which=req.Sides==100?i/2:i;
int face=req.Sides==100?(i%2==0?req.Tens[which]:req.Units[which]):req.Values[which]-1;
dice[i]=new DieView(ModelFor(req.Sides==100?10:req.Sides),face,i);
}
for(int i=0;i<9;i++){bFaceRed[i]=new SolidBrush(Color.FromArgb(255,60+i*18,5+i*4,10+i*5));bFaceCyan[i]=new SolidBrush(Color.FromArgb(255,0+i*5,40+i*20,50+i*22));}
int cols=n>4?(n+1)/2:n;
int w=req.Sides==0?320:Math.Max(320,Math.Min(740,cols*164+80));
ClientSize=new Size(w,n>4?440:266);
shards = perfect ? MakeNeonShards(w, n>4?440:266) : null;
StartPosition=FormStartPosition.Manual;
FormBorderStyle=FormBorderStyle.None;
ShowInTaskbar=false;
PlacePopup();
TopMost=true;
BackColor=CpBg;
Opacity=0.97;
SetStyle(ControlStyles.AllPaintingInWmPaint|ControlStyles.UserPaint|ControlStyles.OptimizedDoubleBuffer,true);
tick.Interval=16;
tick.Tick+=OnTick;
Shown+=delegate
{
if(wasStopped()){CancelRoll();return;}
PinTopMost();
if (capriAbove != null) capriAbove.Keep();
if (roll.Sides == 0 && soundEffects != null)
{
soundEffects.PlayCoin(delegate
{
try
{
if (IsDisposed || !IsHandleCreated) return;
BeginInvoke((MethodInvoker)delegate
{
if (IsDisposed) return;
if (wasStopped()) { CancelRoll(); return; }
StartAnimationClock();
});
}
catch (ObjectDisposedException) { }
catch (InvalidOperationException) { }
});
}
else
{
StartAnimationClock();
if (soundEffects != null)
{
int count = roll.Sides == 100 ? roll.Count * 2 : roll.Count;
soundEffects.PlayDice(count, perfect, revealAt, additionalDiceSounds);
}
}
};
}
private void StartAnimationClock()
{
if (clock.IsRunning) return;
clock.Start(); tick.Start(); Invalidate();
}
[StructLayout(LayoutKind.Sequential)]
private struct LastInput { public uint Size; public uint Tick; }
[DllImport("user32.dll")] private static extern short GetAsyncKeyState(int key);
[DllImport("user32.dll")] private static extern bool GetLastInputInfo(ref LastInput info);
[DllImport("user32.dll")] private static extern bool SetWindowPos(IntPtr hwnd, IntPtr after, int x, int y, int w, int h, uint flags);
private static readonly IntPtr HwndTopMost = new IntPtr(-1);
private const uint KeepPositionNoActivate = 0x0001 | 0x0002 | 0x0010 | 0x0040;
private static bool UserBusy()
{
for (int key = 1; key <= 2; key++)
if ((GetAsyncKeyState(key) & 0x8000) != 0) return true;
LastInput info = new LastInput();
info.Size = (uint)Marshal.SizeOf(typeof(LastInput));
return GetLastInputInfo(ref info) &&
unchecked((uint)Environment.TickCount - info.Tick) <= 2200u;
}
private void PlacePopup()
{
Rectangle area = Screen.FromPoint(Cursor.Position).WorkingArea;
double centerFraction = UserBusy() ? (1.0 - ActivePopupDistanceFromRightPercent / 100.0) : .50;
int x = area.Left + (int)(area.Width * centerFraction - Width / 2.0);
int y = area.Top + (area.Height - Height) / 2;
Location = new Point(Math.Max(area.Left, Math.Min(area.Right - Width, x)),
Math.Max(area.Top, Math.Min(area.Bottom - Height, y)));
}
private void PinTopMost()
{
if (IsHandleCreated && !IsDisposed)
SetWindowPos(Handle, HwndTopMost, 0, 0, 0, 0, KeepPositionNoActivate);
}
protected override CreateParams CreateParams
{
get
{
CreateParams cp = base.CreateParams;
cp.ExStyle |= 0x08000000 | 0x00000080 | 0x00080000 | 0x00000020;
return cp; // NOACTIVATE | TOOLWINDOW | LAYERED | TRANSPARENT
}
}
protected override void WndProc(ref Message m)
{
if (m.Msg == 0x0021) { m.Result = (IntPtr)3; return; } // MA_NOACTIVATE
if (m.Msg == 0x0084) { m.Result = (IntPtr)(-1); return; } // HTTRANSPARENT
base.WndProc(ref m);
}
protected override bool ShowWithoutActivation { get { return true; } }
private int topmostTick;
private void OnTick(object s, EventArgs e)
{
if(wasStopped()){CancelRoll();return;}
if (++topmostTick >= 16) { topmostTick = 0; PinTopMost(); if (capriAbove != null) capriAbove.Keep(); }
if (!revealAnnounced && clock.Elapsed.TotalSeconds >= revealAt)
{
revealAnnounced = true;
if (onReveal != null) onReveal();
}
if(clock.Elapsed.TotalSeconds>=endAt){tick.Stop();Completed=true;Close();return;}
Invalidate();
}
internal void CancelRoll(){Completed=false;tick.Stop();if(!IsDisposed)Close();}
protected override void Dispose(bool d)
{
if(d)
{
if (capriAbove != null) capriAbove.Restore();
tick.Stop();tick.Dispose();
fntHeader.Dispose();fntFace.Dispose();fntFaceSm.Dispose();fntNumber.Dispose();fntLabel.Dispose();
penEdge.Dispose();penHalo.Dispose();penSep.Dispose();penEdgeCyan.Dispose();penHaloCyan.Dispose();
bWhite.Dispose();bSecond.Dispose();bSecCyan.Dispose();bDark.Dispose();
for(int i=0;i<9;i++){bFaceRed[i].Dispose();bFaceCyan[i].Dispose();}
foreach (SolidBrush brush in burstBrushes) brush.Dispose();
foreach (Pen pen in burstPens) pen.Dispose();
}
base.Dispose(d);
}
protected override void OnPaint(PaintEventArgs e)
{
base.OnPaint(e);
Stopwatch sw=Stopwatch.StartNew();
Graphics g=e.Graphics;
g.Clear(CpBg);
g.SmoothingMode=cheap?SmoothingMode.HighSpeed:SmoothingMode.AntiAlias;
g.TextRenderingHint=TextRenderingHint.AntiAliasGridFit;
double time=Math.Min(endAt,clock.Elapsed.TotalSeconds);
bool finished=time>=revealAt;
double tumbleEnd = SettleStart + addedRollSeconds;
double animationTime = finished ? SettleEnd :
time < tumbleEnd ? time * SettleStart / tumbleEnd : time - addedRollSeconds;
if(!cheap && roll.Sides != 0){using(Pen scanPen=new Pen(Color.FromArgb(18,255,0,30),1))for(int y=0;y<Height;y+=3)g.DrawLine(scanPen,0,y,Width,y);}
DrawCornerBrackets(g);
string dieLabel=roll.Sides==0?"COIN FLIP":(roll.Count>1?roll.Count+"xD"+roll.Sides:"D"+roll.Sides);
g.DrawString("[ "+dieLabel+" "+(finished?"// LOCKED":"// ROLLING")+" ]",fntHeader,finished?bSecCyan:bSecond,14,10);
g.DrawLine(penSep,14,36,Width-14,36);
if(roll.Sides==0)
DrawCoin(g,finished ? SettleEnd : Math.Min(SettleEnd,time*SettleEnd/CoinSpinSeconds),finished,time);
else
{
int n=dice.Length,cols=n>4?(n+1)/2:n;
double cell=(Width-38.0)/cols;float sz=(float)Math.Min(80,cell*0.39);
for(int i=0;i<n;i++)
{
int row=i/cols,col=i%cols,rowCount=Math.Min(cols,n-row*cols);
bool tens=roll.Sides==100&&i%2==0;
double x=19+(cols-rowCount)*cell*0.5+cell*(col+0.5),y=125+row*165;
DrawDie(g,dice[i],x,y,sz,animationTime,i,finished,roll.Sides==100,tens,time);
}
}
if (finished && perfect) DrawCyberConfetti(g, time-revealAt);
if(finished)
{
string res=ResultLabel();SizeF ms=g.MeasureString(res,fntNumber);
float rx=(Width-ms.Width)/2f-14,ry=Height-56;
if(!cheap)for(int gw=8;gw>0;gw-=2)using(SolidBrush gb=new SolidBrush(Color.FromArgb(20,CpCyan)))g.FillRectangle(gb,rx-gw,ry-gw/2,ms.Width+28+gw*2,42+gw);
g.FillRectangle(bDark,rx,ry,ms.Width+28,42);
g.DrawRectangle(penEdgeCyan,rx,ry,ms.Width+28,42);
g.DrawString(res,fntNumber,bWhite,rx+14,ry+6);
}
else if((int)(time*4)%2==0)g.DrawString("\u25B6 TUMBLING...",fntLabel,bSecond,14,Height-30);
sw.Stop();if(sw.ElapsedMilliseconds>35)cheap=true;
}
private static NeonShard[] MakeNeonShards(int width, int height)
{
Random random = new Random();
NeonShard[] pieces = new NeonShard[96];
for (int i = 0; i < pieces.Length; i++)
{
double angle = random.NextDouble() * Math.PI * 2.0;
double speed = 90 + random.NextDouble() * 280;
pieces[i] = new NeonShard
{
X0 = (float)(width*.5 + (random.NextDouble()-.5)*54),
Y0 = (float)(height*.59 + (random.NextDouble()-.5)*30),
Dx = (float)(Math.Cos(angle) * speed),
Dy = (float)(Math.Sin(angle) * speed - 140),
Size = (float)(2.5 + random.NextDouble()*5.2),
Delay = (float)(random.NextDouble()*.15),
Color = random.Next(0, 5),
Slash = random.Next(0, 3) == 0
};
}
return pieces;
}
private void DrawCyberConfetti(Graphics g, double sinceReveal)
{
if (shards == null || sinceReveal > 2.55) return;
if (sinceReveal < .32)
{
float alphaWidth = (float)(Width*.5 * (1.0-sinceReveal/.38));
using (Pen flash = new Pen(Color.FromArgb(170, CpYellow), 2.4f))
{
g.DrawLine(flash, Width/2-alphaWidth, 43, Width/2+alphaWidth, 43);
g.DrawLine(flash, Width/2-alphaWidth, Height-15, Width/2+alphaWidth, Height-15);
}
}
foreach (NeonShard part in shards)
{
double t = sinceReveal - part.Delay;
if (t < 0 || t > 2.25) continue;
float x = part.X0 + (float)(part.Dx*t);
float y = part.Y0 + (float)(part.Dy*t + 215*t*t);
if (x < -16 || x > Width+16 || y < -16 || y > Height+16) continue;
float sz = part.Size * (float)Math.Max(.15, 1.0-t/2.5);
if (part.Slash)
{
g.DrawLine(burstPens[part.Color], x-sz*.9f,y-sz*1.7f,
x+sz*.9f,y+sz*1.7f);
}
else
{
g.FillRectangle(burstBrushes[part.Color], x-sz/2, y-sz/2,
sz*1.5f, sz*.72f);
}
}
}
private void DrawCornerBrackets(Graphics g)
{
const int L=14;
using(Pen p=new Pen(Color.FromArgb(140,CpRed),1.5f))
{
g.DrawLine(p,4,4+L,4,4);g.DrawLine(p,4,4,4+L,4);
g.DrawLine(p,Width-4-L,4,Width-4,4);g.DrawLine(p,Width-4,4,Width-4,4+L);
g.DrawLine(p,4,Height-4-L,4,Height-4);g.DrawLine(p,4,Height-4,4+L,Height-4);
g.DrawLine(p,Width-4-L,Height-4,Width-4,Height-4);g.DrawLine(p,Width-4,Height-4,Width-4,Height-4-L);
}
}
private string ResultLabel()
{
if(roll.Sides==0)return roll.Values[0]==0?"HEADS":"TAILS";
if(roll.Count==1)return roll.Values[0].ToString();
int s=0;for(int i=0;i<roll.Count;i++)s+=roll.Values[i];return "TOTAL "+s;
}
private double ExtraSpinAngle(double realTime)
{
if (addedRollSeconds <= 0) return 0;
double u = Math.Max(0, Math.Min(1, realTime / (SettleStart + addedRollSeconds)));
double ease = u * u * (3 - 2 * u);
return 2 * Math.PI * Math.Round(addedRollSeconds * 2) * ease;
}
private void DrawDie(Graphics g,DieView view,double cx,double cy,float radius,double t,int slot,bool finished,bool percentile,bool tens,double realTime)
{
Mesh mesh=view.Geometry;double at=Math.Min(SettleEnd,t);Q ori;
if(at<SettleStart)
{
ori=TumbleRotation(at,slot);
if (addedRollSeconds>0)
ori=Q.AxisAngle(new V3(0.35,0.8,0.42),ExtraSpinAngle(realTime))*ori;
}
else{double u=Math.Max(0,Math.Min(1,(at-SettleStart)/(SettleEnd-SettleStart)));ori=Q.Slerp(view.LandingStart,view.LandingEnd,1-Math.Pow(1-u,3));}
double left=Math.Max(0,1-at/SettleEnd);cy+=Math.Abs(Math.Sin(at*11))*11*left*left;
for(int i=0;i<mesh.Vertices.Length;i++)view.Rotated[i]=ori.Apply(mesh.Vertices[i]);
int vis=0;
for(int i=0;i<mesh.Faces.Length;i++)
{
int[]face=mesh.Faces[i];RenderFace r=view.Faces[i];
V3 a=view.Rotated[face[0]],b=view.Rotated[face[1]],c=view.Rotated[face[2]];
V3 norm=V3.Cross(b-a,c-a).Unit();r.Visible=norm.Z>0.012;if(!r.Visible)continue;
r.Brightness=Math.Max(0,Math.Min(.999,0.40+norm.Z*.41+norm.X*.12));
double zz=0,fx=0,fy=0;
for(int k=0;k<face.Length;k++){V3 pt=view.Rotated[face[k]];double sc=3.8/(3.8-pt.Z*.5);float px=(float)(cx+radius*pt.X*sc),py=(float)(cy-radius*pt.Y*sc);r.Points[k]=new PointF(px,py);fx+=px;fy+=py;zz+=pt.Z;}
r.X=(float)(fx/face.Length);r.Y=(float)(fy/face.Length);r.Depth=zz/face.Length;
float area=0;for(int k=0;k<face.Length;k++){PointF pp=r.Points[k],q=r.Points[(k+1)%face.Length];area+=pp.X*q.Y-q.X*pp.Y;}r.Area=Math.Abs(area)*0.5f;
view.Order[vis++]=i;
}
for(int i=1;i<vis;i++){int tmp=view.Order[i],j=i-1;while(j>=0&&view.Faces[view.Order[j]].Depth>view.Faces[tmp].Depth){view.Order[j+1]=view.Order[j];j--;}view.Order[j+1]=tmp;}
bool isRed=percentile&&tens;
SolidBrush[]palette=isRed?bFaceRed:bFaceCyan;Pen ePen=isRed?penEdge:penEdgeCyan,hPen=isRed?penHalo:penHaloCyan;
for(int i=0;i<vis;i++)
{
RenderFace r=view.Faces[view.Order[i]];int shade=(int)(r.Brightness*9);if(shade>8)shade=8;
g.FillPolygon(palette[shade],r.Points);if(!cheap)g.DrawPolygon(hPen,r.Points);g.DrawPolygon(ePen,r.Points);
bool chosen=finished&&r.Id==view.TargetFace;
if(r.Area>210||chosen)
{
string txt=percentile?(tens?(r.Id*10).ToString("00"):r.Id.ToString()):(r.Id+1).ToString();
Font fnt=chosen&&radius>58?fntNumber:(chosen||r.Area>=650?fntFace:fntFaceSm);
SizeF sz=g.MeasureString(txt,fnt);
int[]face=mesh.Faces[r.Id];V3 p1=view.Rotated[face[0]],p2=view.Rotated[face[1]];
double s1=3.8/(3.8-p1.Z*.5),s2=3.8/(3.8-p2.Z*.5);
float ang=(float)(Math.Atan2(-(p2.Y*s2-p1.Y*s1),p2.X*s2-p1.X*s1)*180/Math.PI);
float nom=(float)Math.Sqrt(r.Area),scale=Math.Min(1f,nom*0.58f/Math.Max(1,Math.Max(sz.Width,sz.Height)));
GraphicsState st=g.Save();g.TranslateTransform(r.X,r.Y);g.RotateTransform(ang);g.ScaleTransform(scale,scale);
if(!cheap&&chosen){Color glowCol=isRed?CpRed:CpCyan;for(int gw=4;gw>0;gw--)using(SolidBrush gb=new SolidBrush(Color.FromArgb(35+gw*8,glowCol)))g.DrawString(txt,fnt,gb,-sz.Width/2+gw*.4f,-sz.Height/2+gw*.4f);}
g.DrawString(txt,fnt,chosen?bWhite:(isRed?bSecond:bSecCyan),-sz.Width/2,-sz.Height/2);
g.Restore(st);
}
}
}
private static double CoinAngle(double t,bool heads){double u=Math.Max(0,Math.Min(1,t/SettleEnd)),travel=1-Math.Pow(1-u,3);return(heads?12.0:13.0)*Math.PI*travel;}
private void DrawCoin(Graphics g,double t,bool finished,double realTime)
{
float cx=Width/2f,cy=124,radius=79;double el=Math.Min(SettleEnd,t),angle=CoinAngle(el,roll.Values[0]==0)+ExtraSpinAngle(realTime);
float half=(float)(Math.Abs(Math.Cos(angle))*radius);if(half<4)half=4;
double left=Math.Max(0,1-el/SettleEnd);float bounce=(float)(Math.Abs(Math.Sin(el*11))*17*left*left);
bool heads=Math.Cos(angle)>=0;
SolidBrush[]palette=heads?bFaceCyan:bFaceRed;Pen ep=heads?penEdgeCyan:penEdge,hp=heads?penHaloCyan:penHalo;
RectangleF rect=new RectangleF(cx-half,cy-radius+bounce,half*2,radius*2);
g.FillEllipse(palette[8],rect);if(!cheap)g.DrawEllipse(hp,rect);g.DrawEllipse(ep,rect);
if(half>36||finished)
{
string lbl=heads?"H":"T";SizeF sz=g.MeasureString(lbl,fntNumber);
if(!cheap)for(int gw=4;gw>0;gw--)using(SolidBrush gb=new SolidBrush(Color.FromArgb(40+gw*10,heads?CpCyan:CpRed)))g.DrawString(lbl,fntNumber,gb,cx-sz.Width/2+gw*.5f,cy+bounce-sz.Height/2+gw*.5f);
g.DrawString(lbl,fntNumber,bWhite,cx-sz.Width/2,cy+bounce-sz.Height/2);
}
}
}
}
