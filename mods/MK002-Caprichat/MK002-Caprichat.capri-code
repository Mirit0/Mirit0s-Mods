    }
    ;
    loadFill=new Panel{
      Left=0,Top=0,Height=4,Width=0,BackColor=ChatColors.Hot
    }
    ;
    track.Controls.Add(loadFill);
    loadBadge.Controls.Add(loadText);
    loadBadge.Controls.Add(track);
    Controls.Add(loadBadge);
    Action locate=delegate{
      loadBadge.Location=new Point(Math.Max(0,ClientSize.Width-loadBadge.Width-24),Math.Max(0,ClientSize.Height-loadBadge.Height-5));
    }
    ;
    Resize+=delegate{
      locate();
    }
    ;
    locate();
    SetArchiveProgress(mod.LoadedArchiveMessages,mod.TotalArchiveMessages,mod.ArchiveIsLoading);
    loadBadge.BringToFront();
  }
  internal void SetArchiveProgress(int done,int total,bool loading){
    if(loadBadge==null||loadBadge.IsDisposed)return;
    int percent=Math.Max(0,Math.Min(100,(int)((long)done*100/Math.Max(1,total))));
    loadBadge.Visible=loading;
    loadText.Text=percent+"% of messages loaded";
    loadFill.Width=percent*180/100;
    if(loading)loadBadge.BringToFront();
  }
  private Point maxDragStart;
  private bool maxDragArmed;
  private void DragChrome(object sender,MouseEventArgs e){
    if(e.Button!=MouseButtons.Left)return;
    if(WindowState==FormWindowState.Maximized){
      maxDragStart=Control.MousePosition;
      maxDragArmed=true;
      return;
    }
    ReleaseCapture();
    SendMessage(Handle,0xA1,new IntPtr(2),IntPtr.Zero);
  }
  private void MoveChrome(object sender,MouseEventArgs e){
    if(!maxDragArmed||WindowState!=FormWindowState.Maximized)return;
    if((e.Button&MouseButtons.Left)==0){
      maxDragArmed=false;
      return;
    }
    Point cursor=Control.MousePosition;
    if(Math.Abs(cursor.X-maxDragStart.X)+Math.Abs(cursor.Y-maxDragStart.Y)<10)return;
    maxDragArmed=false;
    double fraction=(double)(cursor.X-Left)/Math.Max(1,Width);
    WindowState=FormWindowState.Normal;
    Rectangle area=Screen.FromPoint(cursor).WorkingArea;
    Location=new Point(Math.Max(area.Left,Math.Min(area.Right-Width,cursor.X-(int)(fraction*Width))),Math.Max(area.Top,Math.Min(area.Bottom-45,cursor.Y-23)));
    ReleaseCapture();
    SendMessage(Handle,0xA1,new IntPtr(2),IntPtr.Zero);
  }
  protected override void WndProc(ref Message m){
    if(m.Msg==0x24){
      base.WndProc(ref m);
      try{
        ApplyWorkingArea(m);
      }
      catch(Exception){
      }
      return;
    }
    if(m.Msg==0x83||m.Msg==0x85||m.Msg==0xae||m.Msg==0xaf){
      m.Result=IntPtr.Zero;
      return;
    }
    if(m.Msg==0x84){
      if(WindowState==FormWindowState.Maximized){
        m.Result=new IntPtr(1);
        return;
      }
      Point p=PointToClient(new Point(unchecked((short)m.LParam.ToInt64()),unchecked((short)(m.LParam.ToInt64()>>16))));
      bool l=p.X<12,r=p.X>=Width-12,t=p.Y<12,b=p.Y>=Height-12;
      int hit=t&&l?13:t&&r?14:b&&l?16:b&&r?17:l?10:r?11:t?12:b?15:p.Y<48&&p.X<Width-142?2:1;
      m.Result=new IntPtr(hit);
      return;
    }
    base.WndProc(ref m);
  }
  protected override void OnPaint(PaintEventArgs e){
    base.OnPaint(e);
  }
  private static Label Label(string s,Color c,float size,bool bold){
    return new Label{
      Text=s,ForeColor=c,BackColor=Color.Transparent,AutoSize=true,Font=ChatColors.Font(size,bold),Margin=new Padding(4,7,4,3)
    }
