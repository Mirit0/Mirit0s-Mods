      ClearReply();
      if(currentDay=="STARRED"){
        currentDay=starReturnDay??LatestDay();
        followLatest=starReturnFollowLatest;
      }
      else{
        starReturnDay=currentDay;
        starReturnFollowLatest=followLatest;
        currentDay="STARRED";
        followLatest=false;
      }
      RefreshChat();
      scroll.ScrollToBottom();
    }
