        refreshPulse.Dispose();
        refreshPulse=null;
      }
      try{
        Rectangle place=WindowState==FormWindowState.Normal?Bounds:RestoreBounds;
        if(place.Width>=480&&place.Height>=420)File.WriteAllText(Path.Combine(mod.Folder,"window.txt"),place.X+","+place.Y+","+place.Width+","+place.Height);
      }
      catch(IOException){
      }
      catch(UnauthorizedAccessException){
      }
    }
    ;
    Resize+=delegate{
      if(WindowState==FormWindowState.Minimized){
        needsRestoreRefresh=true;
        return;
      }
      if(IsHandleCreated&&Visible){
        if(needsRestoreRefresh)needsRestoreRefresh=false;
        QueueRefresh();
        Invalidate(true);
      }
    }
    ;
    VisibleChanged+=delegate{
      if(Visible&&IsHandleCreated&&WindowState!=FormWindowState.Minimized){
        QueueRefresh();
        Invalidate(true);
      }
    }
    ;
  }
  [DllImport("dwmapi.dll")]private static extern int DwmSetWindowAttribute(IntPtr hwnd,int attribute,ref int value,int size);
  [DllImport("user32.dll")]private static extern bool ReleaseCapture();
  [DllImport("user32.dll")]private static extern IntPtr SendMessage(IntPtr window,int msg,IntPtr wParam,IntPtr lParam);
  protected override CreateParams CreateParams{
    get{
      CreateParams cp=base.CreateParams;
      cp.Style=(cp.Style|0x00020000|0x00080000|0x00040000)&~(0x00010000|0x00C00000);
      cp.ExStyle=(cp.ExStyle|0x02000000)&~(0x00000100|0x00000200|0x00020000|0x00000001);
      return cp;
    }
  }
  protected override void OnHandleCreated(EventArgs e){
    base.OnHandleCreated(e);
    try{
      int none=unchecked((int)0xfffffffe);
      DwmSetWindowAttribute(Handle,34,ref none,sizeof(int));
    }
    catch(DllNotFoundException){
    }
    catch(EntryPointNotFoundException){
    }
  }
  [StructLayout(LayoutKind.Sequential)]private struct Win32Point{
    public int X,Y;
  }
  [StructLayout(LayoutKind.Sequential)]private struct Win32MinMaxInfo{
    public Win32Point Reserved,MaxSize,MaxPosition,MinTrackSize,MaxTrackSize;
  }
  private static void ApplyWorkingArea(Message m){
    if(m.LParam==IntPtr.Zero)return;
    Screen display=Screen.FromHandle(m.HWnd);
    Rectangle area=display.WorkingArea,monitor=display.Bounds;
    Win32MinMaxInfo info=(Win32MinMaxInfo)Marshal.PtrToStructure(m.LParam,typeof(Win32MinMaxInfo));
    info.MaxPosition.X=area.Left-monitor.Left;
    info.MaxPosition.Y=area.Top-monitor.Top;
    info.MaxSize.X=area.Width;
    info.MaxSize.Y=area.Height;
    Marshal.StructureToPtr(info,m.LParam,false);
  }
  private bool needsRestoreRefresh;
  internal void QueueRefresh(){
    if(IsDisposed||!IsHandleCreated)return;
    refreshNeeded=true;
    if(!Visible||WindowState==FormWindowState.Minimized)return;
    if(refreshPulse==null){
      refreshPulse=new System.Windows.Forms.Timer{
        Interval=120
      }
      ;
      refreshPulse.Tick+=delegate{
        refreshPulse.Stop();
        if(!refreshNeeded||IsDisposed||!Visible||WindowState==FormWindowState.Minimized)return;
        refreshNeeded=false;
        RefreshChat();
      }
      ;
    }
    if(!refreshPulse.Enabled)refreshPulse.Start();
  }
  private void BuildLoadBadge(){
    loadBadge=new Panel{
      Size=new Size(192,33),BackColor=ChatColors.Field,Visible=true,Anchor=AnchorStyles.Right|AnchorStyles.Bottom
    }
    ;
    loadText=new Label{
