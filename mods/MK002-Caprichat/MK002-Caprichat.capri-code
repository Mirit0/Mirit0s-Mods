  private void InstallEdgeResizers(){
    int[]sides={
      13,12,14,10,11,16,15,17
    }
    ;
    Cursor[]pointers={
      Cursors.SizeNWSE,Cursors.SizeNS,Cursors.SizeNESW,Cursors.SizeWE,Cursors.SizeWE,Cursors.SizeNESW,Cursors.SizeNS,Cursors.SizeNWSE
    }
    ;
    Panel[]bands=new Panel[8];
    for(int i=0;
    i<8;
    i++){
      int hit=sides[i];
      Panel band=new Panel{
        BackColor=ChatColors.Ground,Cursor=pointers[i],TabStop=false
      }
      ;
      band.MouseDown+=delegate(object sender,MouseEventArgs e){
        if(e.Button!=MouseButtons.Left||WindowState==FormWindowState.Maximized)return;
        ReleaseCapture();
        SendMessage(Handle,0xA1,new IntPtr(hit),IntPtr.Zero);
      }
      ;
      bands[i]=band;
      Controls.Add(band);
      band.BringToFront();
    }
    Action position=delegate{
      int w=ClientSize.Width,h=ClientSize.Height,t=10,c=16;
      Rectangle[]rects={
        new Rectangle(0,0,c,c),new Rectangle(c,0,Math.Max(1,w-2*c),t),new Rectangle(Math.Max(0,w-c),0,c,c),new Rectangle(0,c,t,Math.Max(1,h-2*c)),new Rectangle(Math.Max(0,w-t),c,t,Math.Max(1,h-2*c)),new Rectangle(0,Math.Max(0,h-c),c,c),new Rectangle(c,Math.Max(0,h-t),Math.Max(1,w-2*c),t),new Rectangle(Math.Max(0,w-c),Math.Max(0,h-c),c,c)
      }
      ;
      for(int i=0;
      i<bands.Length;
      i++){
        bands[i].Visible=WindowState!=FormWindowState.Maximized;
        bands[i].Bounds=rects[i];
      }
    }
    ;
    Resize+=delegate{
      position();
    }
    ;
    position();
  }
  private void ToggleMaximize(){
    SuspendLayout();
    try{
      WindowState=WindowState==FormWindowState.Maximized?FormWindowState.Normal:FormWindowState.Maximized;
    }
    finally{
      ResumeLayout(true);
    }
    if(scroll!=null&&!scroll.IsDisposed)scroll.Reflow();
    Invalidate(true);
    Update();
    if(IsHandleCreated)BeginInvoke((Action)delegate{
      if(!IsDisposed){
        frameGrid.PerformLayout();
        scroll.Reflow();
        ShowVirtualRows();
        Invalidate(true);
        Update();
      }
    }
    );
  }
  private void ShowSettings(){
    using(Form settings=new Form{
      Text="Caprichat Settings",FormBorderStyle=FormBorderStyle.None,StartPosition=FormStartPosition.CenterParent,ClientSize=new Size(414,330),ShowInTaskbar=false,BackColor=ChatColors.Ground,ForeColor=ChatColors.Cyan
    }
    ){
      Panel chrome=new Panel{
        Dock=DockStyle.Top,Height=43,BackColor=Color.FromArgb(35,12,21)
      }
      ;
      Label title=new Label{
        Text="CAPRICHAT // SETTINGS",Left=15,Top=13,Width=310,Font=ChatColors.Font(11,true),ForeColor=ChatColors.Rose
      }
      ;
      Button close=ChatColors.Button("×",42);
      close.Dock=DockStyle.Right;
      close.Font=ChatColors.Font(15,true);
      close.FlatAppearance.BorderSize=0;
      close.Click+=delegate{
        settings.Close();
      }
      ;
      chrome.Controls.Add(title);
      chrome.Controls.Add(close);
      settings.Controls.Add(chrome);
      MouseEventHandler drag=delegate(object o,MouseEventArgs e){
        if(e.Button==MouseButtons.Left){
          ReleaseCapture();
          SendMessage(settings.Handle,0xA1,new IntPtr(2),IntPtr.Zero);
        }
      }
      ;
      chrome.MouseDown+=drag;
      title.MouseDown+=drag;
      Label text=new Label{
        Text="CHAT MESSAGE FONT SIZE (6–30 PT)",Left=18,Top=62,Width=340,ForeColor=ChatColors.Cyan,Font=ChatColors.Font(9,true)
      }
      ;
      settings.Controls.Add(text);
      float chosen=Math.Max(6f,Math.Min(30f,mod.FontSize));
      Label size=new Label{
        Text=chosen.ToString("0.0",CultureInfo.InvariantCulture)+" pt",Left=79,Top=91,Width=100,Height=34,TextAlign=ContentAlignment.MiddleCenter,ForeColor=ChatColors.White,BackColor=ChatColors.Field,Font=ChatColors.Font(12,true)
      }
      ;
      Button decrease=ChatColors.Button("◀",50);
      decrease.SetBounds(20,91,49,34);
      Button increase=ChatColors.Button("▶",50);
      increase.SetBounds(189,91,49,34);
      Action redraw=delegate{
        size.Text=chosen.ToString("0.0",CultureInfo.InvariantCulture)+" pt";
      }
      ;
      decrease.Click+=delegate{
        chosen=Math.Max(6f,chosen-0.5f);
        redraw();
      }
      ;
      increase.Click+=delegate{
        chosen=Math.Min(30f,chosen+0.5f);
        redraw();
      }
      ;
      settings.Controls.Add(size);
      settings.Controls.Add(decrease);
      settings.Controls.Add(increase);
      Button file=ChatColors.Button("FONT FILE…",125);
      file.SetBounds(254,91,140,34);
      file.Click+=delegate{
        settings.Close();
        ChooseFontFile();
      }
      ;
      settings.Controls.Add(file);
      Label visibility=new Label{
        Text="CHAT NOTICES",Left=18,Top=142,Width=340,Height=20,ForeColor=ChatColors.Rose,Font=ChatColors.Font(10,true)
      }
      ;
      settings.Controls.Add(visibility);
      Button observation=ChatColors.Button("",186);
      observation.SetBounds(18,168,184,37);
      Button jobs=ChatColors.Button("",185);
      jobs.SetBounds(210,168,184,37);
      Action updateLabels=delegate{
        observation.Text="HIDE OBSERVATIONS: "+(mod.HideObservations?"ON":"OFF");
        jobs.Text="HIDE JOBS: "+(mod.HideJobs?"ON":"OFF");
        observation.ForeColor=mod.HideObservations?ChatColors.Rose:ChatColors.Cyan;
        jobs.ForeColor=mod.HideJobs?ChatColors.Rose:ChatColors.Cyan;
      }
      ;
      observation.Click+=delegate{
        mod.SetNoticeVisibility(!mod.HideObservations,mod.HideJobs);
        updateLabels();
      }
      ;
      jobs.Click+=delegate{
        mod.SetNoticeVisibility(mod.HideObservations,!mod.HideJobs);
        updateLabels();
      }
      ;
      settings.Controls.Add(observation);
      settings.Controls.Add(jobs);
      updateLabels();
      Button apply=ChatColors.Button("APPLY SIZE",115);
      apply.SetBounds(18,252,115,36);
      apply.Click+=delegate{
        mod.FontSize=chosen;
        try{
          File.WriteAllText(Path.Combine(mod.Folder,"chat-font-size.txt"),chosen.ToString(CultureInfo.InvariantCulture));
        }
        catch(IOException){
        }
        settings.Close();
        mod.ReopenWithFont();
      }
      ;
      Button reset=ChatColors.Button("RESET FONT",128);
      reset.SetBounds(150,252,128,36);
      reset.Click+=delegate{
        mod.FontSize=MK002Settings.MessageFontSize;
        ChatColors.SelectFont("");
        try{
          File.WriteAllText(Path.Combine(mod.Folder,"chat-font.txt"),"");
          File.WriteAllText(Path.Combine(mod.Folder,"chat-font-size.txt"),MK002Settings.MessageFontSize.ToString(CultureInfo.InvariantCulture));
        }
        catch(IOException){
        }
        settings.Close();
        mod.ReopenWithFont();
      }
      ;
      Button cancel=ChatColors.Button("CANCEL",85);
      cancel.SetBounds(296,252,85,36);
      cancel.Click+=delegate{
        settings.Close();
      }
      ;
      settings.Controls.Add(apply);
      settings.Controls.Add(reset);
      settings.Controls.Add(cancel);
      settings.ShowDialog(this);
    }
  }
  private void ChooseFontFile(){
    using(OpenFileDialog dialog=new OpenFileDialog()){
      dialog.Title="Caprichat // Choose a font file";
      dialog.Filter="Font files|*.ttf;*.otf|All files|*.*";
      if(dialog.ShowDialog(this)!=DialogResult.OK)return;
      string chosen=dialog.FileName;
      if(!ChatColors.SelectFont(chosen)){
        MessageBox.Show(this,"This font file couldn't be loaded.","Caprichat");
        return;
      }
      try{
        File.WriteAllText(Path.Combine(mod.Folder,"chat-font.txt"),chosen);
      }
      catch(IOException){
      }
      mod.ReopenWithFont();
    }
  }
  internal void FocusCompose(){
    if(entry!=null&&entry.Visible)entry.Focus();
  }
  private void PickFiles(){
    using(OpenFileDialog dialog=new OpenFileDialog()){
      dialog.Multiselect=true;
      dialog.Title="Attach files to Caprichat";
      dialog.Filter="Images and documents|*.png;*.jpg;*.jpeg;*.gif;*.bmp;*.webp;*.pdf;*.txt;*.md;*.docx;*.xlsx|All files|*.*";
      if(dialog.ShowDialog(this)==DialogResult.OK)QueueFiles(dialog.FileNames);
    }
  }
  private void QueueFiles(string[]paths){
    if(paths==null)return;
    foreach(string p in paths)if(File.Exists(p)&&outgoingFiles.Count<8&&!outgoingFiles.Contains(p))outgoingFiles.Add(p);
    UpdateFileLabel();
    UpdateFilePreview();
  }
  private void UpdateFileLabel(){
    if(attachButton!=null){
      attachButton.Text=outgoingFiles.Count==0?"📎":"📎"+outgoingFiles.Count;
      tips.SetToolTip(attachButton,outgoingFiles.Count==0?"Attach images or files":string.Join("\n",outgoingFiles.Select(Path.GetFileName).ToArray()));
    }
  }
  private void UpdateFilePreview(){
    if(filePreview==null||filePreview.IsDisposed)return;
    Control[]existing=filePreview.Controls.Cast<Control>().ToArray();
    filePreview.Controls.Clear();
    foreach(Control old in existing)old.Dispose();
    foreach(string path in outgoingFiles){
      string file=path;
      if(!File.Exists(file))continue;
      try{
        if(new[]{
          ".png",".jpg",".jpeg",".gif",".bmp",".webp"
        }
        .Contains(Path.GetExtension(file).ToLowerInvariant())){
          using(Image source=Image.FromFile(file)){
            Image thumb=new Bitmap(source,58,50);
            PictureBox pic=new PictureBox{
              Image=thumb,Width=65,Height=55,SizeMode=PictureBoxSizeMode.Zoom,BackColor=ChatColors.Well,Cursor=Cursors.Hand
            }
            ;
            pic.Disposed+=delegate{
              if(pic.Image!=null)pic.Image.Dispose();
            }
            ;
            pic.Click+=delegate{
              outgoingFiles.Remove(file);
              UpdateFileLabel();
              UpdateFilePreview();
            }
            ;
            tips.SetToolTip(pic,Path.GetFileName(file)+" (click to remove)");
            filePreview.Controls.Add(pic);
          }
        }
        else{
          Label label=new Label{
            Text=Path.GetFileName(file),AutoSize=false,Width=115,Height=55,ForeColor=ChatColors.Cyan,BackColor=ChatColors.Well,TextAlign=ContentAlignment.MiddleCenter
          }
          ;
          filePreview.Controls.Add(label);
        }
      }
      catch(Exception){
      }
    }
    filePreview.Visible=filePreview.Controls.Count>0;
    UpdateComposer();
  }
  private void LayoutEntryArea(){
    if(entry==null)return;
    int w=editorHost.Width,y=replyTarget==null?0:35;
    replyBanner.SetBounds(0,0,w,35);
    filePreview.SetBounds(0,y,w,66);
    if(filePreview.Controls.Count>0)y+=66;
    entry.SetBounds(0,y,w,Math.Max(1,editorHost.Height-y));
  }
  private void UpdateComposer(){
    if(composerBottom==null||frameGrid==null)return;
    bool readonlyMode=HistoryReadOnly&&replyTarget==null;
    composerBottom.Visible=!readonlyMode;
    int height=readonlyMode?0:103+(replyTarget==null?0:36)+(filePreview!=null&&filePreview.Visible?66:0);
    if(Math.Abs(frameGrid.RowStyles[2].Height-height)>0.5f)frameGrid.RowStyles[2].Height=height;
    if(replyBanner!=null){
      replyBanner.Visible=replyTarget!=null;
      if(replyTarget!=null)replyLabel.Text="↪ REPLY TO "+(replyTarget.User?"YOU: ":"CAPRI: ")+(replyTarget.Text.Length>85?replyTarget.Text.Substring(0,85)+"…":replyTarget.Text).Replace('\n',' ');
    }
    LayoutEntryArea();
  }
  private void BeginReply(CaprichatMessage target){
    if(target==null||target.IsNotice)return;
    replyTarget=target;
    SyncReadOnly();
    entry.Focus();
  }
  private void ClearReply(){
    replyTarget=null;
    SyncReadOnly();
  }
  private void PasteImage(){
    try{
      using(Image pasted=Clipboard.GetImage()){
        if(pasted==null)return;
        string folder=Path.Combine(mod.Folder,"pasted-images");
        Directory.CreateDirectory(folder);
        string file=Path.Combine(folder,DateTime.Now.ToString("yyyyMMdd-HHmmss-fff")+"-"+Guid.NewGuid().ToString("N").Substring(0,6)+".png");
        pasted.Save(file,System.Drawing.Imaging.ImageFormat.Png);
        QueueFiles(new[]{
          file
        }
        );
      }
    }
    catch(Exception error){
      MessageBox.Show(this,"Couldn't paste the image: "+error.Message,"Caprichat");
    }
  }
  private void Submit(){
    string text=entry.Text.Trim();
    if(text.Length==0&&outgoingFiles.Count==0)return;
    string[]files=outgoingFiles.ToArray();
    if(HistoryReadOnly&&replyTarget==null)return;
    if(!mod.Send(text,files,replyTarget)){
      entry.Focus();
      return;
    }
    outgoingFiles.Clear();
    UpdateFileLabel();
    UpdateFilePreview();
    entry.Clear();
    if(complete!=null)complete.Hide();
    if(replyTarget!=null){
      ClearReply();
      currentDay=DateTime.Now.ToString("yyyy-MM-dd");
      followLatest=true;
      RefreshChat();
    }
    ScrollBottom();
    entry.Focus();
  }
  internal bool InStarredView{
    get{
      return currentDay=="STARRED";
    }
  }
  private bool HistoryReadOnly{
    get{
      return currentDay!="ALL"&&currentDay!=DateTime.Now.ToString("yyyy-MM-dd");
    }
  }
  private void SyncReadOnly(){
    if(entry==null||entry.IsDisposed)return;
    bool locked=HistoryReadOnly;
    entry.ReadOnly=locked&&replyTarget==null;
    sendButton.Enabled=!locked||replyTarget!=null;
    pickerButton.Enabled=!locked||replyTarget!=null;
    attachButton.Enabled=!locked||replyTarget!=null;
    entry.BackColor=locked&&replyTarget==null?ChatColors.Ground:ChatColors.Field;
    UpdateComposer();
    if(locked&&replyTarget==null)status.Text="HISTORICAL DATE · READ ONLY · REPLY TO A MESSAGE TO WRITE";
    else status.Text=mod.Status+"   |   Enter sends · Shift+Enter adds a line";
  }
  internal void RefreshChat(){
    if(IsDisposed||updating||bubbles==null||!IsHandleCreated&&!Visible)return;
    updating=true;
    try{
      if(followLatest)currentDay=LatestDay();
      SyncReadOnly();
      if(starredButton!=null)starredButton.ForeColor=currentDay=="STARRED"?Color.Gold:ChatColors.Cyan;
      string[]names=(new[]{
        "ALL"
      }
      ).Concat(mod.Messages.Select(x=>x.At.ToString("yyyy-MM-dd")).Distinct().OrderByDescending(x=>x)).ToArray();
      string[]previous=days.Items.Cast<object>().Select(x=>x.ToString()).ToArray();
      if(!names.SequenceEqual(previous)){
        days.BeginUpdate();
        try{
          days.Items.Clear();
          days.Items.AddRange(names.Cast<object>().ToArray());
          int chosen=Array.IndexOf(names,currentDay);
          days.SelectedIndex=chosen;
        }
        finally{
          days.EndUpdate();
        }
        if(datesBar!=null)datesBar.Metrics(days.Items.Count*days.ItemHeight,days.ClientSize.Height);
      }
      string q=appliedSearch;
      CaprichatMessage[]next=mod.Messages.Where(x=>!x.SpeechPending&&!(mod.HideObservations&&x.IsObservation)&&!(mod.HideJobs&&x.IsActivity)&&(currentDay=="ALL"||(currentDay=="STARRED"&&mod.IsStarred(x.Id))||x.At.ToString("yyyy-MM-dd")==currentDay)&&(q.Length==0||x.Text.IndexOf(q,StringComparison.OrdinalIgnoreCase)>=0)).OrderBy(x=>x.At).ToArray();
      bool same=next.Length==filtered.Length&&next.Select(x=>x.Id).SequenceEqual(filtered.Select(x=>x.Id));
      bool modeChanged=lastMode!=currentDay;
      lastMode=currentDay;
      bool bottom=scroll.AtBottom;
      filtered=next;
      filteredIndexes.Clear();
      for(int i=0;
      i<filtered.Length;
      i++)filteredIndexes[filtered[i].Id]=i;
      if(!same||modeChanged){
        virtualWidth=-1;
        virtualStart=virtualEnd=-1;
      }
      if(modeChanged){
        foreach(CaprichatRow row in liveRows.Values.ToArray()){
          bubbles.Controls.Remove(row);
          row.Dispose();
        }
        liveRows.Clear();
        liveReactions.Clear();
      }
      if(days.Items.Count>0){
        int wanted=days.Items.IndexOf(currentDay);
        if(days.SelectedIndex!=wanted)days.SelectedIndex=wanted;
      }
      scroll.Reflow();
      if(!same&&bottom)scroll.ScrollToBottom();
      ShowVirtualRows();
    }
    finally{
      updating=false;
    }
  }
  private bool DateHeadingAt(int i){
    return(currentDay=="ALL"||currentDay=="STARRED")&&i>=0&&i<filtered.Length&&(i==0||filtered[i-1].At.Date!=filtered[i].At.Date);
  }
  private int EstimateHeight(CaprichatMessage m,int width){
    if(m.IsNotice)return 55;
    int cached;
    if(heightCache.TryGetValue(m.Id,out cached))return cached;
    float percent=Math.Max(.20f,Math.Min(.95f,m.User?MK002Settings.UserBubbleWidthPercent:MK002Settings.CapriBubbleWidthPercent));
    int inner=Math.Max(140,Math.Min(width-12,(int)(width*percent))-42);
    int chars=Math.Max(10,inner/Math.Max(6,(int)(mod.FontSize*0.65f)));
    int lines=0;
    foreach(string line in(m.Text??"").Split('\n'))lines+=Math.Max(1,(line.Length+chars-1)/chars);
    int height=148+lines*Math.Max(16,(int)(mod.FontSize*1.55f));
    if(!string.IsNullOrEmpty(m.Attachments))height+=180*m.Attachments.Split('\u001f').Length;
    List<CaprichatReaction>r;
    if(mod.Reactions.TryGetValue(m.Id,out r))height+=Math.Max(0,r.Count-4)/4*42;
    return heightCache[m.Id]=Math.Max(95,height);
  }
  private void BuildOffsets(){
    virtualTops=new int[filtered.Length+1];
    for(int i=0;
    i<filtered.Length;
    i++)virtualTops[i+1]=virtualTops[i]+virtualHeights[i];
  }
  private int LayoutBubbles(int width){
    if(bubbles==null)return 1;
    width=Math.Max(100,width);
    if(cachedWidth!=width){
      cachedWidth=width;
      heightCache.Clear();
    }
    if(virtualWidth!=width||virtualHeights.Length!=filtered.Length){
      virtualWidth=width;
      virtualHeights=new int[filtered.Length];
      for(int i=0;
      i<filtered.Length;
      i++)virtualHeights[i]=EstimateHeight(filtered[i],Math.Max(120,width-5))+(DateHeadingAt(i)?34:0);
      BuildOffsets();
      virtualStart=virtualEnd=-1;
    }
    bubbles.Width=width;
    if(!virtualUpdating)PositionVirtualRows();
    int height=virtualTops.Length==0?1:virtualTops[virtualTops.Length-1]+6;
    bubbles.Height=Math.Max(1,scroll.ClientSize.Height);
    return height;
  }
  private int VisibleIndex(int pixel){
    int l=0,r=filtered.Length;
    while(l<r){
      int mid=(l+r)/2;
      if(virtualTops[mid+1]<=pixel)l=mid+1;
      else r=mid;
    }
    return Math.Min(filtered.Length,l);
  }
  private void PositionVirtualRows(){
    if(virtualHeights.Length!=filtered.Length)return;
    int width=Math.Max(120,virtualWidth-5);
    bool resized=false;
    foreach(var entry in liveRows){
      int i;
      if(!filteredIndexes.TryGetValue(entry.Key,out i))continue;
      CaprichatRow row=entry.Value;
      row.LayoutFor(width);
      if(virtualHeights[i]<row.Height+12){
        virtualHeights[i]=row.Height+12;
        resized=true;
      }
    }
    if(resized)BuildOffsets();
    foreach(var entry in liveRows){
      int i;
      if(!filteredIndexes.TryGetValue(entry.Key,out i))continue;
      CaprichatRow row=entry.Value;
      row.SetBounds(2,virtualTops[i]-scroll.CurrentOffset+3,width,row.Height);
    }
  }
  private void ShowVirtualRows(){
    if(virtualUpdating||IsDisposed||!IsHandleCreated||virtualTops.Length!=filtered.Length+1)return;
    if(filtered.Length==0){
      foreach(CaprichatRow row in liveRows.Values.ToArray()){
        bubbles.Controls.Remove(row);
        row.Dispose();
      }
      liveRows.Clear();
      liveReactions.Clear();
      virtualStart=virtualEnd=0;
      return;
    }
    virtualUpdating=true;
    bool resizeNeeded=false,wasBottom=scroll.AtBottom;
    try{
      int first=VisibleIndex(scroll.CurrentOffset);
      int baseIndex=Math.Max(0,Math.Min(Math.Max(0,filtered.Length-MK002Settings.MessagesPerView),first));
      int lo=Math.Max(0,baseIndex-MK002Settings.MessagePreload),hi=Math.Min(filtered.Length,baseIndex+MK002Settings.MessagesPerView+MK002Settings.MessagePreload);
      HashSet<string>needed=new HashSet<string>();
      for(int i=lo;
      i<hi;
      i++)needed.Add(filtered[i].Id);
      bubbles.SuspendLayout();
      foreach(string key in liveRows.Keys.ToArray())if(!needed.Contains(key)){
        CaprichatRow old=liveRows[key];
        bubbles.Controls.Remove(old);
        old.Dispose();
        liveRows.Remove(key);
        liveReactions.Remove(key);
      }
      for(int i=lo;
      i<hi;
      i++){
        CaprichatMessage msg=filtered[i];
        CaprichatRow row;
        List<CaprichatReaction>reacts;
        string reactionSignature=(mod.Reactions.TryGetValue(msg.Id,out reacts)?string.Join(";",reacts.Select(r=>(r.Capri?"C":"U")+r.Glyph).ToArray()):"")+"/star="+mod.StarFlags(msg.Id)+"/day="+(DateHeadingAt(i)?"1":"0");
        string oldSignature;
        if(liveRows.TryGetValue(msg.Id,out row)&&liveReactions.TryGetValue(msg.Id,out oldSignature)&&oldSignature!=reactionSignature){
          heightCache.Remove(msg.Id);
          bubbles.Controls.Remove(row);
          row.Dispose();
          liveRows.Remove(msg.Id);
          row=null;
        }
        if(!liveRows.TryGetValue(msg.Id,out row)){
          string dateHeader=DateHeadingAt(i)?msg.At.ToString("dddd, MMMM d, yyyy"):null;
          row=new CaprichatRow(mod,msg,dateHeader);
          liveReactions[msg.Id]=reactionSignature;
          CaprichatMessage captured=msg;
          row.React+=delegate{
            OpenPicker(captured);
          }
          ;
          row.Reply+=delegate{
            BeginReply(captured);
          }
          ;
          row.Changed+=delegate{
            int ix=Array.FindIndex(filtered,m=>m.Id==captured.Id);
            if(ix<0||virtualHeights.Length!=filtered.Length)return;
            row.LayoutFor(Math.Max(120,virtualWidth-5));
            virtualHeights[ix]=row.Height+12;
            BuildOffsets();
            PositionVirtualRows();
            scroll.Reflow();
          }
          ;
          liveRows[msg.Id]=row;
          bubbles.Controls.Add(row);
        }
        row.LayoutFor(Math.Max(120,virtualWidth-5));
        row.SetBounds(2,virtualTops[i]-scroll.CurrentOffset+3,Math.Max(120,virtualWidth-5),row.Height);
        int measured=row.Height+12;
        if(Math.Abs(measured-virtualHeights[i])>3){
          virtualHeights[i]=measured;
          resizeNeeded=true;
        }
      }
      bubbles.ResumeLayout(false);
      virtualStart=lo;
      virtualEnd=hi;
      if(resizeNeeded){
        BuildOffsets();
        PositionVirtualRows();
      }
    }
    finally{
      virtualUpdating=false;
    }
    if(resizeNeeded&&!IsDisposed&&IsHandleCreated){
      scroll.Reflow();
      PositionVirtualRows();
      if(wasBottom)scroll.ScrollToBottom();
    }
  }
  private void ScrollBottom(){
    if(scroll!=null&&!scroll.IsDisposed)scroll.ScrollToBottom();
  }
  internal void OpenPicker(CaprichatMessage target){
    if(target==null&&HistoryReadOnly)return;
    if(activePicker!=null&&!activePicker.IsDisposed){
      activePicker.Close();
      activePicker=null;
    }
    CaprichatPicker picker=new CaprichatPicker(mod,target==null?"INSERT EMOJI":"REACT TO MESSAGE");
    activePicker=picker;
    picker.StartPosition=FormStartPosition.Manual;
    Rectangle area=Screen.FromControl(this).WorkingArea;
    picker.Location=new Point(Math.Max(area.Left,Math.Min(area.Right-picker.Width,Left+(Width-picker.Width)/2)),Math.Max(area.Top,Math.Min(area.Bottom-picker.Height,Top+(Height-picker.Height)/2)));
    bool selectedFromPicker=false;
    picker.EmojiPicked+=delegate(string glyph){
      if(glyph==null)return;
      if(target==null){
        if(HistoryReadOnly)return;
        selectedFromPicker=true;
        entry.InsertEmoji(glyph);
        entry.Invalidate();
        mod.RememberEmoji(glyph);
      }
      else mod.ToggleReaction(target,glyph);
    }
    ;
    picker.FormClosed+=delegate{
      if(activePicker==picker)activePicker=null;
      picker.Dispose();
      if(selectedFromPicker&&IsHandleCreated)BeginInvoke((Action)delegate{
        if(!IsDisposed&&entry.Visible)entry.Focus();
      }
      );
    }
    ;
    picker.Deactivate+=delegate{
      if(!picker.IsDisposed)picker.Close();
    }
    ;
    picker.Show(this);
  }
}
internal sealed class CaprichatScrollBar:Control{
  private int value,total,viewport,drag=-1;
  internal event Action<int>Changed;
  internal int Value{
    get{
      return value;
    }
    set{
      int next=Math.Max(0,Math.Min(Math.Max(0,total-viewport),value));
      if(next==this.value)return;
      this.value=next;
      Invalidate();
      if(Changed!=null)Changed(next);
    }
  }
  internal CaprichatScrollBar(){
    Width=16;
    BackColor=ChatColors.Ground;
    Cursor=Cursors.Hand;
    SetStyle(ControlStyles.UserPaint|ControlStyles.AllPaintingInWmPaint|ControlStyles.OptimizedDoubleBuffer,true);
  }
  internal void Metrics(int contents,int visible){
    total=Math.Max(0,contents);
    viewport=Math.Max(1,visible);
    Value=value;
    Invalidate();
  }
  internal void ScrollBy(int pixels){
    Value+=pixels;
  }
  private Rectangle Thumb{
    get{
      int h=Math.Min(Math.Max(22,(int)((long)Height*viewport/Math.Max(1,total))),Math.Max(1,Height-4));
      int y=2+(int)((long)Math.Max(0,Height-4-h)*value/Math.Max(1,total-viewport));
      return new Rectangle(3,y,Math.Max(2,Width-6),h);
    }
  }
  protected override void OnPaint(PaintEventArgs e){
    e.Graphics.Clear(ChatColors.Ground);
    using(Brush b=new SolidBrush(Color.FromArgb(12,11,20)))e.Graphics.FillRectangle(b,1,1,Width-3,Math.Max(1,Height-3));
    using(Pen p=new Pen(ChatColors.Edge))e.Graphics.DrawRectangle(p,1,1,Width-3,Math.Max(1,Height-3));
    using(Pen p=new Pen(Color.FromArgb(78,28,40)))for(int y=8;
    y<Height-5;
    y+=10)e.Graphics.DrawLine(p,Width/2,y,Width-3,y);
    using(Brush b=new SolidBrush(ChatColors.Hot))e.Graphics.FillRectangle(b,Thumb);
    using(Pen p=new Pen(ChatColors.Rose))e.Graphics.DrawLine(p,Thumb.Left,Thumb.Top,Thumb.Left,Thumb.Bottom);
  }
  protected override void OnMouseDown(MouseEventArgs e){
    base.OnMouseDown(e);
    if(e.Button!=MouseButtons.Left)return;
    drag=Thumb.Contains(e.Location)?e.Y-Thumb.Y:Thumb.Height/2;
    Capture=true;
    MoveThumb(e.Y);
  }
  protected override void OnMouseMove(MouseEventArgs e){
    if(drag>=0)MoveThumb(e.Y);
    base.OnMouseMove(e);
  }
  protected override void OnMouseUp(MouseEventArgs e){
    drag=-1;
    Capture=false;
    base.OnMouseUp(e);
  }
  private void MoveThumb(int y){
    Value=(int)((long)(y-drag-2)*Math.Max(0,total-viewport)/Math.Max(1,Height-Thumb.Height-4));
  }
  internal event Action<int>WheelRequested;
  protected override void OnMouseWheel(MouseEventArgs e){
    if(WheelRequested!=null)WheelRequested(-e.Delta/120*MK002Settings.WheelScrollPixels);
  }
}
internal sealed class CaprichatCanvas:Panel{
  internal CaprichatCanvas(){
    BackColor=ChatColors.Ground;
    AutoScroll=false;
    DoubleBuffered=true;
    SetStyle(ControlStyles.AllPaintingInWmPaint|ControlStyles.OptimizedDoubleBuffer,true);
  }
}
internal sealed class CaprichatAutoScroll:IDisposable{
  private readonly Control surface;
  private readonly Action<int>scroll;
  private readonly System.Windows.Forms.Timer ticker;
  private Control marker;
  private Point anchor;
  private bool active;
  internal CaprichatAutoScroll(Control owner,Action<int>scrollBy){
    surface=owner;
    scroll=scrollBy;
    ticker=new System.Windows.Forms.Timer{
      Interval=MK002Settings.ScrollTickMilliseconds
    }
    ;
    ticker.Tick+=delegate{
      if(!active||surface.IsDisposed){
        Stop();
        return;
      }
      Form containingForm=surface.FindForm();
      if(containingForm!=null&&!containingForm.ContainsFocus){
        Stop();
        return;
      }
      if((Control.MouseButtons&(MouseButtons.Left|MouseButtons.Right))!=MouseButtons.None){
        Stop();
        return;
      }
      int dy=Cursor.Position.Y-anchor.Y;
      double distance=Math.Abs((double)dy);
      double deadZone=Math.Max(0,MK002Settings.MiddleScrollDeadZonePixels);
      if(distance<=deadZone)return;
      double threshold=Math.Max(deadZone,MK002Settings.MiddleScrollExponentialStartPixels);
      double growth=Math.Max(1.0,MK002Settings.MiddleScrollExponentialGrowthPixels);
      double slope=Math.Max(0.01,MK002Settings.MiddleScrollSpeed);
      double velocity=(Math.Min(distance,threshold)-deadZone)*slope;
      if(distance>threshold){
        double exponent=Math.Min(20.0,(distance-threshold)/growth);
        velocity+=slope*growth*(Math.Exp(exponent)-1.0);
      }
      int cap=Math.Max(1,MK002Settings.MiddleScrollMaxPixelsPerTick);
      int movement=(int)Math.Min(cap,Math.Max(1.0,Math.Round(velocity)));
      scroll(dy<0?-movement:movement);
    }
    ;
  }
  internal void MouseDown(object sender,MouseEventArgs e){
    if(e.Button==MouseButtons.Middle){
      if(active){
        Stop();
        return;
      }
      if(!surface.IsHandleCreated)return;
      active=true;
      anchor=Cursor.Position;
      marker=new CaprichatScrollAnchor();
      marker.Size=new Size(28,28);
      Point local=surface.PointToClient(anchor);
      marker.Location=new Point(Math.Max(0,Math.Min(surface.ClientSize.Width-28,local.X-14)),Math.Max(0,Math.Min(surface.ClientSize.Height-28,local.Y-14)));
      surface.Controls.Add(marker);
      marker.BringToFront();
      marker.MouseDown+=MouseDown;
      ticker.Start();
    }
    else if(active)Stop();
  }
  internal void Stop(){
    active=false;
    ticker.Stop();
    if(marker!=null){
      marker.Dispose();
      marker=null;
    }
  }
  public void Dispose(){
    Stop();
    ticker.Dispose();
  }
}
internal sealed class CaprichatScrollAnchor:Control{
  internal CaprichatScrollAnchor(){
    BackColor=ChatColors.Ground;
    DoubleBuffered=true;
    Cursor=Cursors.SizeNS;
  }
  protected override void OnPaint(PaintEventArgs e){
    e.Graphics.SmoothingMode=SmoothingMode.AntiAlias;
    using(Pen p=new Pen(ChatColors.Cyan,1.6f))e.Graphics.DrawEllipse(p,4,4,19,19);
    using(Brush b=new SolidBrush(ChatColors.Cyan)){
      e.Graphics.FillPolygon(b,new[]{
        new Point(14,5),new Point(9,11),new Point(19,11)
      }
      );
      e.Graphics.FillPolygon(b,new[]{
        new Point(14,23),new Point(9,17),new Point(19,17)
      }
      );
    }
  }
}
internal sealed class CaprichatScrollView:Panel{
  private readonly CaprichatScrollBar bar;
  private readonly System.Windows.Forms.Timer smooth;
  private readonly CaprichatAutoScroll autoScroll;
  private Control body;
  private Func<int,int>layout;
  private bool arranging;
  private int contentHeight,target;
  internal event Action Scrolled;
  internal int CurrentOffset{
    get{
      return bar.Value;
    }
  }
  internal bool AtBottom{
    get{
      return contentHeight-ClientSize.Height-bar.Value<100;
    }
  }
  internal CaprichatScrollView(){
    AutoScroll=false;
    DoubleBuffered=true;
    BackColor=ChatColors.Ground;
    bar=new CaprichatScrollBar();
    Controls.Add(bar);
    bar.Changed+=delegate(int value){
      if(!smooth.Enabled)target=value;
      if(Scrolled!=null)Scrolled();
    }
    ;
    bar.WheelRequested+=Wheel;
    autoScroll=new CaprichatAutoScroll(this,delegate(int delta){
      smooth.Stop();
      bar.ScrollBy(delta);
      target=bar.Value;
    }
    );
    MouseDown+=autoScroll.MouseDown;
    bar.MouseDown+=autoScroll.MouseDown;
    smooth=new System.Windows.Forms.Timer{
      Interval=MK002Settings.ScrollTickMilliseconds
    }
    ;
    smooth.Tick+=delegate{
      int gap=target-bar.Value;
      if(Math.Abs(gap)<=2){
        bar.Value=target;
        smooth.Stop();
        return;
      }
      bar.Value+=Math.Sign(gap)*Math.Max(2,Math.Abs(gap)/MK002Settings.SmoothScrollDivisor);
    }
    ;
  }
  protected override void Dispose(bool disposing){
    if(disposing){
      autoScroll.Dispose();
      smooth.Stop();
      smooth.Dispose();
    }
    base.Dispose(disposing);
  }
  internal void SetBody(Control element,Func<int,int>sizing){
    body=element;
    layout=sizing;
    Controls.Add(body);
    bar.BringToFront();
    WireWheel(body);
    Reflow();
  }
  private void WireWheel(Control c){
    c.MouseWheel+=delegate(object sender,MouseEventArgs e){
      autoScroll.Stop();
      Wheel(-e.Delta/120*MK002Settings.WheelScrollPixels);
    }
    ;
    c.MouseDown+=autoScroll.MouseDown;
    c.ControlAdded+=delegate(object sender,ControlEventArgs e){
      WireWheel(e.Control);
    }
    ;
    foreach(Control child in c.Controls)WireWheel(child);
  }
  private void Wheel(int delta){
    autoScroll.Stop();
    if(!smooth.Enabled)target=bar.Value;
    target=Math.Max(0,Math.Min(Math.Max(0,contentHeight-ClientSize.Height),target+delta));
    if(!smooth.Enabled)smooth.Start();
  }
  internal void Reflow(){
    if(arranging||body==null||layout==null||ClientSize.Width<1)return;
    arranging=true;
    try{
      int width=Math.Max(1,ClientSize.Width-20);
      contentHeight=Math.Max(0,layout(width));
      bool visible=contentHeight>ClientSize.Height;
      if(!visible){
        width=Math.Max(1,ClientSize.Width);
        contentHeight=Math.Max(0,layout(width));
        visible=contentHeight>ClientSize.Height;
      }
      body.SetBounds(0,0,width,Math.Max(1,ClientSize.Height));
      bar.Visible=visible;
      bar.SetBounds(ClientSize.Width-16,1,14,Math.Max(1,ClientSize.Height-2));
      bar.Metrics(contentHeight,ClientSize.Height);
      bar.BringToFront();
      target=Math.Min(target,Math.Max(0,contentHeight-ClientSize.Height));
    }
    finally{
      arranging=false;
    }
  }
  internal void ScrollToBottom(){
    smooth.Stop();
    Reflow();
    bar.Value=int.MaxValue;
    target=bar.Value;
  }
  protected override void OnSizeChanged(EventArgs e){
    base.OnSizeChanged(e);
    Reflow();
  }
  protected override void OnMouseWheel(MouseEventArgs e){
    Wheel(-e.Delta/120*MK002Settings.WheelScrollPixels);
  }
}
internal sealed class CaprichatDivider:Control{
  private readonly string caption;
  internal CaprichatDivider(string text,float pointSize){
    caption=text;
    Height=27;
    BackColor=ChatColors.Ground;
    ForeColor=ChatColors.Faint;
    Font=ChatColors.Font(pointSize,true);
    DoubleBuffered=true;
  }
  protected override void OnPaint(PaintEventArgs e){
    base.OnPaint(e);
    int textWidth=TextRenderer.MeasureText(caption,Font,Size.Empty,TextFormatFlags.NoPadding|TextFormatFlags.NoPrefix|TextFormatFlags.SingleLine).Width;
    int left=Math.Max(2,(Width-textWidth)/2),y=Height/2;
    using(Pen pen=new Pen(ChatColors.Edge,1f)){
      if(left>14)e.Graphics.DrawLine(pen,6,y,left-9,y);
      int right=left+textWidth+9;
      if(right<Width-8)e.Graphics.DrawLine(pen,right,y,Width-6,y);
    }
    TextRenderer.DrawText(e.Graphics,caption,Font,new Rectangle(left,0,Math.Max(1,Width-left),Height),ForeColor,TextFormatFlags.NoPadding|TextFormatFlags.NoPrefix|TextFormatFlags.SingleLine|TextFormatFlags.VerticalCenter);
  }
}
internal sealed class CaprichatRow:Panel{
  private readonly CaprichatMessage data;
  private readonly CaprichatBubble bubble;
  private readonly CaprichatNotice notice;
  private readonly CaprichatDivider dateHeader;
  private readonly int extra;
  internal event Action React;
  internal event Action Reply;
  internal event Action Changed;
  internal CaprichatRow(MK002Caprichat mod,CaprichatMessage msg,string heading){
    data=msg;
    BackColor=ChatColors.Ground;
    AutoSize=false;
    DoubleBuffered=true;
    if(!string.IsNullOrEmpty(heading)){
      extra=34;
      dateHeader=new CaprichatDivider(heading,MK002Settings.DateFontSize);
      Controls.Add(dateHeader);
    }
    if(msg.IsNotice){
      notice=new CaprichatNotice(msg);
      Controls.Add(notice);
      notice.Changed+=delegate{
        LayoutFor(Width);
        if(Changed!=null)Changed();
      }
      ;
    }
    else{
      bubble=new CaprichatBubble(mod,msg);
      Controls.Add(bubble);
      bubble.React+=delegate{
        if(React!=null)React();
      }
      ;
      bubble.Reply+=delegate{
        if(Reply!=null)Reply();
      }
      ;
    }
  }
  internal void LayoutFor(int width){
    Width=width;
    if(dateHeader!=null)dateHeader.SetBounds(0,1,width,27);
    if(notice!=null){
      notice.LayoutFor(Math.Max(120,width-12));
      notice.Left=5;
      notice.Top=extra+1;
      Height=notice.Height+8+extra;
      return;
    }
    float percent=data.User?MK002Settings.UserBubbleWidthPercent:MK002Settings.CapriBubbleWidthPercent;
    float cap=Math.Max(.20f,Math.Min(.95f,percent));
    int bubbleWidth=Math.Min(width-12,Math.Max(275,(int)(width*cap)));
    bubble.SizeFor(bubbleWidth);
    bubble.Left=data.User?Math.Max(4,width-bubbleWidth-6):6;
    bubble.Top=extra+1;
    Height=bubble.Height+9+extra;
  }
}
internal sealed class CaprichatNotice:Control{
  private readonly CaprichatMessage data;
  private readonly ToolTip tip=new ToolTip();
  private bool expanded;
  internal event Action Changed;
  internal CaprichatNotice(CaprichatMessage msg){
    data=msg;
    DoubleBuffered=true;
    BackColor=ChatColors.Ground;
    Cursor=Cursors.Hand;
    tip.SetToolTip(this,(msg.IsActivity?"JOB: ":"OBSERVATION: ")+msg.Text+" (click to expand)");
    Height=39;
    Click+=delegate{
      expanded=!expanded;
      LayoutFor(Width);
      if(Changed!=null)Changed();
    }
    ;
  }
  internal void LayoutFor(int width){
    Width=width;
    int h=expanded?TextRenderer.MeasureText(data.Text,ChatColors.Font(MK002Settings.NoticeFontSize,false),new Size(Math.Max(100,width-55),10000),TextFormatFlags.WordBreak|TextFormatFlags.NoPrefix).Height+49:39;
    Height=Math.Max(39,h);
    Invalidate();
  }
  protected override void Dispose(bool disposing){
    if(disposing)tip.Dispose();
    base.Dispose(disposing);
  }
  protected override void OnPaint(PaintEventArgs e){
    base.OnPaint(e);
    Color accent=data.IsActivity?ChatColors.Blue:Color.FromArgb(255,211,74);
    e.Graphics.SmoothingMode=SmoothingMode.AntiAlias;
    using(Pen p=new Pen(accent,1.5f))e.Graphics.DrawEllipse(p,5,5,25,25);
    TextRenderer.DrawText(e.Graphics,"i",ChatColors.Font(12,true),new Rectangle(6,5,24,25),accent,TextFormatFlags.HorizontalCenter|TextFormatFlags.VerticalCenter|TextFormatFlags.NoPadding);
    string heading=data.IsActivity?"JOB  ·  click to expand":"OBSERVATION  ·  click to expand";
    TextRenderer.DrawText(e.Graphics,heading,ChatColors.Font(9,false),new Rectangle(40,5,Math.Max(1,Width-42),25),accent,TextFormatFlags.VerticalCenter|TextFormatFlags.NoPrefix|TextFormatFlags.EndEllipsis);
    if(expanded)TextRenderer.DrawText(e.Graphics,data.Text,ChatColors.Font(MK002Settings.NoticeFontSize,false),new Rectangle(42,36,Math.Max(1,Width-55),Math.Max(1,Height-41)),accent,TextFormatFlags.WordBreak|TextFormatFlags.NoPrefix);
  }
}
internal sealed class CaprichatEmojiText:Control{
  private sealed class Part{
    internal string Text;
    internal Image Picture;
    internal int X,Y,Width,Height;
  }
  private readonly List<Part>placed=new List<Part>();
  private readonly string content;
  private int lastWidth=-1,lastHeight;
  private static Dictionary<char,List<string>>glyphsByStart;
  internal CaprichatEmojiText(string value){
    content=CaprichatEmoji.FromModelText(value??"");
    DoubleBuffered=true;
    SetStyle(ControlStyles.SupportsTransparentBackColor,true);
    BackColor=Color.Transparent;
    Text=content;
  }
  internal static string GlyphAt(string value,int at){
    if(glyphsByStart==null){
      Dictionary<char,List<string>>build=new Dictionary<char,List<string>>();
      foreach(CaprichatEmoji emoji in CaprichatEmoji.All){
        if(emoji.Glyph.Length==0)continue;
        List<string>found;
        if(!build.TryGetValue(emoji.Glyph[0],out found))build[emoji.Glyph[0]]=found=new List<string>();
        found.Add(emoji.Glyph);
      }
      foreach(List<string>items in build.Values)items.Sort(delegate(string a,string b){
        return b.Length.CompareTo(a.Length);
      }
      );
      glyphsByStart=build;
    }
    List<string>candidates;
    if(!glyphsByStart.TryGetValue(value[at],out candidates))return null;
    foreach(string glyph in candidates)if(value.Length-at>=glyph.Length&&string.CompareOrdinal(value,at,glyph,0,glyph.Length)==0)return glyph;
    return null;
  }
  internal int MeasureFor(int width){
    width=Math.Max(50,width);
    if(width==lastWidth)return lastHeight;
    lastWidth=width;
    placed.Clear();
    int x=0,y=0,line=Math.Max(24,Font.Height+8),icon=Math.Min(29,Math.Max(20,line-2));
    using(Bitmap canvas=new Bitmap(1,1))using(Graphics g=Graphics.FromImage(canvas)){
      int at=0;
      while(at<content.Length){
        if(content[at]=='\r'){
          at++;
          continue;
        }
        if(content[at]=='\n'){
          x=0;
          y+=line;
          at++;
          continue;
        }
        string emoji=GlyphAt(content,at);
        if(emoji!=null){
          if(x+icon>width&&x>0){
            x=0;
            y+=line;
          }
          placed.Add(new Part{
            Picture=CaprichatEmojiArt.Get(emoji,icon),X=x,Y=y+(line-icon)/2,Width=icon,Height=icon
          }
          );
          x+=icon+Math.Max(0,MK002Settings.EmojiSpacingPixels);
          at+=emoji.Length;
          continue;
        }
        string token;
        if(char.IsWhiteSpace(content[at])){
          while(at<content.Length&&content[at]!='\n'&&content[at]!='\r'&&char.IsWhiteSpace(content[at])&&GlyphAt(content,at)==null)at++;
          token=" ";
        }
        else{
          int from=at;
          while(at<content.Length&&!char.IsWhiteSpace(content[at])&&GlyphAt(content,at)==null)at++;
          token=content.Substring(from,at-from);
        }
        if(token.Length==0)continue;
        int w=Math.Max(1,(int)Math.Ceiling(g.MeasureString(token,Font,PointF.Empty,StringFormat.GenericTypographic).Width));
        if(token==" ")w=Math.Max(3,w);
        if(x+w>width&&x>0){
          x=0;
          y+=line;
          if(token==" ")continue;
        }
        if(w<=width){
          placed.Add(new Part{
            Text=token,X=x,Y=y,Width=w,Height=line
          }
          );
          x+=w;
          continue;
        }
        foreach(char letter in token){
          string ch=letter.ToString();
          int cw=Math.Max(1,(int)Math.Ceiling(g.MeasureString(ch,Font,PointF.Empty,StringFormat.GenericTypographic).Width));
          if(x+cw>width&&x>0){
            x=0;
            y+=line;
          }
          placed.Add(new Part{
            Text=ch,X=x,Y=y,Width=cw,Height=line
          }
          );
          x+=cw;
        }
      }
    }
    lastHeight=Math.Max(line,y+line+3);
    return lastHeight;
  }
  protected override void OnPaint(PaintEventArgs e){
    base.OnPaint(e);
    MeasureFor(ClientSize.Width);
    using(Brush ink=new SolidBrush(ForeColor))foreach(Part part in placed){
      if(part.Picture!=null)e.Graphics.DrawImage(part.Picture,new Rectangle(part.X,part.Y,part.Width,part.Height));
      else e.Graphics.DrawString(part.Text,Font,ink,new PointF(part.X,part.Y+1),StringFormat.GenericTypographic);
    }
  }
}
internal sealed class CaprichatBubble:Panel{
  private readonly MK002Caprichat mod;
  private readonly CaprichatMessage data;
  private readonly List<Button>reactionButtons=new List<Button>();
  private readonly List<PictureBox>pictures=new List<PictureBox>();
  private CaprichatEmojiText body;
  private Label head,stamp;
  private Button react,star,reply;
  private int lastWidth;
  internal event Action React;
  internal event Action Reply;
  internal CaprichatBubble(MK002Caprichat owner,CaprichatMessage msg){
    mod=owner;
    data=msg;
    BackColor=ChatColors.Ground;
    DoubleBuffered=true;
    head=new Label{
      Text=data.User?"YOU":"CAPRI",AutoSize=true,ForeColor=data.User?ChatColors.Rose:ChatColors.Blue,BackColor=Color.Transparent,Font=ChatColors.Font(9,true)
    }
    ;
    Controls.Add(head);
    stamp=new Label{
      Text=data.At.ToString("yyyy-MM-dd HH:mm"),AutoSize=true,ForeColor=ChatColors.Faint,BackColor=Color.Transparent,Font=ChatColors.Font(8,false)
    }
    ;
    Controls.Add(stamp);
    body=new CaprichatEmojiText(data.Text){
      ForeColor=data.User?ChatColors.White:ChatColors.Cyan,BackColor=Color.Transparent,Font=ChatColors.Font(mod.FontSize,false)
    }
    ;
    Controls.Add(body);
    react=ChatColors.Button("React",70);
    react.Height=30;
    react.Click+=delegate{
      if(React!=null)React();
    }
    ;
    Controls.Add(react);
    reply=ChatColors.Button("Reply",64);
    reply.Height=30;
    reply.Click+=delegate{
      if(Reply!=null)Reply();
    }
    ;
    Controls.Add(reply);
    bool starred=mod.IsStarred(data.Id);
    if(starred){
      head.ForeColor=Color.Gold;
      body.ForeColor=Color.FromArgb(255,225,149);
      stamp.ForeColor=Color.FromArgb(210,174,92);
    }
    star=ChatColors.Button(starred?"★":"☆",40);
    star.Font=new Font("Segoe UI Symbol",14f,FontStyle.Regular);
    star.Height=30;
    star.ForeColor=starred?Color.Gold:ChatColors.Faint;
    star.Click+=delegate{
      if(mod.IsStarred(data.Id)&&mod.Window!=null&&mod.Window.InStarredView&&MessageBox.Show(mod.Window,"Remove this message from Starred?","Unstar message",MessageBoxButtons.YesNo,MessageBoxIcon.Question)!=DialogResult.Yes)return;
      mod.ToggleStar(data);
    }
    ;
    Controls.Add(star);
    if(!string.IsNullOrEmpty(data.Attachments))foreach(string path in data.Attachments.Split('\u001f').Take(8)){
      if(!File.Exists(path))continue;
      string extension=Path.GetExtension(path).ToLowerInvariant();
      if(Array.IndexOf(new[]{
        ".png",".jpg",".jpeg",".gif",".bmp",".webp"
      }
      ,extension)<0)continue;
      try{
        using(Image source=Image.FromFile(path)){
          int longest=Math.Max(source.Width,source.Height);
          double scale=Math.Min(1.0,620.0/Math.Max(1,longest));
          Image thumbnail=new Bitmap(source,Math.Max(1,(int)(source.Width*scale)),Math.Max(1,(int)(source.Height*scale)));
          PictureBox preview=new PictureBox{
            Image=thumbnail,SizeMode=PictureBoxSizeMode.Zoom,BackColor=ChatColors.Well,Cursor=Cursors.Hand,Tag=path
          }
          ;
          preview.Click+=delegate{
            try{
              System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(path){
                UseShellExecute=true
              }
              );
            }
            catch(Exception){
            }
          }
          ;
          preview.Disposed+=delegate{
            if(preview.Image!=null)preview.Image.Dispose();
          }
          ;
          Controls.Add(preview);
          pictures.Add(preview);
        }
      }
      catch(Exception){
      }
    }
    List<CaprichatReaction>list;
    if(mod.Reactions.TryGetValue(data.Id,out list))foreach(CaprichatReaction r in list){
      Button chip=ChatColors.Button("",44);
      chip.Height=40;
      chip.Image=CaprichatEmojiArt.Get(r.Glyph,30);
      chip.ImageAlign=ContentAlignment.MiddleCenter;
      chip.FlatAppearance.BorderColor=r.Capri?ChatColors.Blue:ChatColors.Rose;
      chip.FlatAppearance.BorderSize=2;
      chip.FlatAppearance.MouseOverBackColor=ChatColors.Well;
      if(!r.Capri){
        CaprichatReaction mine=r;
        chip.Click+=delegate{
          mod.ToggleReaction(data,mine.Glyph);
        }
        ;
      }
      reactionButtons.Add(chip);
      Controls.Add(chip);
    }
    MouseUp+=delegate(object sender,MouseEventArgs e){
      if(e.Button==MouseButtons.Right&&React!=null)React();
    }
    ;
  }
  internal void SizeFor(int width){
    if(width==lastWidth)return;
    lastWidth=width;
    Width=width;
    int inner=Math.Max(140,width-42);
    head.SetBounds(22,13,inner/2,18);
    stamp.Location=new Point(Math.Max(22,width-stamp.PreferredWidth-24),14);
    int textH=body.MeasureFor(inner)+9;
    body.SetBounds(22,47,inner,textH);
    int y=body.Bottom+12,x=21;
    foreach(PictureBox preview in pictures){
      int originalW=preview.Image==null?1:preview.Image.Width,originalH=preview.Image==null?1:preview.Image.Height;
      int previewH=Math.Min(260,Math.Max(65,(int)((double)(width-58)*originalH/Math.Max(1,originalW))));
      preview.SetBounds(21,y,width-58,previewH);
      y+=previewH+12;
    }
    foreach(Button chip in reactionButtons){
      if(x+chip.Width>=width-99){
        x=21;
        y+=42;
      }
      chip.Location=new Point(x,y);
      x+=49;
    }
    react.Location=new Point(width-96,y);
    star.Location=new Point(width-143,y);
    reply.Location=new Point(width-214,y);
    Height=Math.Max(92,y+60);
    Invalidate();
  }
  protected override void OnPaint(PaintEventArgs e){
    base.OnPaint(e);
    e.Graphics.SmoothingMode=SmoothingMode.AntiAlias;
    Color accent=mod.IsStarred(data.Id)?Color.FromArgb(246,196,65):(data.User?ChatColors.Rose:ChatColors.Blue);
    Rectangle r=new Rectangle(0,0,Width-1,Height-1);
    using(GraphicsPath path=ChatColors.Cut(r,0,data.User))using(Brush fill=new SolidBrush(mod.IsStarred(data.Id)?Color.FromArgb(41,34,15):(data.User?ChatColors.Field:Color.FromArgb(8,20,28))))using(Pen stroke=new Pen(accent,1.5f)){
      e.Graphics.FillPath(fill,path);
      e.Graphics.DrawPath(stroke,path);
    }
    using(Pen bar=new Pen(ChatColors.Hot,2f))e.Graphics.DrawLine(bar,14,17,14,Height-34);
  }
}
internal static class CaprichatEmojiArt{
  private const int Cols=24,BaseCell=36,PackCell=48,ShardSize=320;
  private static string folder;
  private static Bitmap builtin;
  private static readonly Dictionary<string,Bitmap>atlases=new Dictionary<string,Bitmap>();
  private static readonly Dictionary<string,Image>cache=new Dictionary<string,Image>();
  private static readonly Dictionary<string,int>index=new Dictionary<string,int>();
  private static readonly Dictionary<string,bool>available=new Dictionary<string,bool>();
  private static readonly HashSet<string>activeFiles=new HashSet<string>(StringComparer.OrdinalIgnoreCase);
  private static bool initialized;
  private static readonly string[]groupNames={
    "Smileys & Emotion","People & Body","Animals & Nature","Food & Drink","Travel & Places","Activities","Objects","Symbols","Flags","Component"
  }
  ;
  internal static void SetFolder(string baseFolder){
    folder=Path.Combine(baseFolder,"emoji-packs");
    Directory.CreateDirectory(folder);
    RefreshPacks();
  }
  internal static void RefreshPacks(){
    available.Clear();
    cache.Clear();
    atlases.Clear();
    activeFiles.Clear();
    if(builtin!=null){
      builtin.Dispose();
      builtin=null;
    }
    if(folder!=null&&Directory.Exists(folder))foreach(string file in Directory.GetFiles(folder,"pack-*-*.png"))activeFiles.Add(Path.GetFileName(file));
  }
  private static string PackPath(string category,int index){
    int group=Array.IndexOf(groupNames,category);
    int start=index/ShardSize*ShardSize;
    return group<1||folder==null?null:Path.Combine(folder,"pack-"+group+"-"+start+".png");
  }
  internal static bool HasPack(string category){
    if(category=="Smileys & Emotion")return folder!=null&&File.Exists(Path.Combine(folder,"smileys.png"));
    bool result;
    if(available.TryGetValue(category,out result))return result;
    int group=Array.IndexOf(groupNames,category);
    result=group>0&&activeFiles.Any(x=>x.StartsWith("pack-"+group+"-",StringComparison.OrdinalIgnoreCase));
    available[category]=result;
    return result;
  }
  internal static bool HasArt(CaprichatEmoji item){
    if(item==null)return false;
    if(item.Category=="Smileys & Emotion")return HasPack(item.Category);
    Setup();
    int i;
    if(!index.TryGetValue(item.Glyph,out i))return false;
    string path=PackPath(item.Category,i);
    return path!=null&&activeFiles.Contains(Path.GetFileName(path));
  }
  private static void Setup(){
    if(initialized)return;
    initialized=true;
    Dictionary<string,int>counts=new Dictionary<string,int>();
    foreach(CaprichatEmoji item in CaprichatEmoji.All){
      int n;
      counts.TryGetValue(item.Category,out n);
      if(!index.ContainsKey(item.Glyph))index[item.Glyph]=n;
      counts[item.Category]=n+1;
    }
  }
  internal static Image Get(string glyph,int size){
    if(string.IsNullOrEmpty(glyph))return null;
    Setup();
    size=Math.Max(8,Math.Min(72,size));
    string key=glyph+"/"+size;
    Image existing;
    if(cache.TryGetValue(key,out existing))return existing;
    CaprichatEmoji item=CaprichatEmoji.Find(glyph);
    Bitmap result=null,source=null;
    int cell=PackCell;
    if(item!=null){
      if(item.Category=="Smileys & Emotion"){
        if(builtin==null&&folder!=null)try{
          using(Image img=Image.FromFile(Path.Combine(folder,"smileys.png")))builtin=new Bitmap(img);
        }
        catch(Exception){
        }
        source=builtin;
        cell=BaseCell;
      }
      else{
        int currentIndex;
        if(index.TryGetValue(glyph,out currentIndex)){
          string file=PackPath(item.Category,currentIndex);
          if(file!=null&&File.Exists(file)){
            if(!atlases.TryGetValue(file,out source)){
              try{
                using(Image image=Image.FromFile(file))source=new Bitmap(image);
              }
              catch(Exception){
                source=null;
              }
              if(source!=null)atlases[file]=source;
            }
          }
        }
      }
    }
    if(source!=null&&item!=null){
      int i;
      if(index.TryGetValue(glyph,out i))try{
        if(item.Category!="Smileys & Emotion")i%=ShardSize;
        result=new Bitmap(size,size);
        using(Graphics g=Graphics.FromImage(result)){
          g.Clear(Color.Transparent);
          g.InterpolationMode=InterpolationMode.HighQualityBicubic;
          g.DrawImage(source,new Rectangle(0,0,size,size),new Rectangle((i%Cols)*cell,(i/Cols)*cell,cell,cell),GraphicsUnit.Pixel);
        }
      }
      catch(Exception){
        if(result!=null)result.Dispose();
        result=null;
      }
    }
    if(result==null){
      result=new Bitmap(size,size);
      using(Graphics g=Graphics.FromImage(result))using(Brush b=new SolidBrush(Color.White))using(StringFormat sf=new StringFormat{
        Alignment=StringAlignment.Center,LineAlignment=StringAlignment.Center
      }
      ){
        g.Clear(Color.Transparent);
        g.DrawString(glyph,ChatColors.Emoji(Math.Max(12,size*.68f)),b,new RectangleF(0,0,size,size),sf);
      }
    }
    cache[key]=result;
    return result;
  }
}
internal sealed class CaprichatEmojiViewport:Panel{
  private readonly CaprichatScrollBar bar=new CaprichatScrollBar();
  private readonly System.Windows.Forms.Timer animator;
  private readonly CaprichatAutoScroll autoScroll;
  private Control content;
  private int extent,target;
  internal int Offset{
    get{
      return bar.Value;
    }
  }
  internal event Action ScrollMoved;
  internal CaprichatEmojiViewport(){
    AutoScroll=false;
    DoubleBuffered=true;
    BackColor=ChatColors.Ground;
    Controls.Add(bar);
    bar.Changed+=delegate(int value){
      if(content!=null)content.Top=-value;
      if(!animator.Enabled)target=value;
      if(ScrollMoved!=null)ScrollMoved();
    }
    ;
    bar.WheelRequested+=SmoothWheel;
    autoScroll=new CaprichatAutoScroll(this,delegate(int pixels){
      animator.Stop();
      bar.ScrollBy(pixels);
      target=bar.Value;
    }
    );
    MouseDown+=autoScroll.MouseDown;
    bar.MouseDown+=autoScroll.MouseDown;
    animator=new System.Windows.Forms.Timer{
      Interval=MK002Settings.ScrollTickMilliseconds
    }
    ;
    animator.Tick+=delegate{
      int difference=target-bar.Value;
      if(Math.Abs(difference)<3){
        bar.Value=target;
        animator.Stop();
        return;
      }
      bar.Value+=Math.Sign(difference)*Math.Max(2,Math.Abs(difference)/MK002Settings.SmoothScrollDivisor);
    }
    ;
  }
  private void Wire(Control control){
    control.MouseDown+=autoScroll.MouseDown;
    control.MouseWheel+=delegate(object o,MouseEventArgs e){
      SmoothWheel(-e.Delta/120*MK002Settings.EmojiWheelScrollPixels);
    }
    ;
    control.ControlAdded+=delegate(object o,ControlEventArgs e){
      Wire(e.Control);
    }
    ;
    foreach(Control c in control.Controls)Wire(c);
  }
  internal void Attach(Control child){
    content=child;
    Controls.Add(child);
    bar.BringToFront();
    Wire(child);
  }
  internal void SetExtent(int height){
    extent=Math.Max(0,height);
    if(content!=null)content.SetBounds(0,-bar.Value,Math.Max(1,ClientSize.Width-18),Math.Max(1,extent));
    bar.SetBounds(ClientSize.Width-16,1,14,Math.Max(1,ClientSize.Height-2));
    bar.Metrics(extent,ClientSize.Height);
    bar.Visible=extent>ClientSize.Height;
    bar.BringToFront();
  }
  internal void SetPosition(int value){
    bar.Value=value;
    target=bar.Value;
  }
  internal void ResetScroll(){
    animator.Stop();
    SetPosition(0);
  }
  internal void SmoothWheel(int delta){
    autoScroll.Stop();
    if(!animator.Enabled)target=bar.Value;
    target=Math.Max(0,Math.Min(Math.Max(0,extent-ClientSize.Height),target+delta));
    if(!animator.Enabled)animator.Start();
  }
  protected override void OnSizeChanged(EventArgs e){
    base.OnSizeChanged(e);
    SetExtent(extent);
  }
  protected override void OnMouseWheel(MouseEventArgs e){
    SmoothWheel(-e.Delta/120*MK002Settings.EmojiWheelScrollPixels);
  }
  protected override void Dispose(bool disposing){
    if(disposing){
      autoScroll.Dispose();
      animator.Stop();
      animator.Dispose();
    }
    base.Dispose(disposing);
  }
}
internal sealed class CaprichatPicker:Form{
  [DllImport("user32.dll")]private static extern bool ReleaseCapture();
  [DllImport("user32.dll")]private static extern IntPtr SendMessage(IntPtr window,int msg,IntPtr wParam,IntPtr lParam);
  private readonly MK002Caprichat mod;
  private TextBox search;
  private ComboBox categories;
  private CaprichatEmojiViewport viewport;
  private Panel canvas;
  private Label counter;
  private CaprichatDivider recentTitle,allTitle;
  private readonly ToolTip tips=new ToolTip();
  private readonly List<Button>visible=new List<Button>();
  private List<CaprichatEmoji>found=new List<CaprichatEmoji>();
  private int columns,allTop,first=-1,last=-1;
  private int[]glyphTop=new int[0],glyphLeft=new int[0];
  private bool building;
  private const int Cell=54,ButtonSize=50;
  internal string Emoji;
  internal event Action<string>EmojiPicked;
  internal CaprichatPicker(MK002Caprichat owner,string purpose){
    mod=owner;
    CaprichatEmojiArt.RefreshPacks();
    Text="CAPRICHAT // "+purpose;
    Size=new Size(530,570);
    MinimumSize=new Size(490,450);
    FormBorderStyle=FormBorderStyle.None;
    StartPosition=FormStartPosition.CenterParent;
    BackColor=ChatColors.Ground;
    ForeColor=ChatColors.Cyan;
    Panel chrome=new Panel{
      Dock=DockStyle.Top,Height=38,BackColor=Color.FromArgb(35,12,21)
    }
    ;
    Label title=new Label{
      Text="CAPRICHAT // "+purpose,AutoSize=true,Left=14,Top=10,ForeColor=ChatColors.Rose,Font=ChatColors.Font(10,true)
    }
    ;
    Button close=ChatColors.Button("×",33);
    close.Dock=DockStyle.Right;
    close.FlatAppearance.BorderSize=0;
    close.Click+=delegate{
      DialogResult=DialogResult.Cancel;
      Close();
    }
    ;
    chrome.Controls.Add(title);
    chrome.Controls.Add(close);
    MouseEventHandler drag=delegate(object sender,MouseEventArgs e){
      if(e.Button==MouseButtons.Left){
        ReleaseCapture();
        SendMessage(Handle,0xA1,new IntPtr(2),IntPtr.Zero);
      }
    }
    ;
    title.MouseDown+=drag;
    chrome.MouseDown+=drag;
    TableLayoutPanel layout=new TableLayoutPanel{
      Dock=DockStyle.Fill,RowCount=4,ColumnCount=1,Padding=new Padding(10),BackColor=ChatColors.Ground
    }
    ;
    layout.ColumnStyles.Add(new ColumnStyle(SizeType.Percent,100));
    layout.RowStyles.Add(new RowStyle(SizeType.Absolute,36));
    layout.RowStyles.Add(new RowStyle(SizeType.Absolute,36));
    layout.RowStyles.Add(new RowStyle(SizeType.Percent,100));
    layout.RowStyles.Add(new RowStyle(SizeType.Absolute,26));
    search=new TextBox{
      Dock=DockStyle.Fill,BackColor=ChatColors.Field,ForeColor=ChatColors.Cyan,BorderStyle=BorderStyle.FixedSingle,Font=ChatColors.Font(10,false)
    }
    ;
    categories=new ComboBox{
      Dock=DockStyle.Fill,DropDownStyle=ComboBoxStyle.DropDownList,BackColor=ChatColors.Field,ForeColor=ChatColors.Cyan,FlatStyle=FlatStyle.Flat,Font=ChatColors.Font(10,false)
    }
    ;
    categories.Items.Add("All installed emojis");
    categories.Items.AddRange(CaprichatEmoji.Categories.Where(x=>CaprichatEmojiArt.HasPack(x)).Cast<object>().ToArray());
    categories.SelectedIndex=0;
    viewport=new CaprichatEmojiViewport{
      Dock=DockStyle.Fill
    }
    ;
    canvas=new CaprichatCanvas{
      BackColor=ChatColors.Ground,Left=0,Top=0
    }
    ;
    viewport.Attach(canvas);
    viewport.ScrollMoved+=delegate{
      ShowVisible();
    }
    ;
    counter=new Label{
      Dock=DockStyle.Fill,ForeColor=ChatColors.Faint,TextAlign=ContentAlignment.MiddleCenter,Font=ChatColors.Font(9,false)
    }
    ;
    layout.Controls.Add(search,0,0);
    layout.Controls.Add(categories,0,1);
    layout.Controls.Add(viewport,0,2);
    layout.Controls.Add(counter,0,3);
    Controls.Add(layout);
    Controls.Add(chrome);
    Controls.SetChildIndex(chrome,0);
    search.TextChanged+=delegate{
      Refill();
    }
    ;
    categories.SelectedIndexChanged+=delegate{
      Refill();
    }
    ;
    viewport.Resize+=delegate{
      BuildLayout();
    }
    ;
    viewport.MouseWheel+=delegate{
      if(!IsDisposed&&IsHandleCreated)BeginInvoke((Action)delegate{
        if(!IsDisposed)ShowVisible();
      }
      );
    }
    ;
    Shown+=delegate{
      BuildLayout();
    }
    ;
    Refill();
  }
  protected override void Dispose(bool disposing){
    if(disposing)tips.Dispose();
    base.Dispose(disposing);
  }
  private Button MakeButton(CaprichatEmoji item,int x,int y){
    Button b=ChatColors.Button("",ButtonSize);
    b.SetBounds(x,y,ButtonSize,ButtonSize);
    b.Margin=new Padding(0);
    b.FlatAppearance.BorderColor=ChatColors.Edge;
    b.Image=CaprichatEmojiArt.Get(item.Glyph,36);
    b.ImageAlign=ContentAlignment.MiddleCenter;
    b.Click+=delegate{
      Emoji=item.Glyph;
      if(EmojiPicked!=null)EmojiPicked(Emoji);
      Close();
    }
    ;
    b.MouseWheel+=delegate(object sender,MouseEventArgs e){
      viewport.SmoothWheel(-e.Delta/120*MK002Settings.EmojiWheelScrollPixels);
    }
    ;
    tips.SetToolTip(b,item.Name+"   :"+item.Alias+":");
    return b;
  }
  private void ClearControls(){
    Control[]old=canvas.Controls.Cast<Control>().ToArray();
    canvas.Controls.Clear();
    foreach(Control c in old)c.Dispose();
    visible.Clear();
    first=last=-1;
  }
  private void Refill(){
    if(categories==null||viewport==null)return;
    string cat=categories.SelectedItem as string??"All emojis",q=(search.Text??"").Trim().ToLowerInvariant().Replace('_',' ');
    IEnumerable<CaprichatEmoji>src=CaprichatEmoji.All;
    if(cat!="All installed emojis")src=src.Where(x=>x.Category==cat);
    src=src.Where(x=>CaprichatEmojiArt.HasArt(x));
    if(q.Length>0)src=src.Where(x=>x.Name.ToLowerInvariant().Contains(q)||x.Aliases.ToLowerInvariant().Contains(q)||x.Glyph.Contains(q));
    found=src.ToList();
    counter.Text=found.Count+" emojis   ·   scroll to browse";
    viewport.ResetScroll();
    BuildLayout();
  }
  private void BuildLayout(){
    if(building||viewport==null||viewport.ClientSize.Width<1)return;
    building=true;
    try{
      int oldScroll=viewport.Offset;
      int width=Math.Max(270,viewport.ClientSize.Width-20);
      columns=Math.Max(1,width/Cell);
      ClearControls();
      canvas.Width=width;
      int y=4;
      recentTitle=new CaprichatDivider("RECENT EMOJIS",MK002Settings.EmojiHeadingFontSize);
      recentTitle.SetBounds(4,y,width-8,24);
      canvas.Controls.Add(recentTitle);
      y+=26;
      List<CaprichatEmoji>recent=mod.Recent.Select(CaprichatEmoji.Find).Where(x=>x!=null&&CaprichatEmojiArt.HasArt(x)).Take(MK002Settings.RecentEmojiCount).ToList();
      foreach(CaprichatEmoji emoji in recent){
        int i=recent.IndexOf(emoji);
        canvas.Controls.Add(MakeButton(emoji,(i%columns)*Cell+2,y+(i/columns)*Cell));
      }
      y+=((recent.Count+columns-1)/columns)*Cell+7;
      Panel line=new Panel{
        BackColor=ChatColors.Edge
      }
      ;
      line.SetBounds(2,y,width-4,1);
      canvas.Controls.Add(line);
      y+=12;
      allTitle=new CaprichatDivider("ALL EMOJIS"+(categories.SelectedIndex>0?" / "+categories.SelectedItem:""),MK002Settings.EmojiHeadingFontSize);
      allTitle.SetBounds(4,y,width-8,23);
      canvas.Controls.Add(allTitle);
      allTop=y+25;
      glyphTop=new int[found.Count];
      glyphLeft=new int[found.Count];
      int nextY=allTop,col=0;
      string group=null;
      for(int i=0;
      i<found.Count;
      i++){
        string current=found[i].Category;
        if(categories.SelectedIndex==0&&group!=current){
          if(col>0){
            nextY+=Cell;
            col=0;
          }
          CaprichatDivider heading=new CaprichatDivider(current.ToUpperInvariant(),MK002Settings.EmojiHeadingFontSize);
          heading.SetBounds(4,nextY+4,width-8,23);
          canvas.Controls.Add(heading);
          nextY+=29;
          group=current;
        }
        glyphTop[i]=nextY;
        glyphLeft[i]=col*Cell+2;
        col++;
        if(col>=columns){
          col=0;
          nextY+=Cell;
        }
      }
      canvas.Height=Math.Max(viewport.ClientSize.Height,nextY+(col>0?Cell:0)+12);
      viewport.SetExtent(canvas.Height);
      viewport.SetPosition(Math.Min(oldScroll,Math.Max(0,canvas.Height-viewport.ClientSize.Height)));
      ShowVisible();
    }
    finally{
      building=false;
    }
  }
  private void ShowVisible(){
    if(viewport==null||canvas==null||columns<1)return;
    int offset=viewport.Offset;
    int lo=0,hi=found.Count;
    while(lo<found.Count&&glyphTop[lo]+Cell<offset-3*Cell)lo++;
    hi=lo;
    while(hi<found.Count&&glyphTop[hi]<offset+viewport.ClientSize.Height+3*Cell)hi++;
    if(lo==first&&hi==last)return;
    first=lo;
    last=hi;
    canvas.SuspendLayout();
    foreach(Button b in visible.ToArray()){
      int index=(int)b.Tag;
      if(index>=lo&&index<hi)continue;
      canvas.Controls.Remove(b);
      visible.Remove(b);
      b.Dispose();
    }
    HashSet<int>present=new HashSet<int>(visible.Select(x=>(int)x.Tag));
    for(int i=lo;
    i<hi;
    i++){
      if(present.Contains(i))continue;
      Button b=MakeButton(found[i],glyphLeft[i],glyphTop[i]);
      b.Tag=i;
      visible.Add(b);
      canvas.Controls.Add(b);
    }
    canvas.ResumeLayout(false);
  }
}
internal sealed class CaprichatComplete{
  private readonly CaprichatWindow window;
  private readonly RichTextBox input;
  private readonly MK002Caprichat mod;
  private readonly ListBox suggestions;
  private CaprichatEmoji[]matches=new CaprichatEmoji[0];
  private int begin=-1;
  private bool replacing;
  internal CaprichatComplete(CaprichatWindow owner,RichTextBox editor,MK002Caprichat state){
    window=owner;
    input=editor;
    mod=state;
    suggestions=new ListBox{
      Visible=false,BorderStyle=BorderStyle.FixedSingle,DrawMode=DrawMode.OwnerDrawFixed,BackColor=ChatColors.Field,ForeColor=ChatColors.Cyan,Font=ChatColors.Font(10,false),IntegralHeight=false,ItemHeight=37,TabStop=false
    }
    ;
    suggestions.DrawItem+=delegate(object sender,DrawItemEventArgs e){
      if(e.Index<0||e.Index>=matches.Length)return;
      bool selected=(e.State&DrawItemState.Selected)!=0;
      using(Brush background=new SolidBrush(selected?ChatColors.Well:ChatColors.Field))e.Graphics.FillRectangle(background,e.Bounds);
      using(Brush b=new SolidBrush(ChatColors.White))e.Graphics.DrawString(matches[e.Index].Glyph,ChatColors.Emoji(18),b,new RectangleF(e.Bounds.X+5,e.Bounds.Y+5,28,28));
      string caption=":"+matches[e.Index].Alias+":   "+matches[e.Index].Name;
      TextRenderer.DrawText(e.Graphics,caption,suggestions.Font,new Rectangle(e.Bounds.X+40,e.Bounds.Y+2,e.Bounds.Width-42,e.Bounds.Height-2),ChatColors.Cyan,TextFormatFlags.VerticalCenter|TextFormatFlags.EndEllipsis|TextFormatFlags.NoPrefix);
    }
    ;
    window.Controls.Add(suggestions);
    suggestions.BringToFront();
    suggestions.MouseDown+=delegate(object sender,MouseEventArgs e){
      int i=suggestions.IndexFromPoint(e.Location);
      if(i>=0){
        suggestions.SelectedIndex=i;
        Commit();
      }
    }
    ;
    input.LostFocus+=delegate{
      if(!suggestions.Focused)Hide();
    }
    ;
  }
  internal void Changed(){
    if(replacing)return;
    int caret=input.SelectionStart;
    if(caret<0||caret>input.TextLength){
      Hide();
      return;
    }
    string before=input.Text.Substring(0,caret);
    Match closed=Regex.Match(before,@"(?<![a-zA-Z0-9_]):([a-zA-Z0-9_+\-]+):$");
    if(closed.Success){
      CaprichatEmoji match=CaprichatEmoji.Resolve(":"+closed.Groups[1].Value+":");
      if(match!=null){
        int from=closed.Index+closed.Value.IndexOf(':');
        replacing=true;
        try{
          input.Select(from,caret-from);
          InsertChosen(match.Glyph);
          mod.RememberEmoji(match.Glyph);
        }
        finally{
          replacing=false;
          Hide();
        }
        return;
      }
    }
    Match token=Regex.Match(before,@"(?<![a-zA-Z0-9_]):([a-zA-Z0-9_+\-]*)$");
    if(!token.Success){
      Hide();
      return;
    }
    begin=token.Index+token.Value.IndexOf(':');
    string query=token.Groups[1].Value;
    matches=CaprichatEmoji.Suggest(query,mod.Recent,6).ToArray();
    if(matches.Length==0){
      Hide();
      return;
    }
    PositionPopup();
  }
  private void PositionPopup(){
    suggestions.BeginUpdate();
    suggestions.Items.Clear();
    foreach(CaprichatEmoji x in matches)suggestions.Items.Add(x.Glyph+"   :"+x.Alias+":   "+x.Name);
    suggestions.SelectedIndex=0;
    suggestions.EndUpdate();
    suggestions.Size=new Size(Math.Min(350,Math.Max(220,input.Width)),matches.Length*37+4);
    Point caret=input.GetPositionFromCharIndex(input.SelectionStart);
    Point at=window.PointToClient(input.PointToScreen(new Point(caret.X,caret.Y+input.Font.Height+4)));
    suggestions.Location=new Point(Math.Max(8,Math.Min(window.ClientSize.Width-suggestions.Width-8,at.X)),Math.Max(50,Math.Min(window.ClientSize.Height-suggestions.Height-12,at.Y)));
    suggestions.Visible=true;
    suggestions.BringToFront();
  }
  internal bool AcceptTab(){
    if(!suggestions.Visible||matches.Length==0)return false;
    Commit();
    return true;
  }
  internal bool AcceptKey(KeyEventArgs e){
    if(!suggestions.Visible||matches.Length==0||e.Control||e.Alt)return false;
    if(e.KeyCode==Keys.Down){
      suggestions.SelectedIndex=(suggestions.SelectedIndex+1)%matches.Length;
    }
    else if(e.KeyCode==Keys.Up){
      suggestions.SelectedIndex=(suggestions.SelectedIndex+matches.Length-1)%matches.Length;
    }
    else if(e.KeyCode==Keys.Enter||e.KeyCode==Keys.Tab){
      Commit();
    }
    else if(e.KeyCode==Keys.Escape){
      Hide();
    }
    else return false;
    e.Handled=true;
    e.SuppressKeyPress=true;
    return true;
  }
  private void Commit(){
    if(begin<0||suggestions.SelectedIndex<0||suggestions.SelectedIndex>=matches.Length)return;
    CaprichatEmoji item=matches[suggestions.SelectedIndex];
    int caret=input.SelectionStart;
    replacing=true;
    try{
      input.Select(begin,Math.Max(0,caret-begin));
      InsertChosen(item.Glyph);
      mod.RememberEmoji(item.Glyph);
      input.Focus();
    }
    finally{
      replacing=false;
      Hide();
    }
  }
  private void InsertChosen(string glyph){
    CaprichatInput editor=input as CaprichatInput;
    if(editor!=null)editor.InsertEmoji(glyph);
    else input.SelectedText=glyph;
  }
  internal void Hide(){
    suggestions.Visible=false;
    begin=-1;
  }
}
internal sealed class CaprichatEmoji{
  internal readonly string Glyph,Name,Aliases,Category;
  internal string Alias{
    get{
      return Aliases.Split(new[]{
        ' '
      }
      ,StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()??Name.Replace(' ','_');
    }
  }
  internal CaprichatEmoji(string glyph,string name,string aliases,string cat){
    Glyph=glyph;
    Name=name;
    Aliases=aliases;
    Category=cat;
  }
  internal static readonly string[]Categories={
    "Smileys & Emotion","People & Body","Animals & Nature","Food & Drink","Travel & Places","Activities","Objects","Symbols","Flags","Component"
  }
  ;
  private static CaprichatEmoji[]catalog;
  internal static CaprichatEmoji[]All{
    get{
      if(catalog==null){
        List<CaprichatEmoji>found=new List<CaprichatEmoji>();
        foreach(string raw in EmojiCatalog().Split(new[]{
          '\n'
        }
        ,StringSplitOptions.RemoveEmptyEntries)){
          string[]c=raw.TrimEnd('\r').Split('|');
          int kind;
          if(c.Length<4||!int.TryParse(c[3],out kind)||kind<0||kind>=Categories.Length)continue;
          found.Add(new CaprichatEmoji(c[0],c[1],c[2],Categories[kind]));
        }
        catalog=found.ToArray();
      }
      return catalog;
    }
  }
  private static string plainCatalog;
  private static string EmojiCatalog(){
    if(plainCatalog!=null)return plainCatalog;
    using(MemoryStream encoded=new MemoryStream(Convert.FromBase64String(EmojiCatalogPacked)))using(DeflateStream zip=new DeflateStream(encoded,CompressionMode.Decompress))using(StreamReader reader=new StreamReader(zip,Encoding.UTF8))plainCatalog=reader.ReadToEnd();
    return plainCatalog;
  }
  private const string EmojiCatalogPacked="";
  internal static CaprichatEmoji Find(string glyph){
    return All.FirstOrDefault(x=>x.Glyph==glyph||x.Glyph.Replace("\ufe0f","")==((glyph??"").Replace("\ufe0f","")));
  }
  internal static CaprichatEmoji Resolve(string value){
    if(string.IsNullOrWhiteSpace(value))return null;
    string token=value.Trim().Trim(':');
    string v=token.Replace('_',' ').Replace('-',' ').Trim();
    if(v.Equals("thumbs down",StringComparison.OrdinalIgnoreCase)||v.Equals("thumbsdown",StringComparison.OrdinalIgnoreCase)||token=="-1")return Find("👎");
    if(v.Equals("thumbs up",StringComparison.OrdinalIgnoreCase)||v.Equals("thumbsup",StringComparison.OrdinalIgnoreCase)||token=="+1")return Find("👍");
    if(v.Equals("laughing cry",StringComparison.OrdinalIgnoreCase))return Find("😂");
    CaprichatEmoji match=Find(value.Trim());
    if(match!=null)return match;
    return All.FirstOrDefault(x=>x.Name.Equals(v,StringComparison.OrdinalIgnoreCase)||x.Name.StartsWith(v+" ",StringComparison.OrdinalIgnoreCase)||x.Aliases.Split(new[]{
      ' '
    }
    ,StringSplitOptions.RemoveEmptyEntries).Any(a=>a.Equals(token,StringComparison.OrdinalIgnoreCase)));
  }
  internal static string ModelAlias(string glyph){
    CaprichatEmoji item=Find(glyph);
    if(item==null)return glyph;
    if(item.Glyph=="😂")return":laughing_cry:";
    if(item.Glyph.StartsWith("👎",StringComparison.Ordinal))return":thumbs_down:";
    if(item.Glyph.StartsWith("👍",StringComparison.Ordinal))return":thumbs_up:";
    string alias=item.Aliases.Split(new[]{
      ' '
    }
    ,StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
    if(string.IsNullOrEmpty(alias))alias=item.Name.Replace(' ','_').Replace('-','_');
    return":"+alias+":";
  }
  internal static bool ContainsEmoji(string raw){
    if(string.IsNullOrEmpty(raw))return false;
    if(raw.Any(char.IsSurrogate))return true;
    return All.Any(x=>x.Glyph.Length>0&&x.Glyph.Length<=2&&raw.Contains(x.Glyph));
  }
  internal static string FromModelText(string raw){
    return Regex.Replace(raw??"",@":([a-zA-Z0-9_+\-]+):",delegate(Match m){
      CaprichatEmoji emoji=Resolve(m.Value);
      return emoji==null?m.Value:emoji.Glyph;
    }
    );
  }
  internal static string ToModelText(string raw){
    if(string.IsNullOrEmpty(raw)||!raw.Any(c=>char.IsSurrogate(c)||c=='\ufe0f'||c=='\u20e3'||c>='\u2300'&&c<='\u3299'))return raw??"";
    string result=raw;
    foreach(CaprichatEmoji item in All.OrderByDescending(x=>x.Glyph.Length))if(result.Contains(item.Glyph))result=result.Replace(item.Glyph,ModelAlias(item.Glyph));
    return result;
  }
  internal static IEnumerable<CaprichatEmoji>Suggest(string query,List<string>recents,int limit){
    string q=(query??"").Replace('_',' ').ToLowerInvariant();
    if(q.Length==0){
      HashSet<string>used=new HashSet<string>();
      int shown=0;
      foreach(string recent in recents){
        CaprichatEmoji x=Find(recent);
        if(x!=null&&used.Add(x.Glyph)){
          yield return x;
          if(++shown==limit)yield break;
        }
      }
      foreach(CaprichatEmoji x in All){
        if(used.Add(x.Glyph)){
          yield return x;
          if(++shown==limit)yield break;
        }
      }
      yield break;
    }
    foreach(CaprichatEmoji x in All.Select(x=>new{
      E=x,S=(x.Name.ToLowerInvariant().StartsWith(q)?0:x.Aliases.ToLowerInvariant().Split(' ').Any(y=>y.StartsWith(q))?1:x.Name.ToLowerInvariant().Contains(q)||x.Aliases.ToLowerInvariant().Contains(q)?2:9)
    }
    ).Where(x=>x.S<9).OrderBy(x=>recents.IndexOf(x.E.Glyph)>=0?0:1).ThenBy(x=>x.S).ThenBy(x=>recents.IndexOf(x.E.Glyph)>=0?recents.IndexOf(x.E.Glyph):100000).ThenBy(x=>x.E.Name).Take(limit).Select(x=>x.E))yield return x;
  }
}
