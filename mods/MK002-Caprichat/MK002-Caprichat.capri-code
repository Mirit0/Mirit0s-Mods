public sealed class MK002Caprichat:ICapriMod{
  internal ICapriHost Host;
  internal Control Owner;
  internal object Brain;
  internal CaprichatWindow Window;
  internal string Folder;
  internal float FontSize=MK002Settings.MessageFontSize;
  internal bool HideObservations=MK002Settings.HideObservationsByDefault;
  internal bool HideJobs=MK002Settings.HideJobsByDefault;
  internal void SetNoticeVisibility(bool observations,bool jobs){
    HideObservations=observations;
    HideJobs=jobs;
    try{
      File.WriteAllLines(Path.Combine(Folder,"notice-visibility.txt"),new[]{
        observations.ToString(),jobs.ToString()
      }
      );
    }
    catch(IOException){
    }
    catch(UnauthorizedAccessException){
    }
    if(Window!=null&&!Window.IsDisposed)Window.RefreshChat();
  }
  internal readonly List<CaprichatMessage>Messages=new List<CaprichatMessage>();
  internal readonly Dictionary<string,List<CaprichatReaction>>Reactions=new Dictionary<string,List<CaprichatReaction>>();
  internal readonly List<string>Recent=new List<string>();
  private readonly List<CaprichatMessage>speechQueue=new List<CaprichatMessage>();
  internal readonly Dictionary<string,int>Stars=new Dictionary<string,int>();
  private readonly List<string>promptIds=new List<string>();
  private int promptsSinceReview;
  private readonly Dictionary<string,DateTime>checks=new Dictionary<string,DateTime>();
  private readonly Dictionary<string,long>transcriptLengths=new Dictionary<string,long>();
  private readonly HashSet<string>seenTranscript=new HashSet<string>();
  private System.Windows.Forms.Timer timer;
  private System.Windows.Forms.Timer modSuggestionTimer;
  private int reactionBusy;
  private readonly object reactionGate=new object();
  private string lastCapriReaction="";
  private readonly List<string>recentCapriReactions=new List<string>();
  private readonly Queue<Tuple<CaprichatMessage,string,string>>reactionQueue=new Queue<Tuple<CaprichatMessage,string,string>>();
  private volatile bool stopped;
  private bool bootstrapping;
  private string status="LOCAL ARCHIVE · CONNECTED";
  private readonly Random random=new Random();
  private readonly object saving=new object();
  private readonly BindingFlags flags=BindingFlags.Instance|BindingFlags.Public|BindingFlags.NonPublic;
  private volatile bool stateLoading,transcriptLoading;
  internal bool ArchiveIsLoading{
    get{
      return stateLoading||transcriptLoading;
    }
  }
  internal int LoadedArchiveMessages,TotalArchiveMessages=1;
  private DateTime lastArchiveSurveyUtc=DateTime.MinValue;
  public void Start(ICapriHost capri){
    Host=capri;
    Folder=capri.Folder;
    stopped=false;
    FontSize=MK002Settings.MessageFontSize;
    HideObservations=MK002Settings.HideObservationsByDefault;
    HideJobs=MK002Settings.HideJobsByDefault;
    try{
      string p=Path.Combine(Folder,"notice-visibility.txt");
      if(File.Exists(p)){
        string[]lines=File.ReadAllLines(p);
        bool on;
        if(lines.Length>0&&bool.TryParse(lines[0],out on))HideObservations=on;
        if(lines.Length>1&&bool.TryParse(lines[1],out on))HideJobs=on;
      }
    }
    catch(IOException){
    }
    catch(UnauthorizedAccessException){
    }
    try{
      string marker=Path.Combine(Folder,"notice-defaults-206.txt");
      if(!File.Exists(marker)){
        HideObservations=true;
        HideJobs=true;
        File.WriteAllLines(Path.Combine(Folder,"notice-visibility.txt"),new[]{
          "True","True"
        }
        );
        File.WriteAllText(marker,"1");
      }
    }
    catch(IOException){
    }
    catch(UnauthorizedAccessException){
    }
    try{
      string p=Path.Combine(Folder,"chat-font-size.txt");
      float v;
      if(File.Exists(p)&&float.TryParse(File.ReadAllText(p),NumberStyles.Float,CultureInfo.InvariantCulture,out v))FontSize=Math.Max(6f,Math.Min(30f,v));
    }
    catch(Exception){
    }
    Messages.Clear();
    nativeReplyKeys.Clear();
    Reactions.Clear();
    Recent.Clear();
    Stars.Clear();
    speechQueue.Clear();
    lastCapriReaction="";
    recentCapriReactions.Clear();
    promptIds.Clear();
    promptsSinceReview=0;
    checks.Clear();
    transcriptLengths.Clear();
    seenTranscript.Clear();
    lastHistory="";
    recentReplyPrompts.Clear();
    try{
      string choice=Path.Combine(Folder,"chat-font.txt");
      string stored=File.Exists(choice)?File.ReadAllText(choice).Trim():MK002Settings.FontFilePath;
      ChatColors.SelectFont(stored);
    }
    catch(Exception){
      ChatColors.SelectFont(MK002Settings.FontFilePath);
    }
    lock(reactionGate){
      reactionQueue.Clear();
      reactionBusy=0;
    }
    FieldInfo field=capri.GetType().GetField("capri",flags);
    Owner=field==null?null:field.GetValue(capri)as Control;
    if(Owner==null)throw new InvalidOperationException("Capri host missing.");
    field=Owner.GetType().GetField("brain",flags);
    Brain=field==null?null:field.GetValue(Owner);
    stateLoading=true;
    transcriptLoading=true;
    timer=new System.Windows.Forms.Timer{
      Interval=2200
    }
    ;
    timer.Tick+=delegate{
      if(stopped)return;
      try{
        if(!stateLoading)CheckHistory(false);
        if(!transcriptLoading)CheckTranscripts(false);
        PollSpeech();
      }
      catch(Exception error){
        SafeLog("Sync: "+error.Message);
      }
    }
    ;
    timer.Start();
    OfferOptionalModAfterStartup();
    ThreadPool.QueueUserWorkItem(delegate{
      BootstrapArchive();
    }
    );
    capri.Log("MK002 v2.1.14 loaded.");
  }
  private bool DispatchArchive(Action action){
    if(stopped||Owner==null)return false;
    for(int i=0;
    i<600&&!stopped&&!Owner.IsDisposed&&!Owner.IsHandleCreated;
    i++)Thread.Sleep(100);
    if(stopped||Owner.IsDisposed||!Owner.IsHandleCreated)return false;
    using(ManualResetEvent done=new ManualResetEvent(false)){
      try{
        Owner.BeginInvoke((Action)delegate{
          try{
            if(!stopped)action();
          }
          catch(Exception e){
            SafeLog("Archive UI: "+e.Message);
          }
          finally{
            try{
              done.Set();
            }
            catch(ObjectDisposedException){
            }
          }
        }
        );
        while(!done.WaitOne(100)){
          if(stopped)return false;
        }
      }
      catch(Exception e){
        SafeLog("Archive dispatch: "+e.Message);
        return false;
      }
    }
    return!stopped;
  }
  private void ArchiveProgress(int done,int total){
    LoadedArchiveMessages=Math.Max(0,done);
    TotalArchiveMessages=Math.Max(1,total);
    if(Window!=null&&!Window.IsDisposed)Window.SetArchiveProgress(LoadedArchiveMessages,TotalArchiveMessages,transcriptLoading);
  }
  private void BootstrapArchive(){
    try{
      MK002Caprichat staging=new MK002Caprichat{
        Folder=Folder
      }
      ;
      staging.bootstrapping=true;
      staging.LoadState();
      string root=Path.Combine(Path.GetDirectoryName(Path.GetDirectoryName(Folder)),"transcripts");
      string[]files=Directory.Exists(root)?Directory.GetFiles(root,"????-??-??.md").OrderByDescending(x=>x).ToArray():new string[0];
      if(MK002Settings.StartupTranscriptDateLimit>0)files=files.Take(MK002Settings.StartupTranscriptDateLimit).ToArray();
      MK002Caprichat dayStage=new MK002Caprichat{
        Folder=Folder
      }
      ;
      dayStage.bootstrapping=true;
      if(files.Length>0)dayStage.CheckTranscriptFile(files[0],true);
      CaprichatMessage[]saved=staging.Messages.ToArray();
      CaprichatMessage[]firstDay=dayStage.Messages.ToArray();
      int total=saved.Length+firstDay.Length;
      foreach(string file in files.Skip(1))try{
        total+=File.ReadLines(file).Count(line=>line.StartsWith("**")||line.StartsWith("*"));
      }
      catch(IOException){
      }
      catch(UnauthorizedAccessException){
      }
      HashSet<string>initialIds=new HashSet<string>();
      CaprichatMessage[]initial=saved.Concat(firstDay).OrderByDescending(m=>m.At).Where(m=>initialIds.Add(m.Id)).Take(Math.Max(1,MK002Settings.StartupRecentMessages)).ToArray();
      int applied=initial.Length;
      int totalCount=Math.Max(applied,total);
      TotalArchiveMessages=totalCount;
      LoadedArchiveMessages=0;
      if(!DispatchArchive(delegate{
        foreach(KeyValuePair<string,List<CaprichatReaction>>pair in staging.Reactions)if(!Reactions.ContainsKey(pair.Key))Reactions[pair.Key]=pair.Value;
        foreach(KeyValuePair<string,int>pair in staging.Stars){
          int old;
          Stars.TryGetValue(pair.Key,out old);
          Stars[pair.Key]=old|pair.Value;
        }
        foreach(string em in staging.Recent)if(!Recent.Contains(em))Recent.Add(em);
        foreach(string em in staging.recentCapriReactions)if(!recentCapriReactions.Contains(em))recentCapriReactions.Add(em);
        if(recentCapriReactions.Count>0)lastCapriReaction=recentCapriReactions[0];
        promptsSinceReview=Math.Max(promptsSinceReview,staging.promptsSinceReview);
        foreach(string id in staging.promptIds)if(!promptIds.Contains(id))promptIds.Add(id);
        CaprichatEmojiArt.SetFolder(Folder);
        bootstrapping=true;
        foreach(CaprichatMessage m in saved)if(!m.User&&m.Source.StartsWith("caprichat-",StringComparison.Ordinal))nativeReplyKeys.Add(NativeReplyKey(m));
        try{
          foreach(CaprichatMessage m in initial.OrderBy(x=>x.At)){
            if(m.Source=="transcript")seenTranscript.Add(m.Id);
            Add(m);
          }
          CheckHistory(true);
        }
        finally{
          bootstrapping=false;
        }
        stateLoading=false;
        ArchiveProgress(applied,totalCount);
        Updated();
      }
      ))return;
      if(!ImportArchiveBatch(saved.Where(m=>!initialIds.Contains(m.Id)).OrderByDescending(m=>m.At).ToArray(),ref applied,totalCount,false))return;
      if(files.Length>0){
        if(!ImportArchiveBatch(firstDay.Where(m=>!initialIds.Contains(m.Id)).Reverse().ToArray(),ref applied,totalCount,true))return;
        DateTime stamp;
        long length;
        dayStage.checks.TryGetValue(files[0],out stamp);
        dayStage.transcriptLengths.TryGetValue(files[0],out length);
        if(!DispatchArchive(delegate{
          checks[files[0]]=stamp;
          transcriptLengths[files[0]]=length;
        }
        ))return;
      }
      for(int f=1;
      f<files.Length&&!stopped;
      f++){
        dayStage.Messages.Clear();
        dayStage.CheckTranscriptFile(files[f],true);
        if(!ImportArchiveBatch(dayStage.Messages.AsEnumerable().Reverse().ToArray(),ref applied,totalCount,true))return;
        DateTime stamp;
        long length;
        dayStage.checks.TryGetValue(files[f],out stamp);
        dayStage.transcriptLengths.TryGetValue(files[f],out length);
        string name=files[f];
        if(!DispatchArchive(delegate{
          checks[name]=stamp;
          transcriptLengths[name]=length;
        }
        ))return;
      }
    }
    catch(Exception e){
      SafeLog("Archive loading: "+e.Message);
    }
    finally{
      DispatchArchive(delegate{
        stateLoading=false;
        transcriptLoading=false;
        ArchiveProgress(TotalArchiveMessages,TotalArchiveMessages);
        Updated();
      }
      );
    }
  }
  private bool ImportArchiveBatch(CaprichatMessage[]items,ref int applied,int total,bool transcript){
    int size=Math.Max(1,MK002Settings.StartupTranscriptBatchMessages);
    for(int i=0;
    i<items.Length;
    i+=size){
      if(stopped)return false;
      CaprichatMessage[]batch=items.Skip(i).Take(size).ToArray();
      applied+=batch.Length;
      int done=applied;
      bool redraw=i==0||i+batch.Length>=items.Length||(i+batch.Length)%200==0;
      if(!DispatchArchive(delegate{
        bootstrapping=true;
        try{
          foreach(CaprichatMessage msg in batch){
            if(transcript)seenTranscript.Add(msg.Id);
            Add(msg);
          }
        }
        finally{
          bootstrapping=false;
        }
        ArchiveProgress(done,total);
        if(redraw)Updated();
      }
      ))return false;
      Thread.Sleep(20);
    }
    return true;
  }
  private void ImportAdditionalDates(string[]files){
    try{
      MK002Caprichat stage=new MK002Caprichat{
        Folder=Folder
      }
      ;
      stage.bootstrapping=true;
      int applied=0,total=0;
      foreach(string file in files)try{
        total+=File.ReadLines(file).Count(line=>line.StartsWith("**")||line.StartsWith("*"));
      }
      catch(IOException){
      }
      catch(UnauthorizedAccessException){
      }
      foreach(string file in files){
        if(stopped)return;
        stage.Messages.Clear();
        stage.CheckTranscriptFile(file,true);
        if(!ImportArchiveBatch(stage.Messages.AsEnumerable().Reverse().ToArray(),ref applied,Math.Max(1,total),true))return;
        DateTime stamp;
        long length;
        stage.checks.TryGetValue(file,out stamp);
        stage.transcriptLengths.TryGetValue(file,out length);
        if(!DispatchArchive(delegate{
          checks[file]=stamp;
          transcriptLengths[file]=length;
        }
        ))return;
      }
    }
    catch(Exception e){
      SafeLog("Historical import: "+e.Message);
    }
    finally{
      DispatchArchive(delegate{
        transcriptLoading=false;
        ArchiveProgress(TotalArchiveMessages,TotalArchiveMessages);
        Updated();
      }
      );
    }
  }
  public bool Heard(string words){
    if(stopped||!WantsOpen(words))return false;
    OnUI(delegate{
      Open();
    }
    );
    ThreadPool.QueueUserWorkItem(delegate{
      string said=AskCapri("The user opened Caprichat. Reply naturally in character.","Their request: "+(words??""),100);
      if(stopped||string.IsNullOrWhiteSpace(said))return;
      OnUI(delegate{
        SpeakThenShow(said,"caprichat-opening");
      }
      );
    }
    );
    return true;
  }
  internal static bool WantsOpen(string input){
    if((input??"").StartsWith("Caprichat private chat reply.",StringComparison.Ordinal))return false;
    string s=Regex.Replace((input??"").ToLowerInvariant().Replace('’','\''),@"[^a-z0-9]+"," ").Trim();
    if(s=="caprichat"||s=="capri chat"||s=="our chat"||s=="your dm"||s=="our dms")return true;
    if(Regex.IsMatch(s,@"\b(don t|do not|never|stop|without|close|shut|why|how|what is|explain)\b"))return false;
    bool target=Regex.IsMatch(s,@"\b(caprichat|capri chat|our chat|your chat|my chat|our dms?|your dms?|my dms?|direct messages|our messages|your messages|the chat window|message window|our conversation|our texts|our inbox)\b");
    bool action=Regex.IsMatch(s,@"\b(open|show|launch|display|bring|pull|pop|start|view|see|switch|go|take|let|want|access|get|enter)\b");
    if(target&&action)return true;
    return Regex.IsMatch(s,@"^(?:hey |yo |capri |please |can we |could we |wanna |i want to )*(?:dm|chat|text) (?:me|with me|together|on caprichat)(?: please)?$");
  }
