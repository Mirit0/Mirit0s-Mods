      int x,y,w,h;
      if(bounds.Length==4&&int.TryParse(bounds[0],out x)&&int.TryParse(bounds[1],out y)&&int.TryParse(bounds[2],out w)&&int.TryParse(bounds[3],out h)&&w>=480&&h>=420){
        Rectangle place=new Rectangle(x,y,w,h);
        if(Screen.AllScreens.Any(s=>s.WorkingArea.IntersectsWith(place))){
          StartPosition=FormStartPosition.Manual;
          Bounds=place;
        }
      }
    }
