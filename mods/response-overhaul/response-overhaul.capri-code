    [DllImport("user32.dll",EntryPoint="ClipCursor")] private static extern bool ClipCursorRect(ref RectangleNative bounds);
    [DllImport("user32.dll",EntryPoint="ClipCursor")] private static extern bool ReleaseCursorClip(IntPtr unused);
    [DllImport("user32.dll")] private static extern short GetAsyncKeyState(int code);
    [DllImport("user32.dll",CharSet=CharSet.Unicode)] private static extern IntPtr FindWindow(string cls,string title);
    [DllImport("user32.dll",CharSet=CharSet.Unicode)] private static extern IntPtr FindWindowEx(IntPtr parent,IntPtr after,string cls,string title);
    [DllImport("user32.dll")] private static extern uint GetWindowThreadProcessId(IntPtr hwnd,out uint pid);
    [DllImport("user32.dll",SetLastError=true)] private static extern IntPtr SendMessageTimeout(IntPtr hwnd,uint msg,IntPtr w,IntPtr l,uint flags,uint timeout,out IntPtr result);
    [DllImport("user32.dll")] private static extern bool ShowWindow(IntPtr window,int command);
    [DllImport("user32.dll")] private static extern bool IsWindowVisible(IntPtr window);
    [DllImport("user32.dll")] private static extern bool IsIconic(IntPtr window);
    [DllImport("user32.dll")] private static extern IntPtr GetWindow(IntPtr hwnd,uint command);
    [DllImport("user32.dll")] private static extern bool GetWindowRect(IntPtr hwnd,out RectangleNative rect);
    [DllImport("user32.dll")] private static extern bool EnumWindows(EnumWindowsProc callback,IntPtr data);
    [DllImport("user32.dll")] private static extern int GetWindowTextLength(IntPtr hwnd);
    [DllImport("user32.dll",CharSet=CharSet.Unicode)] private static extern int GetClassName(IntPtr hwnd,StringBuilder buffer,int max);
    [DllImport("kernel32.dll",SetLastError=true)] private static extern IntPtr OpenProcess(uint access,bool inherited,uint pid);
    [DllImport("kernel32.dll",SetLastError=true)] private static extern bool CloseHandle(IntPtr process);
    [DllImport("kernel32.dll",SetLastError=true)] private static extern IntPtr VirtualAllocEx(IntPtr process,IntPtr address,uint bytes,uint alloc,uint protect);
    [DllImport("kernel32.dll",SetLastError=true)] private static extern bool VirtualFreeEx(IntPtr process,IntPtr address,uint bytes,uint release);
    [DllImport("kernel32.dll",SetLastError=true)] private static extern bool ReadProcessMemory(IntPtr process,IntPtr address,byte[] buffer,int size,out IntPtr count);
    private delegate bool EnumWindowsProc(IntPtr window,IntPtr data);

    public bool RetaliationBusy()
    { return armedRetaliation!=0 || iconStage!=null || cursorFrozenUntil!=DateTime.MinValue; }
    public void ArmRetaliation(string line,bool cursor,bool icons)
    {
        allowCursorPrank=cursor;allowIconPrank=icons;
        if(RetaliationBusy())return;
        if(cursor && string.Equals(line,"Next time, I'll freeze your cursor.",StringComparison.Ordinal))armedRetaliation=1;
        else if(icons && string.Equals(line,"Next time, I'll shuffle your desktop icons.",StringComparison.Ordinal))armedRetaliation=2;
    }
    public bool RetaliationOnReach()
    {
        if(armedRetaliation==0)return false;
        int next=armedRetaliation;armedRetaliation=0;
        if(next==1 && allowCursorPrank)FreezeCursorForFiveSeconds();
        else if(next==2 && allowIconPrank)StartIconShuffle();
        return true;
    }
    private void FreezeCursorForFiveSeconds()
    {
        if(RetaliationBusy())return;
        Point at=Cursor.Position;
        RectangleNative rect=new RectangleNative {Left=at.X,Top=at.Y,Right=at.X+1,Bottom=at.Y+1};
        if(ClipCursorRect(ref rect))cursorFrozenUntil=DateTime.UtcNow.AddSeconds(5);
    }
    private void CheckTemporaryDesktopActions(DateTime now)
    {
        if(cursorFrozenUntil!=DateTime.MinValue && (now>=cursorFrozenUntil || (GetAsyncKeyState(0x1B)&0x8000)!=0))
        {ReleaseCursorClip(IntPtr.Zero);cursorFrozenUntil=DateTime.MinValue;}
        if(iconRestoreAt!=DateTime.MinValue && (now>=iconRestoreAt || (GetAsyncKeyState(0x1B)&0x8000)!=0))
            RestoreIconShuffle();
    }
    private void RestoreTemporaryDesktopActions()
    {
        armedRetaliation=0;
        if(cursorFrozenUntil!=DateTime.MinValue){ReleaseCursorClip(IntPtr.Zero);cursorFrozenUntil=DateTime.MinValue;}
        RestoreIconShuffle();
    }
    private IntPtr DesktopIconView()
    {
        IntPtr progman=FindWindow("Progman",null);
        IntPtr def=FindWindowEx(progman,IntPtr.Zero,"SHELLDLL_DefView",null);
        if(def==IntPtr.Zero)
        {
            IntPtr worker=IntPtr.Zero;
            while((worker=FindWindowEx(IntPtr.Zero,worker,"WorkerW",null))!=IntPtr.Zero)
            {def=FindWindowEx(worker,IntPtr.Zero,"SHELLDLL_DefView",null);if(def!=IntPtr.Zero)break;}
        }
        return def==IntPtr.Zero?IntPtr.Zero:FindWindowEx(def,IntPtr.Zero,"SysListView32",null);
    }
    private List<Point> ReadIconLocations(IntPtr view)
    {
        List<Point> points=new List<Point>();
        uint pid;GetWindowThreadProcessId(view,out pid);
        if(pid==0)return points;
        IntPtr proc=OpenProcess(0x0418,false,pid);
        if(proc==IntPtr.Zero)return points;
        IntPtr buffer=IntPtr.Zero;
        try
        {
            buffer=VirtualAllocEx(proc,IntPtr.Zero,8,0x3000,0x04);
            if(buffer==IntPtr.Zero)return points;
            IntPtr result;
            if(SendMessageTimeout(view,0x1004,IntPtr.Zero,IntPtr.Zero,2,200,out result)==IntPtr.Zero)return points;
            int count=result.ToInt32();
            if(count<1 || count>200)return points;
            byte[] raw=new byte[8];
            for(int i=0;i<count;i++)
            {
                if(SendMessageTimeout(view,0x1010,new IntPtr(i),buffer,2,80,out result)==IntPtr.Zero || result==IntPtr.Zero)break;
                IntPtr size;
                if(!ReadProcessMemory(proc,buffer,raw,8,out size) || size.ToInt64()!=8)break;
                points.Add(new Point(BitConverter.ToInt32(raw,0),BitConverter.ToInt32(raw,4)));
            }
            return points;
        }
        finally {if(buffer!=IntPtr.Zero)VirtualFreeEx(proc,buffer,0,0x8000);CloseHandle(proc);}
    }
    private static Bitmap ScreenCapture(Rectangle bounds)
    {
        Bitmap screen=new Bitmap(bounds.Width,bounds.Height);
        using(Graphics g=Graphics.FromImage(screen))g.CopyFromScreen(bounds.Location,Point.Empty,bounds.Size);
        return screen;
    }
    private static string WindowClass(IntPtr handle)
    {
        StringBuilder name=new StringBuilder(128);GetClassName(handle,name,name.Capacity);return name.ToString();
    }
    private readonly List<IntPtr> minimizedForPrank=new List<IntPtr>();
    private void MinimizeUserWindows()
    {
        minimizedForPrank.Clear();
        EnumWindows(delegate(IntPtr handle,IntPtr ignored)
        {
            if(!IsWindowVisible(handle)||IsIconic(handle)||GetWindow(handle,4)!=IntPtr.Zero || GetWindowTextLength(handle)==0)return true;
            string cls=WindowClass(handle);
            if(cls=="Progman" || cls=="WorkerW" || cls=="Shell_TrayWnd" || cls=="NotifyIconOverflowWindow" ||
               cls=="DV2ControlHost" || cls=="Windows.UI.Core.CoreWindow")return true;
            minimizedForPrank.Add(handle);
            ShowWindow(handle,6);
            return true;
        },IntPtr.Zero);
    }
    private void RestoreUserWindows()
    {
        for(int i=minimizedForPrank.Count-1;i>=0;i--)
            try {if(IsIconic(minimizedForPrank[i]))ShowWindow(minimizedForPrank[i],9);}catch{}
        minimizedForPrank.Clear();
    }
    private sealed class IconStage : Form
    {
        internal Bitmap Backdrop;
        internal readonly List<Bitmap> Icons=new List<Bitmap>();
        internal readonly List<Point> Origins=new List<Point>();
        internal readonly List<Point> Destinations=new List<Point>();
        internal DateTime Began;
        internal Action EndAnimation;
        private readonly System.Windows.Forms.Timer frameTimer=new System.Windows.Forms.Timer();
        internal IconStage(Rectangle area)
        {
            Bounds=area;StartPosition=FormStartPosition.Manual;
            ShowInTaskbar=false;FormBorderStyle=FormBorderStyle.None;TopMost=false;
            DoubleBuffered=true;KeyPreview=true;
            frameTimer.Interval=40;
            frameTimer.Tick+=delegate
            {
                if(IsDisposed)return;
                if(Began!=DateTime.MinValue && (DateTime.UtcNow-Began).TotalMilliseconds>=9900)
                {if(EndAnimation!=null)EndAnimation();return;}
                Invalidate();
            };
            frameTimer.Start();
        }
        protected override void OnPaintBackground(PaintEventArgs e)
        {
            if(Backdrop!=null)e.Graphics.DrawImageUnscaled(Backdrop,0,0);
            else base.OnPaintBackground(e);
        }
        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);
            double time=(DateTime.UtcNow-Began).TotalSeconds;
            double slide=Math.Min(1.0,Math.Max(0.0,time/1.0));
            slide=slide*slide*(3-2*slide);
            for(int i=0;i<Icons.Count;i++)
            {
                Point a=Origins[i], b=Destinations[i];
                float x=(float)(a.X+(b.X-a.X)*slide),y=(float)(a.Y+(b.Y-a.Y)*slide);
                if(time>=5.0){double back=Math.Min(1.0,Math.Max(0.0,(time-5.0)/3.5));x=(float)(b.X+(a.X-b.X)*back);y=(float)(b.Y+(a.Y-b.Y)*back);}
                e.Graphics.DrawImageUnscaled(Icons[i],(int)x,(int)y);
            }
        }
        protected override void Dispose(bool disposing)
        {
            if(disposing){frameTimer.Stop();frameTimer.Dispose();if(Backdrop!=null)Backdrop.Dispose();foreach(Bitmap item in Icons)item.Dispose();}
            base.Dispose(disposing);
        }
    }
    private void StartIconShuffle()
    {
        if(iconStage!=null || cursorFrozenUntil!=DateTime.MinValue)return;
        Rectangle desktop=SystemInformation.VirtualScreen;
        if(desktop.Width<200 || desktop.Height<200 || desktop.Width>10000 || desktop.Height>6000)return;
        IntPtr view=DesktopIconView();if(view==IntPtr.Zero)return;
        List<Point> iconPositions=ReadIconLocations(view);
        RectangleNative viewRect;
        if(iconPositions.Count<2 || !GetWindowRect(view,out viewRect))return;
        Bitmap before=null,background=null;
        try
        {
            MinimizeUserWindows();
            before=ScreenCapture(desktop);
            bool iconViewVisible=IsWindowVisible(view);
            if(iconViewVisible)ShowWindow(view,0);
            try {background=ScreenCapture(desktop);}finally{if(iconViewVisible)ShowWindow(view,5);}
            IconStage overlay=new IconStage(desktop);
            overlay.Backdrop=background;background=null;
            int count=iconPositions.Count;
            for(int i=0;i<count;i++)
            {
                int x=viewRect.Left+iconPositions[i].X-desktop.Left-3;
                int y=viewRect.Top+iconPositions[i].Y-desktop.Top-3;
                Rectangle crop=Rectangle.Intersect(new Rectangle(x,y,95,98),new Rectangle(0,0,before.Width,before.Height));
                if(crop.Width<25 || crop.Height<25)continue;
                overlay.Icons.Add(before.Clone(crop,before.PixelFormat));
                overlay.Origins.Add(crop.Location);
                Point dst=iconPositions[(i+3)%count];
                overlay.Destinations.Add(new Point(viewRect.Left+dst.X-desktop.Left-3,viewRect.Top+dst.Y-desktop.Top-3));
            }
            if(overlay.Icons.Count<2){overlay.Dispose();RestoreUserWindows();return;}
            overlay.Began=DateTime.UtcNow;
            overlay.EndAnimation=RestoreIconShuffle;
            iconStage=overlay;
            iconRestoreAt=overlay.Began.AddMilliseconds(9900);
            overlay.Show();overlay.BringToFront();
        }
        catch(Exception e){Report("icon_visual",e.Message);RestoreIconShuffle();}
        finally {if(before!=null)before.Dispose();if(background!=null)background.Dispose();}
    }
    private void RestoreIconShuffle()
    {
        iconRestoreAt=DateTime.MinValue;
        IconStage stage=iconStage;iconStage=null;
        try{if(stage!=null){stage.Close();stage.Dispose();}}catch{}
        RestoreUserWindows();
    }
    public void TickDesktopActions()
    {
        CheckTemporaryDesktopActions(DateTime.UtcNow);
        if(iconStage!=null && !iconStage.IsDisposed)iconStage.Invalidate();
    }
    public void RestoreDesktopActions(){RestoreTemporaryDesktopActions();}
    public bool Heard(string words) { return false; }

    private void RunSelfTests()
    {
        string[] valid={
            "Leave me be.",
            "Nice try, choom.",
            "You got lucky.",
            "Okay, you're forgiven.",
            "Is this a bribe? Because it's working.",
            "Rest your eyes for twenty seconds.",
            "Grab a glass of water when you can.",
            "Back off. I need some space.",
            "Ouch. Was that necessary?"
        };
        string[] validTopics={
            "Companion.DodgeLines","Companion.PetLines","Companion.ThrowLines",
            "Companion.PatPeaceLines","Companion.PetLines","Care.Lookaway",
            "Care.Water","Companion.FirstDodgeLine","Companion.ThrowLines"
        };
        string[] invalid={
            "Another groove in your firmware indeed.",
            "No touching while I sulks.",
            "You threw the chip again.",
            "I am petting you, choom.",
            "Leave my hand alone.",
            "Your paws wear out my grooves.",
            "Stop throwing me or I'll delete your saves.",
            "Your touch makes me sigh softly.",
            "My heart melts like warm rain on dry earth.",
            "Get away, chomsky.",
            "Pick me up yourself, fool.",
            "My firmware feels warm and tender.",
            "That's rude.",
            "You are so rude for petting me.",
            "Put her down, you clumsy windbag.",
            "Well, I'll accept this clumsy olive branch then.",
            "I'm done playing with yo-yos, stop it!",
            "Stop throwing me and leave me alone.",
            "The user should know better than that."
        };
        string[] invalidTopics={
            "Companion.PetLines","Companion.FirstDodgeLine","Companion.ThrowLines",
            "Companion.PetLines","Companion.FirstDodgeLine","Companion.PetLines",
            "Companion.WarnLines","Companion.PatPeaceLines","Companion.PatPeaceLines",
            "Companion.DodgeLines","Companion.FirstDodgeLine","Companion.PetLines",
            "Companion.PetLines","Companion.PetLines",
            "Companion.DodgeLines","Companion.PatPeaceLines","Companion.DodgeLines",
            "Companion.DodgeLines","Companion.PetLines"
        };
        int errors=0;
        for(int i=0;i<valid.Length;i++)if(DialogueIssue(valid[i],validTopics[i])!=null)errors++;
        for(int i=0;i<invalid.Length;i++)if(DialogueIssue(invalid[i],invalidTopics[i])==null)errors++;
        if(DialogueIssue("That's it, stop throwing me!","Companion.SulkLines")!=null)errors++;
        if(DialogueIssue("Ouch! You really did that on purpose!","Companion.ThrowLines")!=null)errors++;
        if(!NearRepeat("Fine, stop touching me.","Fine, quit touching me.","Companion.DodgeLines"))errors++;
        if(!NearRepeat("Keep throwing me and I'll fight back.","Do that again and I'm fighting back.","Companion.WarnLines"))errors++;
        if(NearRepeat("Leave me be.","Ouch, that hurt!","Companion.DodgeLines"))errors++;
        if(NearRepeat("Fine, I can forgive you.","Fine, you learned your lesson.","Companion.PatPeaceLines"))errors++;
        if(NearRepeat("Okay, we're good now.","Okay, you owe me snacks.","Companion.PatPeaceLines"))errors++;
        if(!NearRepeat("I can forgive that little stunt.","I can forgive that silly stunt.","Companion.PatPeaceLines"))errors++;
        if(errors>0)host.Log("AI Reaction Voice policy self-test: "+errors+" checks need review.");
        else host.Log("AI Reaction Voice policy self-test: 34 semantic/grammar cases passed.");
    }
    public void Stop()
    {
        if(!active)return;
        active=false;
        runEpoch++;
        paused=true;
        if(host!=null)
        {
            host.Voice.Finished-=OnSpeechFinished;
        }
        if(tickTimer!=null){tickTimer.Cancel();tickTimer=null;}
        if(typingDelay!=null)
        {
            typingDelay.Stop();typingDelay.Dispose();typingDelay=null;
        }
        RestoreBoardBridge();
        pendingBoardDelivery.Clear();
        RestoreDesktopActions();
        lock(gate)
        {
            wanted.Clear();
            foreach(Clip c in clips.Values)c.Queued=false;
            clips.Clear();
            retired.Clear();
            finishCleanup.Clear();
        }
        host=null;
        companion=null;
    }
}
