        Register("CapriDesktop.Swarm","FakeLines","Clones.Fake",Other,"Clone makes an obviously fictional prank note, not a real deletion.","clone");
        string[] care={"Water","Stretch","Lookaway","Sleepnudge","Meals","Gamebreak","Bored","Borednoticed","Boredignored"};
        string[] careEvent={"Remind the user to drink water.","Remind user to stretch a little.","Suggest resting eyes by looking away from the screen for twenty seconds.","Late at night; suggest getting sleep.","Suggest eating a meal without claiming one was missed.","Suggest a short gaming break.","Capri is bored and asks for attention.","User noticed Capri's boredom reminder.","User ignored Capri's boredom reminder; brief playful reaction."};
        for(int i=0;i<care.Length;i++) RegisterSynthetic("Care."+care[i],Other,careEvent[i],"care",new string[0],false,true);
        RegisterSynthetic("Meeting.AskName",Other,"Ask user's preferred name; mention 'skip' or 'stop' choices.","question",new string[0],false,false);
        RegisterSynthetic("Meeting.AskCalled",Other,"Ask user what name they prefer.","question",new string[0],false,false);
        RegisterSynthetic("Meeting.AskPronouns",Other,"Ask user's pronouns without making assumptions.","question",new string[0],false,false);
        RegisterSynthetic("Meeting.AskInto",Other,"Ask user what games, music or other hobbies they enjoy.","question",new string[0],false,false);
    }

    private void OnSending(CapriMessage message)
    {
        if (!started || message == null || message.Cancel || message.Source != "you") return;
        inConversation = true;
        CancelActiveDelivery("user conversation interrupted reaction");
        Interlocked.Increment(ref conversationId);
        object active;
        lock (generationGate) active = isolated;
        if (active != null && isolatedCancel != null)
            try { isolatedCancel.Invoke(active, null); } catch { }
    }
    private void OnReplied(CapriMessage message)
    {
        if(!started || message==null || string.IsNullOrWhiteSpace(message.Text))return;
        if(!deliveringThrow && !inConversation && CurrentYelpTicket() &&
           IsThrowSpeech() && selections.Contains(Physical) &&
           !(throwDeliveryClaimed && Normalized(message.Text)==deliveredThrowLine))
        {
            if(!throwDeliveryClaimed) {throwSeen=true;RememberNativeLanding(message.Text);}
            AbortNativeReaction();
            return;
        }
        string topic=ReactionTopicForTranscript(message.Text);
        int seenTicket=-1;
        try {if(askingField!=null)seenTicket=Convert.ToInt32(askingField.GetValue(companion));}catch{}
        bool boardReply=topic!=null && selections.Contains(Board) &&
            (topic.StartsWith("Chess.",StringComparison.Ordinal) || topic.StartsWith("Mini.",StringComparison.Ordinal));
        if(topic!=null && (CurrentYelpTicket() || pendingReactionTicket==seenTicket ||
            (IsPetSpeech() && IsPetTopic(topic)) || boardReply))
        {
            TrackDisplayed(topic,message.Text);
            RecordReactionTranscript(topic,message.Text);
        }
        if(message.Source=="reply" && inConversation && !IsPetSpeech())
        {inConversation=false;CallVoice("Suspend",false);}
    }
    private bool CurrentYelpTicket()
    {
        try {return askingField!=null && yelpTicketField!=null &&
            Convert.ToInt32(askingField.GetValue(companion))==Convert.ToInt32(yelpTicketField.GetValue(companion));}
        catch{return false;}
    }
    private void AbortNativeReaction()
    {
        if(abortingNativeReaction)return;
        abortingNativeReaction=true;
        CancelActiveDelivery("native reaction superseded");
        suppressNativeAnswerSpeech=true;
        suppressNativeUntil=DateTime.UtcNow.AddMilliseconds(350);
        try
        {
            if(closeTalkMethod!=null)closeTalkMethod.Invoke(companion,new object[]{true});
            if(askingField!=null)
                askingField.SetValue(companion,Convert.ToInt32(askingField.GetValue(companion))+1);
            pendingReactionTicket=-1;pendingReactionLine=null;pendingReactionTopic=null;
        }
        catch(Exception e){lastError="Stop stale reaction: "+Short(e.Message,95);}
        finally{abortingNativeReaction=false;}
    }
    private bool IsPetSpeech()
    {
        try
        {
            return heardField!=null && speechPromptField!=null && speechBubble!=null &&
                string.Equals(Convert.ToString(heardField.GetValue(companion)),"pets you",StringComparison.OrdinalIgnoreCase) &&
                string.Equals(Convert.ToString(speechPromptField.GetValue(speechBubble)),"> sys: ",StringComparison.Ordinal);
        }
        catch{return false;}
    }
    private static bool IsPetTopic(string id)
    {return id=="Companion.PetLines" || id=="Companion.PatPeaceLines";}
    private string PetTopicForText(string text)
    {
        if(!IsPetSpeech() || string.IsNullOrWhiteSpace(text))return null;
        string key=Normalized(text);
        foreach(string id in new[]{"Companion.PatPeaceLines","Companion.PetLines"})
        {
            Pool p=Find(id);if(p==null)continue;
            if(p.Ready!=null && Normalized(p.Ready)==key)return id;
            foreach(string line in p.Reserve)if(Normalized(line)==key)return id;
            if(p.Originals!=null)foreach(string line in p.Originals)
                if(Normalized(line)==key)return id;
        }
        return null;
    }
    private string ReactionTopicForTranscript(string text)
    {
        if(string.IsNullOrWhiteSpace(text))return null;
        if(deliveringThrow && !string.IsNullOrEmpty(deliveredThrowTopic))return deliveredThrowTopic;
        string petTopic=PetTopicForText(text);
        if(petTopic!=null && pendingReactionTicket<0)return petTopic;
        int ticket=-1;
        try {if(askingField!=null)ticket=Convert.ToInt32(askingField.GetValue(companion));}catch{}
        if(ticket>=0 && ticket==pendingReactionTicket &&
            Normalized(text)==Normalized(pendingReactionLine))return pendingReactionTopic;
        if(petTopic!=null)return petTopic;
        string normalized=Normalized(text);
        foreach(Pool p in pools)
        {
            if(p.Ready!=null && normalized==Normalized(p.Ready))return p.Id;
            foreach(string alt in p.Reserve)
                if(normalized==Normalized(alt))return p.Id;
            if(p.Originals!=null)foreach(string original in p.Originals)
                if(!string.IsNullOrWhiteSpace(original) && normalized==Normalized(original))return p.Id;
        }
        if(CurrentYelpTicket())
        {
            string shown=heardField==null?"":Convert.ToString(heardField.GetValue(companion));
            if(string.Equals(shown,"reaches for you",StringComparison.OrdinalIgnoreCase))
                return normalized==Normalized("No. Don't touch me.")?"Companion.FirstDodgeLine":"Companion.DodgeLines";
            if(string.Equals(shown,"pets you",StringComparison.OrdinalIgnoreCase))return "Companion.PetLines";
            if(string.Equals(shown,"throws you",StringComparison.OrdinalIgnoreCase))return "Companion.ThrowLines";
        }
        return null;
    }
    private void RecordReactionTranscript(string topic,string text)
    {
        if(transcriptMethod==null || string.IsNullOrWhiteSpace(topic) || string.IsNullOrWhiteSpace(text))return;
        int ticket;
        try {ticket=Convert.ToInt32(askingField.GetValue(companion));}catch{return;}
        if(ticket==transcribedReactionTicket)return;
        string clean=Regex.Replace(text,@"^\s*(?:\[[a-z]+\]\s*)+","",RegexOptions.IgnoreCase).Trim();
        if(clean.Length==0)return;
        try
        {
            transcriptMethod.Invoke(null,new object[]{"Capri",clean,false});
            transcribedReactionTicket=ticket;
            if(activeDelivery!=null && activeDelivery.Ticket==ticket)activeDelivery.Transcript=true;
            Debug("TRANSCRIPT",topic,"ticket="+ticket+" "+Short(clean,90));
        }
        catch(Exception e){lastError="Reaction transcript: "+Short(e.Message,100);}
    }
    private void Debug(string stage,string topic,string message)
    {
        string row=DateTime.Now.ToString("HH:mm:ss.fff")+" | "+stage+" | "+(topic??"-")+" | "+Short(message??"",130);
        debuggerLog.Enqueue(row);
        while(debuggerLog.Count>240)debuggerLog.Dequeue();
        if(debuggerText!=null && !debuggerText.IsDisposed)
        {
            debuggerText.AppendText(row+Environment.NewLine);
            if(debuggerText.TextLength>38000)debuggerText.Text=string.Join(Environment.NewLine,debuggerLog.ToArray());
        }
    }
    private void DebugAudio(string stage,string detail)
    {
        if(window==null || window.IsDisposed || !window.IsHandleCreated)return;
        if(window.InvokeRequired)
        {
            try{window.BeginInvoke((Action)delegate{if(started)Debug(stage,"Fish Audio",detail);});}catch{}
        }
        else Debug(stage,"Fish Audio",detail);
    }
    private void CancelActiveDelivery(string reason)
    {
        if(activeDelivery==null || activeDelivery.Committed || activeDelivery.Cancelled)return;
        activeDelivery.Cancelled=true;activeDelivery.Stage="Canceled";
        if(!string.IsNullOrWhiteSpace(activeDelivery.Text))
        {
            ExcludeLineGlobally(activeDelivery.Text);
            foreach(Pool p in pools)RemoveFromPool(p,activeDelivery.Text);
            CallVoice("Retire",activeDelivery.Text);
        }
        Debug("CANCELED",activeDelivery.Topic,"#"+activeDelivery.Id+" "+reason);
    }
    private string SelectedPath() { return Path.Combine(host.Folder,"reaction-selected-history.txt"); }
    private void LoadSelectedHistory()
    {
        try {if(File.Exists(SelectedPath()))foreach(string line in File.ReadAllLines(SelectedPath()))
            {string key=Normalized(line);if(key.Length>0){reservedExact.Add(key);globalExcluded.Add(key);}}}
        catch(Exception e){Debug("HISTORY LOAD","all",Short(e.Message,90));}
    }
    private void ExcludeLineGlobally(string line)
    {
        string key=Normalized(line);
        if(key.Length==0 || !reservedExact.Add(key))return;
        globalExcluded.Add(key);
        try {File.AppendAllText(SelectedPath(),line.Replace('\r',' ').Replace('\n',' ').Trim()+Environment.NewLine,new UTF8Encoding(false));}
        catch(Exception e){Debug("HISTORY WRITE","all",Short(e.Message,90));}
    }
    private bool IsGloballyExcluded(string line)
    {
        string key=Normalized(line);
        return key.Length==0 || globalExcluded.Contains(key) || retired.Contains(key);
    }
    private void LoadReachQuota()
    {
        string raw=host.Store.Get("v2.5.2.reach-quota","");
        foreach(char ch in raw)if(ch=='0'||ch=='1')recentReachTeleport.Enqueue(ch=='1');
        while(recentReachTeleport.Count>5)recentReachTeleport.Dequeue();
    }
    private void NoteReachSelection(string topic,string line)
    {
        if(topic!="Companion.DodgeLines" && topic!="Companion.FirstDodgeLine")return;
        recentReachTeleport.Enqueue(TeleportMention(line));
        while(recentReachTeleport.Count>5)recentReachTeleport.Dequeue();
        StringBuilder bits=new StringBuilder();
        foreach(bool t in recentReachTeleport)bits.Append(t?'1':'0');
        host.Store.Set("v2.5.2.reach-quota",bits.ToString());
    }
    private static bool RelatedReachTopics(string a,string b)
    {
        return (a=="Companion.DodgeLines" || a=="Companion.FirstDodgeLine") &&
               (b=="Companion.DodgeLines" || b=="Companion.FirstDodgeLine");
    }
    private void RetireOldPreparedOnce()
    {
        if(host.Store.Flag("v2.5.1.old-queue-retired",false))return;
        int n=0;
        foreach(Pool p in pools)
        {
            string value=host.Store.Get("v2.3.lines."+p.Id,"");
            foreach(string raw in value.Split('\u001F'))
            {
                if(string.IsNullOrWhiteSpace(raw))continue;
                ArchiveSpoken(p.Id,raw,true);
                ExcludeLineGlobally(raw);
                n++;
            }
            host.Store.Set("v2.3.lines."+p.Id,"");
        }
        CallVoice("PurgeOrphaned");
        host.Store.Set("v2.5.1.old-queue-retired",true);
        Debug("MIGRATION","all","Retired "+n+" legacy queued lines; original Capri dialogue unaffected");
    }
    private void RetireBadPhysicalQueueOnce()
    {
        if(host.Store.Flag("v2.5.2.physical-queue-retired",false))return;
        int total=0;
        foreach(string id in new[]{"Companion.PetLines","Companion.PatPeaceLines",
            "Companion.DodgeLines","Companion.FirstDodgeLine","Companion.SulkLines"})
        {
            Pool p=Find(id);if(p==null)continue;
            string saved=host.Store.Get("v2.3.lines."+id,"");
            foreach(string item in saved.Split('\u001F'))
            {
                if(string.IsNullOrWhiteSpace(item))continue;
                ArchiveSpoken(id,item,true);
                ExcludeLineGlobally(item);
                CallVoice("Retire",item);
                total++;
            }
            host.Store.Set("v2.3.lines."+id,"");
        }
        try
        {
            string audioRoot=Path.Combine(host.Folder,"prepared-voices","Physical Interactions");
            foreach(string topic in new[]{"PetLines","PatPeaceLines","DodgeLines","FirstDodgeLine","SulkLines"})
            {
                string folder=Path.Combine(audioRoot,topic);
                if(!Directory.Exists(folder))continue;
                foreach(string wav in Directory.GetFiles(folder,"*.wav"))
                    try{File.Delete(wav);}catch(IOException){}catch(UnauthorizedAccessException){}
                foreach(string txt in Directory.GetFiles(folder,"*.txt"))
                    try{File.Delete(txt);}catch(IOException){}catch(UnauthorizedAccessException){}
            }
        }
        catch(IOException){}catch(UnauthorizedAccessException){}
        host.Store.Set("v2.5.2.physical-queue-retired",true);
        Debug("MIGRATION","physical","Archived "+total+" old pet/dodge entries to prevent replay");
    }

    private void RemoveFromPool(Pool p,string line)
    {
        if(p==null || string.IsNullOrWhiteSpace(line))return;
        string key=Normalized(line);
        bool changed=false;
        if(p.Ready!=null && Normalized(p.Ready)==key)
        {RestoreNativeLine(p,p.Ready);p.Ready=null;changed=true;}
        for(int i=p.Reserve.Count-1;i>=0;i--)
            if(Normalized(p.Reserve[i])==key){p.Reserve.RemoveAt(i);changed=true;}
        if(!changed)return;
        while(p.Ready==null && p.Reserve.Count>0)
        {
            int index=choiceDice.Next(p.Reserve.Count);
            string next=p.Reserve[index];p.Reserve.RemoveAt(index);
            if(EligiblePrepared(p,next)){p.Ready=next;break;}
            CallVoice("Retire",next);
        }
        ApplySlot(p);
        SaveLine(p);
        if(p.IsCheckIn)WriteCareOverlay();
    }
    private void ReserveReactionLine(string topic,string line)
    {
        ExcludeLineGlobally(line);
        foreach(Pool p in pools)RemoveFromPool(p,line);
    }
    private bool EligiblePrepared(Pool p,string line)
    {
        if(p==null || string.IsNullOrWhiteSpace(line) || IsGloballyExcluded(line))return false;
        string family=CallVoice("FamilyKey",line,p.Id) as string;
        if(!string.IsNullOrWhiteSpace(family))
        {
            HashSet<string> keys;
            if(phraseKeys.TryGetValue(p.Id,out keys) && keys.Contains(family))return false;
            if(RelatedReachTopics(p.Id,"Companion.DodgeLines"))
                foreach(string id in new[]{"Companion.FirstDodgeLine","Companion.DodgeLines"})
                    if(phraseKeys.TryGetValue(id,out keys)&&keys.Contains(family))return false;
        }
        return true;
    }

    private void LoadShownHistory()
    {
        foreach(Pool p in pools)
        {
            string file=Path.Combine(host.Folder,"reaction-shown-history",p.Id+".txt");
            try
            {
                if(!File.Exists(file))continue;
                HashSet<string> shown=new HashSet<string>(StringComparer.Ordinal);
                foreach(string entry in File.ReadAllLines(file))
                    if(!string.IsNullOrWhiteSpace(entry))shown.Add(Normalized(entry));
                shownExact[p.Id]=shown;
                foreach(string entry in shown)globalExcluded.Add(entry);
            }
            catch(IOException){}catch(UnauthorizedAccessException){}
        }
    }
    private void RememberShown(string topic,string line)
    {
        if(string.IsNullOrWhiteSpace(topic)||string.IsNullOrWhiteSpace(line))return;
        HashSet<string> shown;
        if(!shownExact.TryGetValue(topic,out shown))
            {shown=new HashSet<string>(StringComparer.Ordinal);shownExact[topic]=shown;}
        globalExcluded.Add(Normalized(line));
        if(!shown.Add(Normalized(line)))return;
        try
        {
            string folder=Path.Combine(host.Folder,"reaction-shown-history");
            Directory.CreateDirectory(folder);
            File.AppendAllText(Path.Combine(folder,topic+".txt"),line.Replace('\r',' ').Replace('\n',' ')+Environment.NewLine,new UTF8Encoding(false));
        }
        catch(IOException){}catch(UnauthorizedAccessException){}
    }

    private void TrackDisplayed(string topic,string line)
    {
        int ticket=-1;
        try{if(askingField!=null)ticket=Convert.ToInt32(askingField.GetValue(companion));}catch{}
        if(activeDelivery==null || activeDelivery.Cancelled || activeDelivery.Ticket!=ticket ||
           Normalized(activeDelivery.Text)!=Normalized(line))
        {
            CancelActiveDelivery("another reaction displayed");
            activeDelivery=new Delivery{Id=++nextDeliveryId,Ticket=ticket,Topic=topic,Text=line,
                Stage="Displayed",Origin=CurrentGeneratedLine(line)?"AI":"Original",Audio="not started",ReservedAt=DateTime.UtcNow};
        }
        activeDelivery.Displayed=true;
        if(!IsGloballyExcluded(line))
        {
            NoteReachSelection(topic,line);
            ReserveReactionLine(topic,line);
        }
        RememberShown(topic,line);
        if(!activeDelivery.Started)activeDelivery.Stage="Displayed";
        Debug("DISPLAY",topic,"#"+activeDelivery.Id+" "+Short(line,100));
    }
    private bool NativeAudioReallyPlaying()
    {
        try
        {
            object current=nativeVoiceField==null?null:nativeVoiceField.GetValue(companion);
            if(current==null)return true;
            PropertyInfo busy=current.GetType().GetProperty("Busy",IF);
            return busy==null || Convert.ToBoolean(busy.GetValue(current,null));
        }
        catch(Exception e)
        {
            Debug("VOICE CHECK", "native",Short(e.Message,85));
            return true;
        }
    }
    private void TrackVoiceStart(string text)
    {
        if(string.IsNullOrWhiteSpace(text))return;
        int ticket=-1;
        try{if(askingField!=null)ticket=Convert.ToInt32(askingField.GetValue(companion));}catch{}
        string topic=(activeDelivery!=null && !activeDelivery.Cancelled && activeDelivery.Ticket==ticket &&
            Normalized(activeDelivery.Text)==Normalized(text))?activeDelivery.Topic:ReactionTopicForTranscript(text);
        if(string.IsNullOrWhiteSpace(topic))return;
        bool boardSpeech=selections.Contains(Board) &&
            (topic.StartsWith("Chess.",StringComparison.Ordinal) || topic.StartsWith("Mini.",StringComparison.Ordinal));
        if(!boardSpeech && !CurrentYelpTicket() && pendingReactionTicket!=ticket &&
           !(IsPetSpeech() && IsPetTopic(topic)))return;
        if(activeDelivery==null || activeDelivery.Cancelled || activeDelivery.Ticket!=ticket ||
            Normalized(activeDelivery.Text)!=Normalized(text))
        {
            CancelActiveDelivery("another voice started");
            activeDelivery=new Delivery{Id=++nextDeliveryId,Ticket=ticket,Topic=topic,Text=text,
                Stage="Reserved",Origin=CurrentGeneratedLine(text)?"AI":"Original",ReservedAt=DateTime.UtcNow};
        }
        if(activeDelivery.Started)return;
        if(!IsGloballyExcluded(text))ReserveReactionLine(topic,text);
        if(!NativeAudioReallyPlaying())
        {
            Debug("VOICE FAILED",topic,"No active audio player; not marking spoken: "+Short(text,85));
            return;
        }
        activeDelivery.Started=true;activeDelivery.Stage="Speaking";activeDelivery.StartedAt=DateTime.UtcNow;
        CallVoice("ApplyGlobalSpeechLead",text);
        activeDelivery.Audio=(CallVoice("PreparedBytes",text) as byte[])!=null?"Prepared Fish WAV":"Native selected voice";
        double wait=(DateTime.UtcNow-activeDelivery.ReservedAt).TotalMilliseconds;
        Debug("VOICE START",topic,"#"+activeDelivery.Id+" ready after "+wait.ToString("0")+"ms | "+activeDelivery.Audio+" | "+Short(text,85));
    }
    private void FinishActiveDelivery()
    {
        Delivery d=activeDelivery;
        if(d==null || d.Cancelled || d.Committed || !d.Started)return;
        int ticket=-1;
        try{if(askingField!=null)ticket=Convert.ToInt32(askingField.GetValue(companion));}catch{}
        if(ticket!=d.Ticket){CancelActiveDelivery("speech ticket changed");return;}
        d.Committed=true;d.Stage="Completed";
        Debug("VOICE COMPLETE",d.Topic,"#"+d.Id+" "+d.Audio+" | "+Short(d.Text,90));
        HandleSpoken(d.Text,d.Topic);
        if(d.Text==CursorThreat || d.Text==IconThreat)
            CallVoice("ArmRetaliation",d.Text,cursorLock,iconShuffle);
        TrackDeliveredFallback(d.Text);
        TrackNativeFallback(d.Text);
        WriteDeliveryHistory(d);
    }
    private void WriteDeliveryHistory(Delivery d)
    {
        try
        {
            string file=Path.Combine(host.Folder,"reaction-delivery-history.tsv");
            string clean=Regex.Replace(d.Text??"",@"[
	]+"," ");
            File.AppendAllText(file,DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")+"	"+d.Id+
                "	"+d.Topic+"	"+d.Origin+"	"+d.Audio+"	"+
                (d.Transcript?"transcribed":"not transcribed")+"	"+clean+Environment.NewLine,new UTF8Encoding(false));
        }
        catch(Exception e){lastError="Reaction history: "+Short(e.Message,85);}
    }

    private void MarkReaction(string topic,string text)
    {
        if(string.IsNullOrWhiteSpace(topic)||string.IsNullOrWhiteSpace(text))return;
        try {pendingReactionTicket=Convert.ToInt32(askingField.GetValue(companion));}
        catch{pendingReactionTicket=-1;}
        pendingReactionTopic=topic;pendingReactionLine=text;
        if(activeDelivery!=null && !activeDelivery.Committed && !activeDelivery.Cancelled &&
            (activeDelivery.Ticket!=pendingReactionTicket || Normalized(activeDelivery.Text)!=Normalized(text)))
            CancelActiveDelivery("new canonical line reserved");
        activeDelivery=new Delivery{Id=++nextDeliveryId,Ticket=pendingReactionTicket,Topic=topic,Text=text,
            Stage="Reserved",Origin=CurrentGeneratedLine(text)?"AI":"Original",Audio="pending",ReservedAt=DateTime.UtcNow};
        NoteReachSelection(topic,text);
        ReserveReactionLine(topic,text);
        Debug("RESERVED",topic,"#"+activeDelivery.Id+" "+Short(text,90));
    }
    private bool DeliverPreparedReaction(string topic,string text)
    {
        if(!selections.Contains(Physical) || !(CurrentYelpTicket() || (IsPetTopic(topic) && IsPetSpeech())) ||
           inConversation || host.Chat.Busy || !topic.StartsWith("Companion.",StringComparison.Ordinal) ||
           IsThrowSpeech() || beginNativeMethod==null || talkingState==null || askingField==null)
            return false;
        byte[] wav=CallVoice("PreparedBytes",text) as byte[];
        if(wav==null || wav.Length<44)return false;
        AbortNativeReaction();
        int ticket;
        try
        {
            ticket=Convert.ToInt32(askingField.GetValue(companion));
            if(yelpTicketField!=null)yelpTicketField.SetValue(companion,ticket);
        }
        catch{return false;}
        MarkReaction(topic,text);
        host.Timers.After(0.015,delegate
        {
            if(!started || inConversation || host.Chat.Busy || askingField==null)return;
            try
            {
                if(Convert.ToInt32(askingField.GetValue(companion))!=ticket)return;
                if(beginNativeMethod.GetParameters().Length==5)
                    beginNativeMethod.Invoke(companion,new object[]{ticket,text,talkingState,wav,0.0});
                else beginNativeMethod.Invoke(companion,new object[]{ticket,text,talkingState,wav});
                CallVoice("ApplyNativeSpeechLead",ticket,text,wav);
            }
            catch(Exception e){lastError="Prepared reaction: "+Short(e.Message,95);}
        });
        return true;
    }
