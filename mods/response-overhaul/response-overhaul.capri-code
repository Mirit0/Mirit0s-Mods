    private bool RouteReachBeforeSpeech(CapriMessage message)
    {
        if(!selections.Contains(Physical) || !CurrentYelpTicket() || inConversation ||
           heardField==null || !string.Equals(Convert.ToString(heardField.GetValue(companion)),
           "reaches for you",StringComparison.OrdinalIgnoreCase))return false;
        bool distinctReach=(DateTime.UtcNow-lastReachEvent).TotalMilliseconds>=350;
        lastReachEvent=DateTime.UtcNow;
        if(Voice()==null || !Voice().IsFishActive())
        {
            MarkReaction("Companion.DodgeLines",message.Text);
            Debug("REACH NATIVE","Companion.DodgeLines","Fish not selected; original voice path preserved");
            return true;
        }
        string original=message.Text;
        if(distinctReach)CallVoice("RetaliationOnReach");
        string announcement=distinctReach ? RollRetaliationAnnouncement() : null;
        if(announcement!=null)
        {
            message.Text=announcement;
            if(DeliverPreparedReaction("Companion.DodgeLines",announcement))
            { Debug("RETALIATION PROMISE","Companion.DodgeLines",announcement); return true; }
            AbortNativeReaction();return true;
        }
        bool first=Normalized(original)==Normalized("No. Don't touch me.");
        Pool primary=Find(first?"Companion.FirstDodgeLine":"Companion.DodgeLines");
        Pool backup=Find(first?"Companion.DodgeLines":"Companion.FirstDodgeLine");
        Pool chosen=null;
        string output=null;
        foreach(Pool p in new[]{primary,backup})
        {
            string candidate=SelectPreparedAlternative(p,true,true);
            if(candidate!=null){chosen=p;output=candidate;break;}
        }
        if(output==null)
        {
            foreach(Pool p in new[]{primary,backup})
            {
                if(p==null || p.Originals==null)continue;
                foreach(string line in p.Originals)
                {
                    if(!EligiblePrepared(p,line) ||
                       (CallVoice("DialogueIssue",line,p.Id) as string)!=null)continue;
                    byte[] wav=CallVoice("PreparedBytes",line) as byte[];
                    if(wav!=null && wav.Length>=44){chosen=p;output=line;break;}
                }
                if(output!=null)break;
            }
        }
        if(output==null)
        {
            Debug("REACH NO WAV",first?"Companion.FirstDodgeLine":"Companion.DodgeLines",
                "No prepared Fish clip. Preventing late 30-second native voice. Background queue will refill.");
            PrepareReachPriority();
            AbortNativeReaction();
            return true;
        }
        message.Text=output;
        if(!DeliverPreparedReaction(chosen.Id,output))
        {
            Debug("REACH SUPPRESSED",chosen.Id,"Prepared clip disappeared before playback");
            AbortNativeReaction();
        }
        return true;
    }
    private void PrepareReachPriority()
    {
        foreach(string id in new[]{"Companion.FirstDodgeLine","Companion.DodgeLines"})
        {
            Pool p=Find(id);if(!Enabled(p))continue;
            if(p.Originals!=null)foreach(string line in p.Originals)
                if(!string.IsNullOrWhiteSpace(line) && !IsGloballyExcluded(line) &&
                   (CallVoice("DialogueIssue",line,p.Id) as string)==null)
                   CallVoice("PreparePriority",line,p.Id,p.Group);
            if(p.Ready!=null)CallVoice("PreparePriority",p.Ready,p.Id,p.Group);
            foreach(string line in p.Reserve)CallVoice("PreparePriority",line,p.Id,p.Group);
        }
    }
    private static string Normalized(string value)
    {
        return Regex.Replace((value ?? "").ToLowerInvariant(), @"[^\p{L}\p{Nd}]+", " ").Trim();
    }
    private void OnReplying(CapriMessage message)
    {
        if (!started || message == null || message.Source == "you" || string.IsNullOrEmpty(message.Text)) return;
        if(!deliveringThrow && !inConversation && CurrentYelpTicket() &&
           IsThrowSpeech() && selections.Contains(Physical) &&
           !(throwDeliveryClaimed && Normalized(message.Text)==deliveredThrowLine))
        {
            throwSeen=true;
            if(!ThrowInFlight())RememberNativeLanding(message.Text);
            AbortNativeReaction();
            return;
        }
        if(IsThrowSpeech() && throwDeliveryClaimed &&
           Normalized(message.Text)==deliveredThrowLine)return;
        if(RouteReachBeforeSpeech(message))return;
        if(selections.Contains(Board))
        {
            string key=Normalized(message.Text);
            foreach(Pool p in pools)
            {
                if(p.Group!=Board || !p.Id.StartsWith("Mini.",StringComparison.Ordinal))continue;
                bool selected=p.Ready!=null && Normalized(p.Ready)==key;
                if(!selected)foreach(string alt in p.Reserve)if(Normalized(alt)==key){selected=true;break;}
                if(!selected)continue;
                if(DeliverPreparedBoard(p.Id,message.Text))return;
                MarkReaction(p.Id,message.Text);
                return;
            }
        }
        string original = message.Text;
        foreach(Pool native in pools)
        {
            if(!Enabled(native) || native.Synthetic || native.IsGame || TakeoffPool(native) || native.Originals==null)continue;
            if(IsPetTopic(native.Id) && !IsPetSpeech())continue;
            if(IsPetSpeech() && native.Group==Physical && !IsPetTopic(native.Id))continue;
            bool nativeMatch=false;
            foreach(string old in native.Originals)
                if(!string.IsNullOrWhiteSpace(old) && Normalized(old)==Normalized(original))
                {nativeMatch=true;break;}
            if(!nativeMatch)continue;
            string selected=native.Group==Board ? SelectPreparedAlternative(native,true,true)
                : SelectPreparedAlternative(native,true);
            if(selected!=null)
            {
                message.Text=selected;
                if(native.IsGreeting && DeliverPreparedGreeting(native.Id,selected))return;
                if(native.Group==Board && DeliverPreparedBoard(native.Id,selected))return;
                if(!DeliverPreparedReaction(native.Id,message.Text))MarkReaction(native.Id,message.Text);
                return;
            }
            if(EverSpoken(native.Id,original))
            {
                foreach(string alternative in native.Originals)
                    if(!string.IsNullOrWhiteSpace(alternative) && !HistoryContains(native.Id,alternative))
                    {message.Text=alternative;
                     if(!DeliverPreparedReaction(native.Id,message.Text))MarkReaction(native.Id,message.Text);
                     return;}
                AbortNativeReaction();
                return;
            }
            if(native.IsGreeting && DeliverPreparedGreeting(native.Id,message.Text))return;
            if(DeliverPreparedReaction(native.Id,message.Text))return;
            if(native.Group==Board && DeliverPreparedBoard(native.Id,message.Text))return;
            MarkReaction(native.Id,message.Text);
            break;
        }
        foreach (Pool pool in pools)
        {
            if (pool.Ready == null || !Enabled(pool) || !pool.Synthetic || pool.IsGame) continue;
            if (pool.IsCheckIn)
            {
                List<string> originals;
                if (!careOriginal.TryGetValue(pool.Id.Substring(5), out originals)) continue;
                foreach (string line in originals)
                if (original == line) { message.Text = pool.Ready; MarkReaction(pool.Id,message.Text); return; }
            }
            if (pool.Id.StartsWith("Meeting.", StringComparison.Ordinal))
            {
                string reference = pool.Id == "Meeting.AskName" ? "Let's get to know each other, choom. What should I call you? Say skip to skip one, or stop to stop." :
                    pool.Id == "Meeting.AskCalled" ? "What should I call you?" :
                    pool.Id == "Meeting.AskPronouns" ? "What are your pronouns? Like she/her, he/him or they/them." :
                    "What are you into? Games, music, shows, anything.";
                if (!original.EndsWith(reference, StringComparison.Ordinal)) continue;
                message.Text = original.Substring(0, original.Length - reference.Length) + pool.Ready;
                MarkReaction(pool.Id,message.Text);
                return;
            }
        }
    }
    private void OnVoiceStarted(string text)
    {
        if(!started || string.IsNullOrWhiteSpace(text))return;
        if(!deliveringThrow && InterceptNativeThrow(text))return;
        CallVoice("ApplyGlobalSpeechLead",text);
        TrackVoiceStart(text);
    }
    private void OnVoiceFinished()
    {
        if(!started)return;
        FinishActiveDelivery();
        CallVoice("SpeechFinished");
    }
    private void OnSpeaking(CapriMessage message)
    {
        if(!started || message==null || string.IsNullOrWhiteSpace(message.Text))return;
        if(suppressNativeAnswerSpeech && DateTime.UtcNow<=suppressNativeUntil)
        {
            suppressNativeAnswerSpeech=false;
            message.Cancel=true;
            Debug("NATIVE AUDIO CANCELED","physical","No on-demand synth for superseded event");
            return;
        }
        suppressNativeAnswerSpeech=false;
        if(!deliveringThrow && IsThrowSpeech() && selections.Contains(Physical) &&
           !inConversation && !host.Chat.Busy)
        {
            message.Cancel=true;
            throwSeen=true;
            AbortNativeReaction();
            return;
        }
    }
    private void OnTick(object sender,EventArgs args)
    {
        if(!started)return;
        try
        {
            TrackThrowAndDeliver();
            ObserveNativeSpeech();
            CallVoice("TickDesktopActions");
            if((DateTime.UtcNow-nextScan).TotalSeconds>5)
            {
                nextScan=DateTime.UtcNow;
                UpdateCareIfChanged(); RefreshSlots(); SyncGameHook(); WatchBrain(); WatchTrouble();
            }
            UpdateProgress();
            bool busy=TaskRunning();
            if(busy!=jobHeld){jobHeld=busy;CallVoice("HoldForJob",busy);}
            if(!initialized || generationPaused || inConversation || busy || host.Chat.Busy || host.Voice.Talking || generating ||
                pickerWindow!=null || Voice()==null)return;
            Pool candidate=ChooseNext();if(candidate!=null)Generate(candidate);
        }
        catch(Exception e){lastError=Short(e.Message,130);}
    }
    private bool TaskRunning()
    {
        try
        {
            if(workingField!=null && workingField.GetValue(companion)!=null)return true;
            return jobField!=null && jobField.GetValue(companion)!=null;
        }
        catch{return false;}
    }
    private void WatchBrain()
    {
        string now=null;
        try{if(modelProperty!=null)now=Convert.ToString(modelProperty.GetValue(brain,null));}catch{}
        if(string.IsNullOrEmpty(now))return;
        if(lastModel==null){lastModel=now;return;}
        if(now==lastModel)return;
        bool wasBusy=generating||currentPool!=null;
        lastModel=now;
        Interlocked.Increment(ref conversationId);
        object active;
        lock(generationGate)active=isolated;
        if(active!=null && isolatedCancel!=null)try{isolatedCancel.Invoke(active,null);}catch{}
        Debug("BRAIN CHANGED",null,Short(now,46)+(wasBusy?" | dropped the line in progress":""));
        if(wasBusy)Tell("You swapped my brain while I was writing, choom. I dropped that line and I'll write it again.");
    }
    private void WatchTrouble()
    {
        if(lastError==null){troubleSince=DateTime.MinValue;troubleTold=false;return;}
        if(troubleSince==DateTime.MinValue){troubleSince=DateTime.UtcNow;return;}
        if(troubleTold || (DateTime.UtcNow-troubleSince).TotalSeconds<25)return;
        troubleTold=true;
        Tell("My dialogue generator is stuck, choom. Take a peek at the reaction debugger.");
    }
    private void Tell(string line)
    {
        try{host.Ui.Bubble(line);}catch{}
        try{host.Log(line);}catch{}
    }
    private void ObserveNativeSpeech()
    {
        if(speechField==null)return;
        string text=speechField.GetValue(companion) as string;
        double at=0;
        if(speechStartedField!=null)try{at=Convert.ToDouble(speechStartedField.GetValue(companion));}catch{}
        if(string.IsNullOrEmpty(text)){lastNativeSpeech=null;return;}
        if(text==lastNativeSpeech && at==lastSpeechStarted)return;
        if(!deliveringThrow && InterceptNativeThrow(text))return;
        lastNativeSpeech=text;lastSpeechStarted=at;
        if(host.Voice.Talking && pendingReactionTicket>=0 &&
           Normalized(text)==Normalized(pendingReactionLine))TrackVoiceStart(text);
    }
    private bool ThrowInFlight()
    {
        try{return (thrownField!=null && Convert.ToBoolean(thrownField.GetValue(companion))) ||
            (fallingField!=null && Convert.ToBoolean(fallingField.GetValue(companion)));}
        catch{return false;}
    }
    private bool IsThrowSpeech()
    {
        try{return selections.Contains(Physical) && heardField!=null &&
            string.Equals(heardField.GetValue(companion) as string,"throws you",StringComparison.OrdinalIgnoreCase);}
        catch{return false;}
    }
    private bool RecentThrowDelivery()
    {
        return throwDeliveryClaimed && (DateTime.UtcNow-throwClaimedAt).TotalSeconds<5;
    }
    private void RememberNativeLanding(string text)
    {
        if(throwDeliveryClaimed)return;
        string clean=Regex.Replace(text??"",@"^\s*(?:\[[a-z]+\]\s*)+","",RegexOptions.IgnoreCase).Trim();
        string topic="Companion.ThrowLines";
        foreach(string id in new[]{"Companion.SulkLines","Companion.DizzyLines","Companion.WarnLines"})
        {
            Pool p=Find(id);if(p==null)continue;
            if((p.Ready!=null && Normalized(p.Ready)==Normalized(clean)) ||
                Array.Exists(p.Originals,x=>Normalized(x)==Normalized(clean)))
            {topic=id;break;}
        }
        nativeLandingTopic=topic;
        nativeLandingLine=clean;
    }
    private bool InterceptNativeThrow(string text)
    {
        if(!IsThrowSpeech() || !CurrentYelpTicket() || deliveringThrow || inConversation || host.Chat.Busy)return false;
        if(throwDeliveryClaimed && Normalized(text)==deliveredThrowLine)return false;
        if(!throwDeliveryClaimed)
        {
            throwSeen=true;
            if(!ThrowInFlight())RememberNativeLanding(text);
        }
        AbortNativeReaction();
        return true;
    }
    private void OnBubbleVisible(object source,EventArgs args)
    {
        if(!started || speechBubble==null || !speechBubble.Visible || !IsThrowSpeech() || deliveringThrow)return;
        string text=speechField==null?null:speechField.GetValue(companion) as string;
        if(string.IsNullOrWhiteSpace(text) && replyField!=null)text=replyField.GetValue(companion) as string;
        if(!string.IsNullOrWhiteSpace(text))InterceptNativeThrow(text);
    }
    private void ClearNativePicker(string[] array)
    {
        try
        {
            Type t=companion.GetType().Assembly.GetType("CapriDesktop.Lines",false);
            FieldInfo fi=t==null?null:t.GetField("said",SF);
            IDictionary picker=fi==null?null:fi.GetValue(null) as IDictionary;
            if(picker!=null)lock(picker){picker.Remove(array);}
        }
        catch(Exception e){lastError="Throw picker reset: "+Short(e.Message,95);}
    }
    private static bool TakeoffPool(Pool p)
    {return p!=null && (p.Id=="Companion.ThrowLines" || p.Id=="Companion.WarnLines");}
    private void SyncTakeoffSilence()
    {
        foreach(string id in new[]{"Companion.ThrowLines","Companion.WarnLines"})
        {
            Pool p=Find(id);if(p==null || p.Slots==null)continue;
            bool suppress=Enabled(p),changed=false;
            for(int i=0;i<p.Slots.Length;i++)
            {
                string newValue=suppress?null:p.Originals[i];
                if(p.Slots[i]==newValue)continue;
                p.Slots[i]=newValue;changed=true;
            }
            if(changed)ClearNativePicker(p.Slots);
        }
    }
    private Point? CurrentThrowAnchor()
    {
        try
        {
            if(anchorField==null)return null;
            object position=anchorField.GetValue(companion);
            return position is Point ? (Point?)((Point)position) : null;
        }
        catch{return null;}
    }
    private void ResetThrowForNextFlight()
    {
        if(throwDeliveryClaimed && IsThrowSpeech() && !inConversation && closeTalkMethod!=null)
            try{closeTalkMethod.Invoke(companion,new object[]{true});}catch{}
        heldThrow=null; nativeLandingLine=null; nativeLandingTopic=null;
        throwSeen=true; throwDeliveryClaimed=false; throwFallbackRecorded=false;
        deliveredThrowLine=null;deliveredThrowTopic=null;
        throwLanded=DateTime.MinValue;throwStill=DateTime.MinValue;
        previousThrowAnchor=null;
    }
    private void TrackThrowAndDeliver()
    {
        if(!started || !selections.Contains(Physical) || thrownField==null)return;
        bool inFlight=ThrowInFlight();
        if(inFlight)
        {
            bool thrown=false;
            try{thrown=Convert.ToBoolean(thrownField.GetValue(companion));}catch{}
            if(thrown && !wasThrownLastTick)ResetThrowForNextFlight();
            wasThrownLastTick=thrown;
            throwStill=DateTime.MinValue;
            previousThrowAnchor=CurrentThrowAnchor();
            return;
        }
        wasThrownLastTick=false;
        if(!throwSeen || throwDeliveryClaimed)return;
        DateTime now=DateTime.UtcNow;
        if(throwLanded==DateTime.MinValue)throwLanded=now;
        if((now-throwLanded).TotalMilliseconds>LatestLandingVoiceMs)
        {
            if(IsThrowSpeech() && closeTalkMethod!=null)
                try{closeTalkMethod.Invoke(companion,new object[]{true});}catch{}
            throwSeen=false; nativeLandingLine=null; nativeLandingTopic=null;
            return;
        }
        Point? position=CurrentThrowAnchor();
        if(position.HasValue && previousThrowAnchor.HasValue && position.Value!=previousThrowAnchor.Value)
        {
            throwStill=now;previousThrowAnchor=position;return;
        }
        previousThrowAnchor=position;
        if(throwStill==DateTime.MinValue){throwStill=now;return;}
        if((now-throwStill).TotalMilliseconds<350 || (now-throwLanded).TotalMilliseconds<350)return;
        if(inConversation || host.Chat.Busy)return;
        if(hiddenField!=null && Convert.ToBoolean(hiddenField.GetValue(companion)))
        {throwSeen=false;return;}
        if(workingField!=null && workingField.GetValue(companion)!=null)return;
        if(talkStateField!=null && !string.Equals(Convert.ToString(talkStateField.GetValue(companion)),"Off",StringComparison.Ordinal))
        {
            if(IsThrowSpeech())
                try{if(closeTalkMethod!=null)closeTalkMethod.Invoke(companion,new object[]{true});}
                catch{}
            else return;
        }
        if(host.Voice.Talking)return;
        string topic=nativeLandingTopic??"Companion.ThrowLines";
        Pool chosen=Find(topic);
        if(chosen==null)chosen=Find("Companion.ThrowLines");
        if(chosen!=null && chosen.Ready!=null && CallVoice("PreparedBytes",chosen.Ready)==null)
        {
            for(int i=0;i<chosen.Reserve.Count;i++)
            {
                string alternative=chosen.Reserve[i];
                if(CallVoice("PreparedBytes",alternative) is byte[] && SafeForSpeaking(chosen,alternative))
                {
                    chosen.Reserve[i]=chosen.Ready;
                    chosen.Ready=alternative;
                    ApplySlot(chosen);
                    SaveLine(chosen);
                    break;
                }
            }
        }
        string generated=SelectPreparedAlternative(chosen,true);
        string line=generated;
        if(line==null || CallVoice("PreparedBytes",line)==null)
        {
            string fallback=null;
            if(!string.IsNullOrWhiteSpace(nativeLandingLine) && chosen!=null &&
                Array.Exists(chosen.Originals,x=>Normalized(x)==Normalized(nativeLandingLine)))
                fallback=nativeLandingLine;
            if(fallback!=null && CallVoice("PreparedBytes",fallback)!=null)line=fallback;
            else
            {
                string prepared=PreparedOriginalFallback(chosen);
                if(prepared!=null)line=prepared;
                else if(line==null)line=fallback??OriginalThrowFallback(chosen);
            }
        }
        if(string.IsNullOrWhiteSpace(line) || beginNativeMethod==null || talkingState==null || askingField==null)
        {throwSeen=false;return;}
        throwDeliveryClaimed=true;throwClaimedAt=now;
        deliveredThrowLine=Normalized(line);deliveredThrowTopic=chosen==null?"Companion.ThrowLines":chosen.Id;
        deliveringThrow=true;
        try
        {
            int ticket=Convert.ToInt32(askingField.GetValue(companion))+1;
            askingField.SetValue(companion,ticket);
            if(yelpTicketField!=null)yelpTicketField.SetValue(companion,ticket);
            if(heardField!=null)heardField.SetValue(companion,"throws you");
            MarkReaction(deliveredThrowTopic,line);
            byte[] wav=CallVoice("PreparedBytes",line) as byte[];
            if(wav!=null)
            {
                if(beginNativeMethod.GetParameters().Length==5)
                    beginNativeMethod.Invoke(companion,new object[]{ticket,line,talkingState,wav,0.0});
                else beginNativeMethod.Invoke(companion,new object[]{ticket,line,talkingState,wav});
                CallVoice("ApplyNativeSpeechLead",ticket,line,wav);
            }
            else if(answerNativeMethod!=null)
            {
                answerNativeMethod.Invoke(companion,new object[]{ticket,line,talkingState,false,false});
            }
            else if(beginNativeMethod.GetParameters().Length==5)
                beginNativeMethod.Invoke(companion,new object[]{ticket,line,talkingState,null,0.0});
            else beginNativeMethod.Invoke(companion,new object[]{ticket,line,talkingState,null});
        }
        catch(Exception e){lastError="Single landing delivery: "+Short(e.Message,110);}
        finally {deliveringThrow=false;throwSeen=false;throwStill=DateTime.MinValue;throwLanded=DateTime.MinValue;}
    }
    private string[] OriginalLandingOptions(Pool preferred)
    {
        if(preferred!=null && preferred.Id=="Companion.ThrowLines")
            return new[]{"Choom, I'm not a frisbee!", "Okay, rude."};
        return preferred==null?new string[0]:preferred.Originals;
    }
    private string PreparedOriginalFallback(Pool preferred)
    {
        foreach(string line in OriginalLandingOptions(preferred))
            if(!string.IsNullOrWhiteSpace(line) && !HistoryContains(preferred.Id,line) &&
                CallVoice("PreparedBytes",line)!=null)return line;
        return null;
    }
    private string OriginalThrowFallback(Pool preferred)
    {
        Pool target=preferred??Find("Companion.ThrowLines");
        if(target==null)return null;
        string[] options=OriginalLandingOptions(target);
        if(options.Length==0)return null;
        int first=throwFallbackDice.Next(options.Length);
        for(int i=0;i<options.Length;i++)
        {
            string candidate=options[(first+i)%options.Length];
            if(!string.IsNullOrWhiteSpace(candidate) && !HistoryContains(target.Id,candidate))return candidate;
        }
        return null;
    }
    private void PreparePhysicalFallbacks()
    {
        foreach(string id in new[]{"Companion.PetLines","Companion.PatPeaceLines","Companion.DodgeLines","Companion.FirstDodgeLine"})
        {
            Pool p=Find(id);
            if(!Enabled(p) || p.Originals==null)continue;
            foreach(string original in p.Originals)
            {
                if(string.IsNullOrWhiteSpace(original) || HistoryContains(p.Id,original))continue;
                if(CallVoice("DialogueIssue",original,p.Id) as string!=null)continue;
                CallVoice("Prepare",original,p.Id,p.Group);
                break;
            }
        }
    }
    private void PrepareThrowFallbacks()
    {
        if(!selections.Contains(Physical))return;
        foreach(string id in new[]{"Companion.ThrowLines","Companion.WarnLines","Companion.DizzyLines","Companion.SulkLines"})
        {
            Pool p=Find(id);if(p==null)continue;
            foreach(string original in OriginalLandingOptions(p))
                if(!string.IsNullOrWhiteSpace(original))CallVoice("Prepare",original,p.Id,p.Group);
        }
    }
    private void TrackDeliveredFallback(string text)
    {
        if(throwFallbackRecorded || !throwDeliveryClaimed ||
            Normalized(text)!=deliveredThrowLine || CurrentGeneratedLine(text))return;
        throwFallbackRecorded=true;
        string topic=deliveredThrowTopic??"Companion.ThrowLines";
        RememberSpoken(topic,text);
        CallVoice("Retire",text);
    }
    private void TrackNativeFallback(string text)
    {
        if(string.IsNullOrWhiteSpace(text))return;
        if(selections.Contains(Physical) && heardField!=null &&
            string.Equals(Convert.ToString(heardField.GetValue(companion)),"reaches for you",StringComparison.OrdinalIgnoreCase) &&
            Normalized(text)==Normalized("No. Don't touch me."))
        {
            HashSet<string> exact;
            if(!spokenExact.TryGetValue("Companion.FirstDodgeLine",out exact) || !exact.Contains(Normalized(text)))
                RememberSpoken("Companion.FirstDodgeLine",text);
            return;
        }
        foreach(Pool p in pools)if(Enabled(p) && p.Originals!=null)
            foreach(string original in p.Originals)
                if(!string.IsNullOrWhiteSpace(original) && Normalized(original)==Normalized(text))
                {
                    HashSet<string> exact;
                    if(!spokenExact.TryGetValue(p.Id,out exact) || !exact.Contains(Normalized(text))) RememberSpoken(p.Id,text);
                    return;
                }
    }
    private string SelectPreparedAlternative(Pool p,bool preferWav,bool requireWav=false)
    {
        if(p==null)return null;
        List<string> all=new List<string>();
        if(EligiblePrepared(p,p.Ready))all.Add(p.Ready);
        foreach(string line in p.Reserve)
            if(EligiblePrepared(p,line) && !all.Contains(line))all.Add(line);
        if(all.Count==0)return null;
        if(preferWav || requireWav)
        {
            List<string> voiced=new List<string>();
            foreach(string line in all)
            {
                byte[] audio=CallVoice("PreparedBytes",line) as byte[];
                if(audio!=null && audio.Length>=44)voiced.Add(line);
            }
            if(voiced.Count>0)all=voiced;
            else if(requireWav)return null;
        }
        string chosen=all[choiceDice.Next(all.Count)];
        if(chosen!=p.Ready)
        {
            p.Reserve.Remove(chosen);
            if(p.Ready!=null)p.Reserve.Add(p.Ready);
            p.Ready=chosen;
            ApplySlot(p);
            SaveLine(p);
        }
        return chosen;
    }

    private void HandleSpoken(string said,string topic)
    {
        if(string.IsNullOrWhiteSpace(said) || string.IsNullOrWhiteSpace(topic))return;
        Pool p=Find(topic);
        if(p!=null)
        {
            p.UsedCount++;
            RemoveFromPool(p,said);
        }
        ExcludeLineGlobally(said);
        foreach(Pool other in pools)if(other!=p)RemoveFromPool(other,said);
        HashSet<string> existing;
        if(!spokenExact.TryGetValue(topic,out existing) || !existing.Contains(Normalized(said)))
            RememberSpoken(topic,said);
        CallVoice("Retire",said);
    }
    private bool CurrentGeneratedLine(string line)
    {
        foreach(Pool p in pools) if(p.Ready!=null && Enabled(p) && Normalized(p.Ready)==Normalized(line)) return true;
        return false;
    }
    private bool Enabled(Pool p) { return p!=null && selections.Contains(p.Group); }
    private Pool Find(string id)
    {
        foreach (Pool pool in pools) if (pool.Id == id) return pool;
        return null;
    }
    private Pool ChooseNext()
    {
        int n=pools.Count;
        if(n==0) return null;
        for(int i=0;i<n;i++)
        {
            int index=(schedulerCursor+i)%n;
            Pool p=pools[index];
            if(!Enabled(p) || (p.Ready!=null && p.Reserve.Count>=TargetLines(p.Id)-1) || DateTime.UtcNow<p.Retry) continue;
            schedulerCursor=(index+1)%n;
            return p;
        }
        return null;
    }
    private object MakeIsolatedBrain()
    {
        object fresh=Activator.CreateInstance(brainType,true);
        foreach(string key in new[]{"Model","Remote","Local","LocalPick","Picks","CloudWait"})
        {
            FieldInfo f=brainType.GetField(key,IF);
            if(f!=null && !f.IsInitOnly) try { f.SetValue(fresh,f.GetValue(brain)); } catch { }
        }
        if(copyServer!=null) try { copyServer.Invoke(brain,new[]{fresh}); } catch { }
        return fresh;
    }
    private static readonly string[] Styles={
        "a quick deadpan reaction", "a playful short comeback", "dry sarcasm",
        "a direct surprised response", "an annoyed quip", "cheeky teasing",
        "an understated reaction", "a brief mock challenge", "quiet confidence",
        "an unexpected one-liner without an interjection", "a witty concession", "a direct question about the user, only when sensible"};
    private string StyleFor(Pool pool)
    {
        int index=(pool.Attempt+pool.UsedCount)%6;
        string[] angles;
        if(pool.Kind=="peace")angles=new[]{
            "accepting the truce without formal phrasing", "an amused concession",
            "teasing the user's attempts to make amends", "dropping the grudge with a smirk",
            "acknowledging that the headpat worked", "a brief friendly reset"};
        else if(pool.Kind=="pet")angles=new[]{
            "amused by the attention", "playfully suspicious of the attention",
            "reluctantly pleased", "cocky and teasing", "briefly affectionate", "asking for more with attitude"};
        else if(pool.Kind=="refuse")angles=new[]{
            "a brief firm refusal", "a pointed remark about the user's behavior", "dry annoyed humor",
            "a confident nope", "a playful warning", "sarcasm about being bothered again"};
        else if(pool.Kind=="throw" || pool.Kind=="warn" || pool.Kind=="dizzy")angles=new[]{
            "surprise at the landing", "dry complaint about being thrown", "playful mock warning",
            "mock indignation", "a startled comeback", "an annoyed but funny retort"};
        else angles=Styles;
        return angles[(pool.Attempt+pool.UsedCount)%angles.Length];
    }

    private string UserName()
    {
        try
        {
            string name=nicknameField==null?null:Convert.ToString(nicknameField.GetValue(null));
            if(!string.IsNullOrWhiteSpace(name))return name.Trim();
        }
        catch{}
        return "choom";
    }

    private string EventPrompt(Pool pool)
    {
        StringBuilder text=new StringBuilder();
        text.Append("Confirmed situation: ").Append(pool.Event).Append('\n');
        text.Append("Write ONLY one NEW line Capri would say aloud, not a thought or narration. ");
        text.Append("Keep the actor/recipient of the action correct and the event literal. ");
        if(pool.Kind=="peace")text.Append("The USER is gently patting Capri after earlier rough play. Capri makes peace with them; she can concede, tease, or let the grudge fade without always saying 'fine', 'forgiven', or 'apology'. One natural, short quip, not a speech. Do not turn this into ordinary angry dodging. ");
        else if(pool.Kind=="pet") text.Append("The USER pats Capri; Capri reacts to the pleasant pat with a short cheeky remark. No anger or accusation. Strongly prefer 4-7 words, but use more if needed. ");
        else if(pool.Kind=="refuse")
        {
            if(pool.Id=="Companion.DodgeLines" || pool.Id=="Companion.FirstDodgeLine")
                text.Append("The user has repeatedly thrown Capri around and tries to pick her up again. Capri refuses with short, irritated, playful banter about the USER's behavior. No contact happened. She need not explain her movement or mention the mouse. Do not announce her emotions. A rare teleport remark is okay, but most responses must not mention moving away. ");
            else if(pool.Id=="Companion.SulkLines")
                text.Append("Capri has been thrown repeatedly and refuses further rough handling, without narrating her mood or where she moves. ");
            else if(pool.Id=="Companion.AloneLines")
                text.Append("Capri has had time alone and is calming down; speak naturally without complaining about the cursor or escape movements. ");
            else text.Append("A brief, natural refusal about what happened. Do not invent grabbing, lifting, or held clothing. ");
        }
        else if(pool.Kind=="throw" || pool.Kind=="warn" || pool.Kind=="dizzy") text.Append("The USER threw Capri, and Capri knows that. Never ask who threw her, blame an unknown thrower, or speculate about the cause. React after landing. ");
        else if(pool.Kind=="gaming") text.Append("A quick game reaction, not an assessment of real life. ");
        else if(pool.Kind=="care") text.Append("A practical friendly reminder, not a diagnosed condition. ");
        else if(pool.Kind=="chess" || pool.Kind=="mini") text.Append("The result and player roles must match the confirmed situation. ");
        else if(pool.Kind=="task") text.Append("Keep the exact task state and user controls true. ");
        if(pool.IsGreeting)
        {
            int hour=DateTime.Now.Hour;
            string period=hour>=5&&hour<12?"morning":hour>=12&&hour<18?"afternoon":hour>=18&&hour<22?"evening":"night";
            text.Append("Time of day: ").Append(period).Append(". A normal friendly greeting, not a report on recent physical interactions. Do not mention throws, tossing, pets, reaching, dodges, retaliation or naps unless the user explicitly asked about them in the current conversation. ");
            string memory=greetingMemoryEnabled?ShortGreetingMemory():"";
            if(memory.Length>0)
            {
                text.Append("Optional verified user context (do not invent details): ").Append(memory).Append(". ");
                lastGreetingSource[pool.Id]="recent chat or memory note";
            }
            else lastGreetingSource[pool.Id]="none or disabled";
        }
        text.Append("Angle: ").Append(StyleFor(pool)).Append(". ");
        string sample=ReferenceLine(pool);
        if(sample.Length>0) text.Append("Capri's ORIGINAL tone reference (do not copy its wording): ").Append(sample).Append(". ");
        text.Append("Prefer four to seven natural spoken words; exceed that when needed for meaning. Use grammatical English, normal punctuation, no figurative comparisons or stage directions. ");
        text.Append("Do not use the invented nickname Choombatoo or the expression touché. Variations of choom are fine when pronounced with the long oo sound. Shorter is better. ");
        text.Append("Speak as yourself in the first person: say I, me and my. Never call yourself Capri, she or her. ");
        text.Append("Return only the spoken sentence.");
        return text.ToString();
    }
    private string ReferenceLine(Pool pool)
    {
        if(pool.Kind=="peace" || pool.Examples==null || pool.Examples.Length==0) return "";
        int start=(pool.Attempt+pool.UsedCount)%pool.Examples.Length;
        for(int i=0;i<pool.Examples.Length;i++)
        {
            string raw=pool.Examples[(start+i)%pool.Examples.Length];
            if(string.IsNullOrWhiteSpace(raw) || raw.Length>105) continue;
            if(Regex.IsMatch(raw,@"\b(?:paws?|chip|fool|groove|firmware|sulking)\b",RegexOptions.IgnoreCase)) continue;
            return Short(raw,90);
        }
        return "";
    }
    private string ShortGreetingMemory()
    {
        try
        {
            List<string> candidates=new List<string>();
            string last=host.Chat.LastHeard??"";
            if(last.Length>=8 && last.Length<=130)candidates.Add(last);
            string[] notes=host.Memory.Notes;
            if(notes!=null)
                for(int i=notes.Length-1;i>=0 && candidates.Count<3;i--)
                    if(!string.IsNullOrWhiteSpace(notes[i]) && notes[i].Length<=110)candidates.Add(notes[i]);
            foreach(string raw in candidates)
            {
                if(Regex.IsMatch(raw,@"\b(?:password|token|api key|private key|credit card|account number|secret|ssn|pin code|recovery code|throw|threw|toss|flung|pet|headpat|reach|dodge|cursor|mouse|teleport|shuffle|freeze|nap)\b",RegexOptions.IgnoreCase))continue;
                string clean=Regex.Replace(raw,@"[\r\n\t]+"," ").Trim();
                if(clean.Length>=8)return Short(clean,85);
            }
        }
        catch { }
        return "";
    }
    private void Generate(Pool pool)
    {
        if(generationPaused || inConversation || Voice()==null || generating) return;
        int worker=runId, chat=conversationId;
        pool.Attempt++;
        string instructions=EventPrompt(pool);
        string system="You are Capri, a quick-witted Windows desktop companion. Match the original Capri 0.9.0 banter, not romance or poetry. Prefer 4-7 natural spoken words (flexible, not mandatory); short, distinct and grammatically correct. You always speak in the first person as Capri and never describe yourself as Capri, she or her.";
        generating=true;
        currentPool=pool.Id;
        ThreadPool.QueueUserWorkItem(delegate
        {
            string result=null, problem=null;
            DateTime startedAt=DateTime.UtcNow;
            object model=null;
            try
            {
                model=MakeIsolatedBrain();
                lock(generationGate) isolated=model;
                if(worker!=runId || chat!=conversationId || inConversation) problem="cancelled conversation";
                else
                if(isolatedQuick!=null)
                    result=isolatedQuick.Invoke(model,new object[]{system,instructions,MaxTokenHint,false,null}) as string;
                if(problem==null && result==null && isolatedAside!=null && chat==conversationId && !inConversation)
                    result=isolatedAside.Invoke(model,new object[]{system,instructions,MaxTokenHint,false}) as string;
            }
            catch(TargetInvocationException e){ problem=(e.InnerException??e).Message; }
            catch(Exception e){ problem=e.Message; }
            finally { lock(generationGate) if(ReferenceEquals(isolated,model)) isolated=null; }
            double seconds=(DateTime.UtcNow-startedAt).TotalSeconds;
            if(window==null || window.IsDisposed || !window.IsHandleCreated)
            { generating=false; return; }
            try { window.BeginInvoke((Action)delegate { CompleteGenerated(pool,result,problem,seconds,worker,chat); }); }
            catch { generating=false; }
        });
    }
    private void CompleteGenerated(Pool pool,string result,string problem,double seconds,int worker,int chat)
    {
        try
        {
            if(!started || worker!=runId || chat!=conversationId || inConversation) return;
            latestTextTime=seconds.ToString("0.0")+"s";
            string line=CleanCandidate(result);
            bool relaxActive=pool.ActiveSoftRejects>=5;
            bool relaxQueued=pool.QueuedSoftRejects>=5;
            string reason=CheckLine(pool,line,false,relaxActive,relaxQueued);
            if(problem!=null || reason!=null)
            {
                rejectedCount++;
                pool.Failures++;
                if(reason=="same as active line")pool.ActiveSoftRejects++;
                if(reason=="same as queued alternative")pool.QueuedSoftRejects++;
                string detail=problem??reason;
                string closest=ClosestRejectedMatch(pool,line,reason);
                if(closest.Length>0)detail+=" | against: "+Short(closest,58);
                if(problem==null && line.Length>0)detail+=" | candidate: "+Short(line,65);
                if(pool.ActiveSoftRejects==5)Debug("RECOVERY ARMED",pool.Id,"5 active-line soft conflicts; next safe candidate may bypass active near-match");
                if(pool.QueuedSoftRejects==5)Debug("RECOVERY ARMED",pool.Id,"5 queued soft conflicts; next safe candidate may bypass queued near-match");
                int cooldown=TopicRetrySeconds(pool.Failures);
                if(pool.Failures==8 || pool.Failures==15)
                    Debug("POOL BACKOFF",pool.Id,pool.Failures+" rejected attempts; waiting "+cooldown+"s while other topics generate");
                Debug("REJECTED",pool.Id,Short(detail,185));
                lastError=Short(pool.Id+": "+detail,165);
                rejectionTrace.Enqueue(DateTime.Now.ToString("HH:mm:ss")+" | "+pool.Id+" | "+Short(detail,180));
                while(rejectionTrace.Count>100)rejectionTrace.Dequeue();
                pool.Retry=DateTime.UtcNow.AddSeconds(cooldown);
                return;
            }
            if(relaxActive || relaxQueued)
                Debug("RECOVERY ACCEPTED",pool.Id,(relaxActive?"active ":"")+(relaxQueued?"queue ":"")+"soft restriction bypass; exact and spoken checks passed");
            if(pool.Ready==null) pool.Ready=line;
            else if(pool.Reserve.Count<TargetLines(pool.Id)-1) pool.Reserve.Add(line);
            else return;
            pool.Retry=DateTime.MinValue;
            pool.ActiveSoftRejects=0;pool.QueuedSoftRejects=0;pool.Failures=0;
            generatedCount++;
            Debug("GENERATED",pool.Id,"#"+generatedCount+" "+Short(line,90));
            if(pool.IsGreeting && lastGreetingSource.ContainsKey(pool.Id))Debug("GREETING SOURCE",pool.Id,lastGreetingSource[pool.Id]);
            lastError=null;
            ApplySlot(pool);
            SaveLine(pool);
            if(pool.IsCheckIn) WriteCareOverlay();
            CallVoice("Prepare",line,pool.Id,pool.Group);
        }
        finally { generating=false; currentPool=null; }
    }
    private string ClosestRejectedMatch(Pool p,string candidate,string reason)
    {
        if(string.IsNullOrWhiteSpace(reason) || string.IsNullOrWhiteSpace(candidate))return "";
        if(reason=="same as active line")return p.Ready??"";
        if(reason=="same as queued alternative")
            foreach(string old in p.Reserve)if(Similar(old,candidate,p.Id))return old;
        return "";
    }
    private string CleanCandidate(string response)
    {
        if(string.IsNullOrWhiteSpace(response)) return "";
        string value=response.Trim();
        value=Regex.Replace(value,@"(?is)<think>.*?</think>"," ");
        value=Regex.Replace(value,@"(?m)^\s*(?:E\d+\s*:\s*|\d+[.)]\s*|[-*]\s*)","").Trim();
        if(value.IndexOf('\n')>=0) value=value.Split(new[]{'\n'},StringSplitOptions.RemoveEmptyEntries)[0].Trim();
        value=value.Trim('"','\'','`',' ','\r');
        if(value.StartsWith("CAPRI:",StringComparison.OrdinalIgnoreCase)) value=value.Substring(6).Trim();
        value=Regex.Replace(value,@"\b(?:chom|chum)\b",delegate(Match m)
        { return char.IsUpper(m.Value[0])?"Choom":"choom"; },RegexOptions.IgnoreCase);
        string who=UserName();
        value=Regex.Replace(value,@"\bthe users?\b",who,RegexOptions.IgnoreCase);
        value=Regex.Replace(value,@"\busers?\b",who,RegexOptions.IgnoreCase);
        if(value.Length>0 && value[value.Length-1]!='.' && value[value.Length-1]!='!' && value[value.Length-1]!='?')
            value+=".";
        return value;
    }
    private static bool TeleportMention(string line)
    {return !string.IsNullOrWhiteSpace(line) &&
        Regex.IsMatch(line,@"\bteleport(?:ed|ing|s)?\b",RegexOptions.IgnoreCase);}
    private bool TooManyTeleportLines(Pool pool,string text)
    {
        if(!TeleportMention(text) ||
           (pool.Id!="Companion.DodgeLines" && pool.Id!="Companion.FirstDodgeLine"))return false;
        foreach(string id in new[]{"Companion.DodgeLines","Companion.FirstDodgeLine"})
        {
            Pool related=Find(id);
            if(related!=null)
            {
                if(TeleportMention(related.Ready))return true;
                foreach(string line in related.Reserve)if(TeleportMention(line))return true;
            }
        }
        foreach(bool prior in recentReachTeleport)if(prior)return true;
        return false;
    }
    private string CheckLine(Pool pool,string text,bool validatingCurrent=false,bool relaxActive=false,bool relaxQueued=false)
    {
        if(string.IsNullOrWhiteSpace(text)) return "empty";
        int max=pool.Kind=="pet"||pool.Kind=="peace"?90:pool.Kind=="gaming"?85:pool.IsGreeting?110:pool.Kind=="refuse"?95:135;
        int maxWords=pool.Kind=="pet"||pool.Kind=="peace"?14:pool.Kind=="gaming"?14:pool.IsGreeting?18:22;
        if(text.Length>max+10 || Regex.Matches(text,@"[\p{L}\p{N}]+(?:['’][\p{L}]+)?").Count>maxWords+1) return "overlong";
        if(Regex.IsMatch(text,@"[\r\n]|[<>\[\]{}]|\b(?:i think to myself|she thinks|capri thinks|narrator|inner monologue)\b",RegexOptions.IgnoreCase)) return "not spoken dialogue";
        if(pool.IsGreeting && !Regex.IsMatch(pool.Event,@"greet",RegexOptions.IgnoreCase) && text.Length>95) return "long greeting";
        if((pool.Kind=="pet" || pool.Kind=="peace") && Regex.IsMatch(text,@"\b(?:that's rude|that is rude|how rude|stop (?:touching|petting|patting)|don't (?:touch|pet|pat) me|back off|quit (?:touching|petting)|leave me alone|no touching)\b",RegexOptions.IgnoreCase))return "petting response contradicts friendly pat";
        if((pool.Id=="Companion.DodgeLines" || pool.Id=="Companion.FirstDodgeLine") &&
           Regex.IsMatch(text,@"\b(?:upset|sulking|cursor|mouse pointer|running away|i (?:am|was) (?:dodging|teleporting))\b",RegexOptions.IgnoreCase))return "describes movement or mood instead of refusing";
        if(!validatingCurrent && TooManyTeleportLines(pool,text))return "teleport wording quota (one per six reach reactions)";
        if(Regex.IsMatch(text,@"\b(?:sulks|feels|wants)\b",RegexOptions.IgnoreCase) && Regex.IsMatch(text,@"\bI\s+(?:sulks|feels|wants)\b",RegexOptions.IgnoreCase)) return "grammar";
        if(Regex.IsMatch(text,@"\b(?:chip|paws|fool|tosser|chomsky|firmware|grooves?|tch)\b",RegexOptions.IgnoreCase)) return "wrong persona substitution";
        if(Regex.IsMatch(text,@"\b(?:choombatoo|chombatoo|touch[eé])\b",RegexOptions.IgnoreCase)) return "unwanted invented nickname or catchphrase";
        if((pool.Kind=="throw" || pool.Kind=="warn" || pool.Kind=="dizzy") &&
           Regex.IsMatch(text,@"\b(?:who (?:threw|tossed|launched)|what (?:threw|tossed) me|who did that|someone (?:threw|tossed) me)\b",RegexOptions.IgnoreCase))return "Capri already knows user threw her";
        if(pool.IsGreeting && Regex.IsMatch(text,@"\b(?:throw|threw|toss|tossing|flung|launched|dodge|teleport|cursor|headpat|petting|nap|shuffle|freeze)\b",RegexOptions.IgnoreCase))return "unrelated physical event in greeting";
        if(Regex.IsMatch(text,@"\b(?:it's like|as if|as though|as [a-z]+ as|feels like|seems like)\b",RegexOptions.IgnoreCase)) return "simile";
        if(Regex.IsMatch(text,@"\b(?:this time|i'm sulking|i am sulking|i sulk|fine pet me|sigh softly|softly sigh)\b",RegexOptions.IgnoreCase)) return "recycled template";
        string bridge=CallVoice("DialogueIssue",text,pool.Id) as string;
        if(!string.IsNullOrEmpty(bridge)) return bridge;
        if(IsGloballyExcluded(text) || HistoryContains(pool.Id,text)) return "already displayed, selected or spoken";
        if(!validatingCurrent && pool.Ready!=null)
        {
            if(Normalized(pool.Ready)==Normalized(text))return "exact duplicate of active line";
            if(!relaxActive && Similar(pool.Ready,text,pool.Id))return "same as active line";
        }
        foreach(string old in pool.Reserve)
        {
            if(Normalized(old)==Normalized(text))
            {
                if(!validatingCurrent)return "exact duplicate of queued alternative";
                continue;
            }
            if(!relaxQueued && Similar(old,text,pool.Id))return "same as queued alternative";
        }
        foreach(Pool p in pools)
        {
            if(p==pool || p.Group!=pool.Group)continue;
            if(p.Ready!=null && Similar(p.Ready,text,pool.Id))return "nearly same as cached";
            foreach(string old in p.Reserve)if(Similar(old,text,pool.Id))return "nearly same as queued";
        }
        return null;
    }
    private bool SafeForSpeaking(Pool pool,string line) { return CheckLine(pool,line,true)==null; }
    private bool Similar(string a,string b,string topic)
    {
        object result=CallVoice("NearRepeat",a,b,topic);
        if(result is bool) return (bool)result;
        return Normalized(a)==Normalized(b);
    }
    private bool HistoryContains(string topic,string text)
    {
        if(IsGloballyExcluded(text) || EverSpoken(topic,text))return true;
        Queue<string> recent;
        if(!history.TryGetValue(topic,out recent)) return false;
        foreach(string previous in recent) if(Similar(previous,text,topic)) return true;
        return false;
    }
    private void RememberSpoken(string topic,string text)
    {
        Queue<string> lines;
        if(!history.TryGetValue(topic,out lines)) { lines=new Queue<string>(); history[topic]=lines; }
        lines.Enqueue(text);
        while(lines.Count>HistoryLimit) lines.Dequeue();
        retired.Add(Normalized(text));
        retiredOrder.Enqueue(Normalized(text));
        while(retiredOrder.Count>CacheLimit) retired.Remove(retiredOrder.Dequeue());
        host.Store.Set("v2.history."+topic, string.Join("\u001F",lines.ToArray()));
        ArchiveSpoken(topic,text,true);
    }
    private string SpokenFolder()
    {
        return Path.Combine(host.Folder,"reaction-spoken-blacklists");
    }
    private string SpokenPath(string topic)
    {
        string filename=Regex.Replace(topic??"Unknown",@"[^A-Za-z0-9._-]","_");
        return Path.Combine(SpokenFolder(),filename+".txt");
    }
    private void ArchiveSpoken(string topic,string line,bool write)
    {
        if(string.IsNullOrWhiteSpace(topic)||string.IsNullOrWhiteSpace(line))return;
        string normalized=Normalized(line);
        if(normalized.Length==0)return;
        List<string> lines;
        HashSet<string> exact;
        if(!spokenArchive.TryGetValue(topic,out lines)) {lines=new List<string>();spokenArchive[topic]=lines;}
        if(!spokenExact.TryGetValue(topic,out exact)) {exact=new HashSet<string>(StringComparer.Ordinal);spokenExact[topic]=exact;}
        globalExcluded.Add(normalized);
        if(!exact.Add(normalized))return;
        lines.Add(line);
        Queue<string> near;
        if(!nearHistory.TryGetValue(topic,out near)){near=new Queue<string>();nearHistory[topic]=near;}
        near.Enqueue(line);
        while(near.Count>NearHistoryWindow)near.Dequeue();
        string signature=(CallVoice("FamilyKey",line,topic) as string)??"";
        if(signature.Length>0)
        {
            HashSet<string> known;
            if(!phraseKeys.TryGetValue(topic,out known)){known=new HashSet<string>(StringComparer.Ordinal);phraseKeys[topic]=known;}
            known.Add(signature);
        }
        if(write)
        {
            try
            {
                Directory.CreateDirectory(SpokenFolder());
                File.AppendAllText(SpokenPath(topic),line.Replace('\r',' ').Replace('\n',' ').Trim()+Environment.NewLine,new UTF8Encoding(false));
            }
            catch(Exception e) {lastError="Blacklisting: "+Short(e.Message,90);}
        }
    }
    private void LoadPermanentBlacklist()
    {
        foreach(Pool p in pools)
        {
            string file=SpokenPath(p.Id);
            try
            {
                if(File.Exists(file)) foreach(string line in File.ReadAllLines(file))ArchiveSpoken(p.Id,line,false);
            }
            catch(Exception e) {lastError="Read blacklist: "+Short(e.Message,90);}
            Queue<string> recent;
            if(history.TryGetValue(p.Id,out recent)) foreach(string line in recent)ArchiveSpoken(p.Id,line,true);
        }
    }
    private void ImportLegacyPreparedLines()
    {
        if(host.Store.Flag("v2.3.legacy-imported",false))return;
        foreach(Pool p in pools)
        {
            string old=host.Store.Get("v2.1.lines."+p.Id,"");
            foreach(string line in old.Split('\u001F'))if(!string.IsNullOrWhiteSpace(line))ArchiveSpoken(p.Id,line,true);
        }
        host.Store.Set("v2.3.legacy-imported",true);
    }
    private bool EverSpoken(string topic,string text)
    {
        if(string.IsNullOrWhiteSpace(text))return false;
        string normal=Normalized(text);
        if(globalExcluded.Contains(normal))return true;
        if(RelatedReachTopics(topic,"Companion.DodgeLines") || RelatedReachTopics(topic,"Companion.FirstDodgeLine"))
        {
            foreach(string other in new[]{"Companion.DodgeLines","Companion.FirstDodgeLine"})
            {
                HashSet<string> shownOther;
                if(shownExact.TryGetValue(other,out shownOther)&&shownOther.Contains(normal))return true;
                HashSet<string> spokenOther;
                if(spokenExact.TryGetValue(other,out spokenOther)&&spokenOther.Contains(normal))return true;
                Queue<string> previous;
                if(nearHistory.TryGetValue(other,out previous))
                    foreach(string old in previous)if(Similar(old,text,topic))return true;
            }
        }
        HashSet<string> shown;
        if(shownExact.TryGetValue(topic,out shown)&&shown.Contains(normal))return true;
        HashSet<string> exact;
        if(spokenExact.TryGetValue(topic,out exact)&&exact.Contains(normal))return true;
        string key=(CallVoice("FamilyKey",text,topic) as string)??"";
        HashSet<string> known;
        if(key.Length>0 && phraseKeys.TryGetValue(topic,out known) && known.Contains(key))return true;
        Queue<string> near;
        if(nearHistory.TryGetValue(topic,out near))
            foreach(string prior in near)if(Similar(prior,text,topic))return true;
        return false;
    }
    private void LoadHistory()
    {
        foreach(Pool p in pools)
        {
            string raw=host.Store.Get("v2.history."+p.Id,"");
            if(raw.Length==0) continue;
            Queue<string> q=new Queue<string>();
            foreach(string line in raw.Split('\u001F')) if(!string.IsNullOrWhiteSpace(line))
            {
                q.Enqueue(line);
                retired.Add(Normalized(line));
                retiredOrder.Enqueue(Normalized(line));
                while(q.Count>HistoryLimit) q.Dequeue();
            }
            history[p.Id]=q;
        }
    }
    private void SaveLine(Pool pool)
    {
        List<string> ready=new List<string>();
        if(pool.Ready!=null)ready.Add(pool.Ready);
        ready.AddRange(pool.Reserve);
        host.Store.Set("v2.3.lines."+pool.Id,string.Join("\u001F",ready.ToArray()));
        host.Store.Set("v2.3.slot."+pool.Id,pool.ActiveSlot);
    }
    private void LoadGenerated()
    {
        foreach(Pool p in pools)
        {
            string value=host.Store.Get("v2.3.lines."+p.Id,"");
            if(value.Length==0)continue;
            p.ActiveSlot=Math.Max(0,Math.Min(p.Slots.Length-1,(int)host.Store.Number("v2.3.slot."+p.Id,0)));
            foreach(string item in value.Split('\u001F'))
            {
                if(string.IsNullOrWhiteSpace(item))continue;
                string candidate=CleanCandidate(item);
                if(CheckLine(p,candidate)!=null)continue;
                if(p.Ready==null)p.Ready=candidate;
                else if(p.Reserve.Count<TargetLines(p.Id)-1)p.Reserve.Add(candidate);
                if(Enabled(p))CallVoice("Prepare",candidate,p.Id,p.Group);
                if(p.Reserve.Count>=TargetLines(p.Id)-1 && p.Ready!=null)break;
            }
            SaveLine(p);
            ApplySlot(p);
        }
    }
    private void RestoreAllNativeSlots(Pool p)
    {
        if(p==null || p.Synthetic || p.Slots==null || p.Originals==null)return;
        bool changed=false;
        for(int i=0;i<p.Slots.Length && i<p.Originals.Length;i++)
            if(p.Slots[i]!=p.Originals[i]){p.Slots[i]=p.Originals[i];changed=true;}
        if(changed)ClearNativePicker(p.Slots);
    }
    private void RestoreNativeLine(Pool pool,string generated)
    {
        if(pool.Synthetic || pool.Slots==null || generated==null || TakeoffPool(pool))return;
        for(int i=0;i<pool.Slots.Length;i++)
            if(pool.Slots[i]==generated)pool.Slots[i]=pool.Originals[i];
    }
    private void ApplySlot(Pool p)
    {
        if(p.Synthetic || p.Slots==null || p.Slots.Length==0)return;
        if(TakeoffPool(p)) { SyncTakeoffSilence(); return; }
        if(p.Group==Physical && !p.IsGreeting)
        {
            bool changed=false;
            for(int i=0;i<p.Slots.Length;i++)
                if(p.Slots[i]!=p.Originals[i]){p.Slots[i]=p.Originals[i];changed=true;}
            if(changed)ClearNativePicker(p.Slots);
            return;
        }
        if(!Enabled(p))return;
        if(p.Ready==null)
        {
            for(int i=0;i<p.Slots.Length;i++)p.Slots[i]=p.Originals[i];
            return;
        }
        if(p.IsGreeting)
        {
            int index=Math.Max(0,Math.Min(p.Slots.Length-1,GreetingSlot(p)));
            p.ActiveSlot=index;
            p.Slots[index]=p.Ready;
            return;
        }
        if(p.Group==Board || p.Group==Other)
        {
            List<string> distinct=new List<string>();
            if(p.Ready!=null && !IsGloballyExcluded(p.Ready))distinct.Add(p.Ready);
            foreach(string candidate in p.Reserve)
                if(!IsGloballyExcluded(candidate) && !distinct.Exists(x=>Normalized(x)==Normalized(candidate)))
                    distinct.Add(candidate);
            for(int i=0;i<p.Slots.Length;i++)p.Slots[i]=i<distinct.Count?distinct[i]:p.Originals[i];
            return;
        }
        for(int i=0;i<p.Slots.Length;i++)p.Slots[i]=p.Ready;
    }
    private int GreetingSlot(Pool p)
    {
        if(p.Slots.Length<3) return 0;
        int hour=DateTime.Now.Hour;
        return hour>=5 && hour<12?0:hour>=22 || hour<5?1:2;
    }
    private void RefreshSlots()
    {
        SyncTakeoffSilence();
        foreach(Pool p in pools)
        {
            if(p.IsGreeting && p.Ready!=null && GreetingSlot(p)!=p.ActiveSlot)
            {
                RestoreNativeLine(p,p.Ready);
                CallVoice("Retire",p.Ready);
                foreach(string old in p.Reserve)CallVoice("Retire",old);
                p.Reserve.Clear();
                p.Ready=null; SaveLine(p);
            }
            if(!Enabled(p))
            {
                RestoreAllNativeSlots(p);
                continue;
            }
            ApplySlot(p);
        }
    }

    private static string CareKey(string title) { return Regex.Replace(title??"",@"[\s-]+",""); }
    private void EnableCareOverlay()
    {
        if(!selections.Contains(Other) || companion==null) return;
        try
        {
            FieldInfo owner=companion.GetType().GetField("careLines",IF);
            careOwner=owner==null?null:owner.GetValue(companion);
            carePath=careOwner==null?null:careOwner.GetType().GetField("path",IF);
            originalCarePath=carePath==null?null:carePath.GetValue(careOwner) as string;
            if(originalCarePath==null || !File.Exists(originalCarePath)) return;
            overlayCarePath=Path.Combine(host.Folder,"v2-generated-care.md");
            ReadOriginalCare();
            WriteCareOverlay();
            carePath.SetValue(careOwner,overlayCarePath);
        }
        catch(Exception e) { host.Log("Care overlay stays native: "+Short(e.Message,100)); RestoreCareOverlay(); }
    }
    private void ReadOriginalCare()
    {
        careOriginal.Clear();
        if(originalCarePath==null || !File.Exists(originalCarePath)) return;
        string topic=null;
        foreach(string line in File.ReadAllLines(originalCarePath))
        {
            string t=line.Trim();
            if(t.StartsWith("## ",StringComparison.Ordinal))
            {
                topic=CareKey(t.Substring(3));
                if(!careOriginal.ContainsKey(topic)) careOriginal[topic]=new List<string>();
            }
            else if(topic!=null && t.StartsWith("- ",StringComparison.Ordinal) && t.Length>2)
                careOriginal[topic].Add(t.Substring(2).Trim());
        }
        careWriteTime=File.GetLastWriteTimeUtc(originalCarePath);
    }
    private void WriteCareOverlay()
    {
        if(overlayCarePath==null) return;
        string[] sections={"Water","Stretch","Look away","Sleep nudge","Meals","Game break","Bored","Bored noticed","Bored ignored"};
        StringBuilder output=new StringBuilder("# Generated overlay. Original Capri check-ins are unchanged.\n\n");
        careVisible.Clear();
        foreach(string title in sections)
        {
            output.Append("## ").Append(title).Append('\n');
            string key=CareKey(title);
            List<string> originals;
            if(!careOriginal.TryGetValue(key,out originals) || originals.Count==0)
            { output.Append('\n'); continue; }
            Pool pool=Find("Care."+key);
            string line=pool==null || !Enabled(pool) || pool.Ready==null?originals[0]:pool.Ready;
            careVisible[Normalized(line)]=key;
            output.Append("- ").Append(line).Append("\n\n");
        }
        try { Directory.CreateDirectory(Path.GetDirectoryName(overlayCarePath)); File.WriteAllText(overlayCarePath,output.ToString(),new UTF8Encoding(false)); }
        catch(IOException) { } catch(UnauthorizedAccessException) { }
    }
    private void UpdateCareIfChanged()
    {
        if(carePath==null || originalCarePath==null) return;
        try
        {
            if(File.Exists(originalCarePath) && File.GetLastWriteTimeUtc(originalCarePath)!=careWriteTime)
            { ReadOriginalCare(); WriteCareOverlay(); }
        }
        catch(IOException) { }
    }
    private void RestoreCareOverlay()
    {
        try { if(carePath!=null && careOwner!=null && originalCarePath!=null) carePath.SetValue(careOwner,originalCarePath); }
        catch { }
        careOwner=null; carePath=null;
    }

    private void SyncGameHook()
    {
        CallVoice("EnableBoardBridge",selections.Contains(Board));
        if(nativeGameAsk==null || nativeGameShow==null) return;
        if(gameHooked) return;
        try
        {
            oldGameAsk=nativeGameAsk.GetValue(null) as Delegate;
            oldGameShow=nativeGameShow.GetValue(null) as Delegate;
            if(oldGameAsk==null || oldGameShow==null) return;
            patchedGameAsk=GameAsk;
            patchedGameShow=GameShow;
            nativeGameAsk.SetValue(null,patchedGameAsk);
            nativeGameShow.SetValue(null,patchedGameShow);
            gameHooked=true;
        }
        catch(Exception e) { lastError="Gaming hook: "+Short(e.Message,90); RestoreGameHook(); }
    }
    private void RestoreGameHook()
    {
        if(!gameHooked) return;
        try
        {
            if(object.Equals(nativeGameAsk.GetValue(null),patchedGameAsk)) nativeGameAsk.SetValue(null,oldGameAsk);
            if(object.Equals(nativeGameShow.GetValue(null),patchedGameShow)) nativeGameShow.SetValue(null,oldGameShow);
        }
        catch { }
        gameHooked=false;
    }
    private static string GameKind(string input)
    {
        string s=(input??"").ToLowerInvariant();
        int end=s.IndexOf("\nlines in your style",StringComparison.Ordinal);
        if(end>=0) s=s.Substring(0,end);
        if(s.Contains("after dying") && s.Contains("took someone down")) return "Comebacks";
        if(s.Contains("in a row") && s.Contains("took someone down")) return "Streaks";
        if(s.Contains("took someone down")) return "Kills";
        if(s.Contains("ended their streak")) return "Ended";
        if(s.Contains("died again")) return "Again";
        if(s.Contains("just died")) return "Deaths";
        if(s.Contains("just won")) return "Wins";
        if(s.Contains("just lost")) return "Losses";
        if(s.Contains("unlocked something")) return "Unlocks";
        if(s.Contains("took a hit")) return "Hits";
        if(s.Contains("flashed bright")) return "Flashes";
        if(s.Contains("really loud")) return "Sounds";
        if(s.Contains("scene just changed")) return "Scenes";
        if(s.Contains("went dark")) return "Darks";
        return null;
    }
    private string GameAsk(string system,string query)
    {
        Pool p=Find("Gameplay."+GameKind(query));
        if(p!=null && Enabled(p) && p.Ready!=null && SafeForSpeaking(p,p.Ready)) return p.Ready;
        Func<string,string,string> former=oldGameAsk as Func<string,string,string>;
        return former==null?"":former(system,query);
    }
    private void RotateDisplayedGame(Pool selected,string line)
    {
        if(selected==null || selected.Ready==null || Normalized(selected.Ready)!=Normalized(line))return;
        selected.Ready=null;
        selected.UsedCount++;
        RestoreNativeLine(selected,line);
        while(selected.Reserve.Count>0)
        {
            int index=choiceDice.Next(selected.Reserve.Count);
            string next=selected.Reserve[index];selected.Reserve.RemoveAt(index);
            if(CheckLine(selected,next)==null){selected.Ready=next;break;}
        }
        ApplySlot(selected);SaveLine(selected);
        Debug("GAME SHOWN",selected.Id,Short(line,90));
    }

    private void GameShow(string line,bool fromBrain)
    {
        if(window==null || window.IsDisposed || !window.IsHandleCreated)return;
        try{window.BeginInvoke((Action)delegate
        {
            if(!started || nativeGameDisplay==null)return;
            Pool selected=null;
            foreach(Pool p in pools)
                if(p.IsGame && p.Ready!=null && Normalized(p.Ready)==Normalized(line))
                {selected=p;break;}
            bool fishReady=selected!=null && Voice()!=null && Voice().IsFishActive() &&
                !inConversation && !host.Chat.Busy && !host.Voice.Talking &&
                CallVoice("PreparedBytes",line) is byte[];
            object outcome=fishReady?CallVoice("PlayGameplay",line):null;
            bool played=outcome is bool && (bool)outcome;
            Action display=delegate
            {
                if(!started || nativeGameDisplay==null)return;
                Action<string> suppressNativeVoice=delegate(string ignored){};
                bool installed=false;
                try
                {
                    if(played && nativeGameTest!=null && nativeGameTest.GetValue(companion)==null)
                    {nativeGameTest.SetValue(companion,suppressNativeVoice);installed=true;}
                    nativeGameDisplay.Invoke(companion,new object[]{line,fromBrain});
                }
                catch(Exception e){lastError="Game display: "+Short(e.Message,110);}
                finally
                {
                    if(installed && object.Equals(nativeGameTest.GetValue(companion),suppressNativeVoice))
                        nativeGameTest.SetValue(companion,null);
                }
                if(!string.IsNullOrWhiteSpace(line) && transcriptMethod!=null &&
                   (Normalized(line)!=lastGameTranscript ||
                    (DateTime.UtcNow-lastGameTranscriptAt).TotalMilliseconds>300))
                {
                    lastGameTranscript=Normalized(line);lastGameTranscriptAt=DateTime.UtcNow;
                    try{transcriptMethod.Invoke(null,new object[]{"Capri",line,false});}
                    catch(Exception e){lastError="Game transcript: "+Short(e.Message,90);}
                }
                if(selected!=null)
                {
                    RememberShown(selected.Id,line);
                    RotateDisplayedGame(selected,line);
                }
            };
            if(played)
            {
                Debug("GAME FISH START",selected==null?"game":selected.Id,"Showing text 200 ms after audio | "+Short(line,80));
                host.Timers.After(0.2,display);
            }
            else
            {
                if(fishReady)Debug("GAME FISH FALLBACK",selected.Id,"Prepared WAV didn't play; native voice route retained");
                display();
            }
        });}catch{}
    }

    private static readonly Color Back=Color.FromArgb(18,16,25);
    private static readonly Color Fore=Color.FromArgb(233,236,243);
    private static readonly Color Cyan=Color.FromArgb(29,201,228);
    private static readonly Color Panel=Color.FromArgb(32,29,42);
    private sealed class CapriGauge : Control
    {
        private readonly System.Windows.Forms.Timer frames=new System.Windows.Forms.Timer();
        private const double Rest=15.0;
        private double time, spinAngle=Rest, gaze, lid;
        internal double Progress;
        internal string Status;
        internal bool Trouble;
        private readonly Font tag=new Font("Segoe UI",8.25f,FontStyle.Bold);
        private readonly Font note=new Font("Segoe UI",8f,FontStyle.Italic);
        private readonly StringFormat mid=new StringFormat();
        private readonly StringFormat side=new StringFormat();

        internal CapriGauge()
        {
            SetStyle(ControlStyles.AllPaintingInWmPaint|ControlStyles.UserPaint|
                     ControlStyles.OptimizedDoubleBuffer|ControlStyles.ResizeRedraw,true);
            mid.Alignment=StringAlignment.Center;mid.LineAlignment=StringAlignment.Center;
            side.Alignment=StringAlignment.Near;side.LineAlignment=StringAlignment.Center;
            frames.Interval=40;
            frames.Tick+=delegate{Step();Invalidate();};
            frames.Start();
        }
        private static double Ease(double x)
        {
            if(x<0)x=0; else if(x>1)x=1;
            return x*x*(3-2*x);
        }
        private void Step()
        {
            time+=0.04;
            if(time>=4.21)time-=4.21;
            double t=time;
            if(t<1.6){spinAngle=Rest-360.0*Ease(t/1.6);gaze=0;lid=0;}
            else if(t<2.1){spinAngle=Rest;gaze=-Ease((t-1.6)/0.5);lid=0;}
            else if(t<2.7){spinAngle=Rest;gaze=-1+2*Ease((t-2.1)/0.6);lid=0;}
            else if(t<2.95){spinAngle=Rest;gaze=1-Ease((t-2.7)/0.25);lid=0;}
            else if(t<3.07){spinAngle=Rest;gaze=0;lid=Ease((t-2.95)/0.12);}
            else if(t<4.07){spinAngle=Rest;gaze=0;lid=1;}
            else {spinAngle=Rest;gaze=0;lid=1-Ease((t-4.07)/0.14);}
        }
        protected override void OnPaint(PaintEventArgs e)
        {
            Graphics g=e.Graphics;
            g.SmoothingMode=System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
            int face=Math.Min(Height-4,66);
            if(face<14 || Width<70)return;
            Eye(g,new Rectangle(2,(Height-face)/2,face,face));
            int right=2+face+14, wide=Width-right-6;
            if(wide<=8)return;
            Bar(g,new Rectangle(right,Height/2-20,wide,18));
            if(string.IsNullOrEmpty(Status))return;
            using(SolidBrush ink=new SolidBrush(Trouble?Color.FromArgb(255,120,140):Color.FromArgb(150,165,180)))
                g.DrawString(Status,note,ink,new Rectangle(right,Height/2+4,wide,16),side);
        }
        private static readonly Color Shell=Color.FromArgb(3,245,109);
        private static readonly Color Socket=Color.FromArgb(6,10,8);
        private static readonly Color Rim=Color.FromArgb(0,150,70);
        private static readonly Color Deep=Color.FromArgb(0,16,48);
        private static readonly Color Iris=Color.FromArgb(2,87,231);
        private static readonly float[] EyeOpen={-0.663f,0.767f,-0.666f,0.360f,-0.581f,-0.004f,-0.394f,-0.251f,-0.375f,-0.449f,-0.682f,-0.549f,-0.727f,-0.760f,-0.505f,-0.728f,-0.362f,-0.604f,-0.190f,-0.523f,-0.010f,-0.759f,0.234f,-0.932f,0.572f,-1.000f,0.822f,-0.714f,0.812f,0.086f,0.486f,0.288f,0.455f,0.419f,0.636f,0.466f,0.591f,0.647f,0.401f,0.637f,0.336f,0.373f,0.153f,0.527f,-0.089f,0.639f,-0.503f,0.566f,-0.663f,0.767f};
        private static readonly float[] EyeShut={-0.987f,0.395f,-0.749f,0.142f,-0.453f,-0.055f,-0.105f,-0.188f,-0.004f,-0.322f,-0.292f,-0.553f,-0.189f,-0.716f,-0.040f,-0.611f,-0.005f,-0.389f,0.124f,-0.265f,0.442f,-0.183f,0.868f,-0.211f,0.998f,0.069f,0.846f,0.164f,0.507f,-0.036f,0.313f,0.085f,0.323f,0.250f,0.399f,0.363f,0.410f,0.524f,0.223f,0.421f,0.259f,0.097f,0.005f,0.069f,-0.350f,0.192f,-0.696f,0.252f,-0.987f,0.395f};
        private readonly PointF[] shape=new PointF[EyeOpen.Length/2];
        private readonly System.Drawing.Drawing2D.GraphicsPath socket=new System.Drawing.Drawing2D.GraphicsPath();
        private void Eye(Graphics g,Rectangle box)
        {
            float cx=box.Left+box.Width/2f, cy=box.Top+box.Height/2f, r=box.Width/2f-1;
            System.Drawing.Drawing2D.GraphicsState outer=g.Save();
            using(System.Drawing.Drawing2D.GraphicsPath clip=new System.Drawing.Drawing2D.GraphicsPath())
            {
                clip.AddEllipse(cx-r,cy-r,2*r,2*r);
                g.SetClip(clip);
                using(SolidBrush face=new SolidBrush(Shell))g.FillEllipse(face,cx-r,cy-r,2*r,2*r);
                g.TranslateTransform(cx,cy);
                g.RotateTransform((float)(spinAngle-2.0*Rest*lid));
                float k=r/1.07f, shut=(float)lid, open=1f-shut;
                for(int i=0;i<shape.Length;i++)
                {
                    int a=i*2;
                    shape[i]=new PointF((EyeOpen[a]*open+EyeShut[a]*shut)*k,
                                        (EyeOpen[a+1]*open+EyeShut[a+1]*shut)*k);
                }
                socket.Reset();
                socket.AddBeziers(shape);
                socket.CloseFigure();
                using(SolidBrush hole=new SolidBrush(Socket))g.FillPath(hole,socket);
                if(lid<0.995)
                {
                    int alpha=(int)(255*(1.0-lid));
                    if(alpha>255)alpha=255; else if(alpha<0)alpha=0;
                    // The socket is lopsided, so she can look further right than
                    // left before the iris would slide out onto her face.
                    float ox=(float)(gaze*r*(gaze>0?0.24:0.12));
                    float ir=0.288f*k, dr=ir*1.22f, pr=0.120f*k;
                    using(SolidBrush deep=new SolidBrush(Color.FromArgb(alpha,Deep)))
                        g.FillEllipse(deep,ox-dr,-dr,2*dr,2*dr);
                    using(SolidBrush iris=new SolidBrush(Color.FromArgb(alpha,Iris)))
                        g.FillEllipse(iris,ox-ir,-ir,2*ir,2*ir);
                    using(Pen edge=new Pen(Color.FromArgb(alpha,Rim),Math.Max(1f,r*0.05f)))
                        g.DrawEllipse(edge,ox-dr,-dr,2*dr,2*dr);
                    using(SolidBrush pupil=new SolidBrush(Color.FromArgb(alpha,255,255,255)))
                        g.FillEllipse(pupil,ox-pr,-pr,2*pr,2*pr);
                }
                g.ResetTransform();
            }
            g.Restore(outer);
            using(Pen edge=new Pen(Color.FromArgb(249,3,91),2f))g.DrawEllipse(edge,cx-r,cy-r,2*r,2*r);
        }
        private void Bar(Graphics g,Rectangle bar)
        {
            using(SolidBrush track=new SolidBrush(Color.FromArgb(32,29,42)))g.FillRectangle(track,bar);
            double value=Progress<0?0:Progress>1?1:Progress;
            int w=(int)Math.Round(bar.Width*value);
            if(w>0)
                using(System.Drawing.Drawing2D.LinearGradientBrush fill=
                    new System.Drawing.Drawing2D.LinearGradientBrush(bar,Cyan,Color.FromArgb(236,64,122),
                        System.Drawing.Drawing2D.LinearGradientMode.Horizontal))
                    g.FillRectangle(fill,bar.X,bar.Y,w,bar.Height);
            using(Pen edge=new Pen(Color.FromArgb(70,78,96),1f))
                g.DrawRectangle(edge,bar.X,bar.Y,bar.Width-1,bar.Height-1);
            string pct=((int)Math.Round(value*100))+"%";
            using(SolidBrush shade=new SolidBrush(Color.FromArgb(130,0,0,0)))
                g.DrawString(pct,tag,shade,new RectangleF(bar.X,bar.Y+1.5f,bar.Width,bar.Height),mid);
            using(SolidBrush ink=new SolidBrush(Color.White))
                g.DrawString(pct,tag,ink,bar,mid);
        }
        protected override void Dispose(bool disposing)
        {
            if(disposing){frames.Stop();frames.Dispose();socket.Dispose();tag.Dispose();note.Dispose();mid.Dispose();side.Dispose();}
            base.Dispose(disposing);
        }
    }
    private Control MakeOptions()
    {
        Panel pane=new Panel { Width=780, Height=305, BackColor=Back, ForeColor=Fore, AutoScroll=true };
        int y=16;
        AddSetting(pane,"Allow 5-second cursor lock (Esc releases)",cursorLock,y,delegate(bool value){cursorLock=value;SaveSettings();PrepareRetaliationAnnouncements();}); y+=55;
        AddSetting(pane,"Allow icon shuffle (restores after 10 seconds)",iconShuffle,y,delegate(bool value){iconShuffle=value;SaveSettings();PrepareRetaliationAnnouncements();}); y+=55;
        AddSetting(pane,"Enable Fish Audio emotion tags in synthesized audio",fishEmotions,y,delegate(bool value){fishEmotions=value;SaveSettings();}); y+=55;
        AddSetting(pane,"Show floating dialogue loading bar (bottom-right by default)",progressVisible,y,
            delegate(bool value){SetProgressVisible(value);}); y+=58;
        Label split=new Label{Left=18,Top=y,Width=700,Height=18,ForeColor=Cyan,
            Text="ADDITIONS",Font=new Font("Segoe UI",8.25f,FontStyle.Bold)}; pane.Controls.Add(split); y+=24;
        Button extras=new Button{Left=18,Top=y,Width=300,Height=34,Text="Choose what she generates...",
            FlatStyle=FlatStyle.Flat,ForeColor=Back,BackColor=Cyan};
        extras.Click+=delegate{ShowGroupPicker();};pane.Controls.Add(extras);
        Label aside=new Label{Left=330,Top=y+9,Width=420,Height=18,ForeColor=Color.FromArgb(150,165,180),
            Text="Extra AI lines. Anything off keeps her built-in ones."};
        pane.Controls.Add(aside); y+=48;
        if(!ShowAdvancedOptions){pane.Height=y+12;return pane;}
        Button inspect=new Button{Left=18,Top=y,Width=158,Height=34,Text="Reaction debugger",FlatStyle=FlatStyle.Flat,ForeColor=Back,BackColor=Cyan};
        inspect.Click+=delegate{ShowDebugger();};pane.Controls.Add(inspect);
        Button regenerate=new Button{Left=462,Top=y,Width=204,Height=34,Text="Regenerate one topic",FlatStyle=FlatStyle.Flat,ForeColor=Back,BackColor=Cyan};
        regenerate.Click+=delegate{ShowRegenerate();};pane.Controls.Add(regenerate);
        y+=43;
        Button controls=new Button{Left=18,Top=y,Width=215,Height=32,Text="Audio / cache maintenance",FlatStyle=FlatStyle.Flat,ForeColor=Back,BackColor=Cyan};
        controls.Click+=delegate{ShowCacheMaintenance();};pane.Controls.Add(controls);
        Button policy=new Button{Left=245,Top=y,Width=215,Height=32,Text="Test a dialogue line",FlatStyle=FlatStyle.Flat,ForeColor=Back,BackColor=Cyan};
        policy.Click+=delegate{ShowDialogueTest();};pane.Controls.Add(policy);
        Button memory=new Button{Left=475,Top=y,Width=235,Height=32,Text="Greeting memory: "+(greetingMemoryEnabled?"ON":"OFF"),FlatStyle=FlatStyle.Flat,ForeColor=Back,BackColor=Cyan};
        memory.Click+=delegate{ToggleGreetingMemory();memory.Text="Greeting memory: "+(greetingMemoryEnabled?"ON":"OFF");};pane.Controls.Add(memory);
        pane.Height=y+44;
        return pane;
    }
    private void SetGroupEnabled(string group,bool on)
    {
        if(selections.Contains(group)==on)return;
        Interlocked.Increment(ref conversationId);
        object active;
        lock(generationGate)active=isolated;
        if(active!=null && isolatedCancel!=null)try{isolatedCancel.Invoke(active,null);}catch{}
        if(on)
        {
            selections.Add(group);CallVoice("ReactivateGroup",group);
            // A newly switched-on group is a fresh build, so the bar earns another showing.
            firstFillDone=false;sawWork=false;progressDismissed=false;
            host.Store.Set("v2.9.first-fill",false);
        }
        else {selections.Remove(group);CallVoice("DiscardGroup",group);}
        SaveSettings();
        RefreshSlots();
        if(selections.Contains(Other))EnableCareOverlay(); else RestoreCareOverlay();
        SyncGameHook();
        PrepareExisting();
        Debug("GROUPS",group,on?"enabled":"disabled");
    }
    private void AddSetting(Control parent,string label,bool initial,int top,Action<bool> changed)
    {
        Label heading=new Label{Left=18,Top=top+8,Width=470,Height=32,Text=label,ForeColor=Fore};
        Button off=new Button { Left=555,Top=top,Width=78,Height=29,Text="OFF",FlatStyle=FlatStyle.Flat };
        Button on=new Button { Left=642,Top=top,Width=78,Height=29,Text="ON",FlatStyle=FlatStyle.Flat };
        Action<bool> paint=delegate(bool enabled)
        {
            on.BackColor=enabled?Cyan:Panel; on.ForeColor=enabled?Back:Fore;
            off.BackColor=!enabled?Color.FromArgb(229,50,80):Panel; off.ForeColor=!enabled?Back:Fore;
        };
        off.Click+=delegate { changed(false); paint(false); };
        on.Click+=delegate { changed(true); paint(true); };
        paint(initial);
        parent.Controls.Add(heading); parent.Controls.Add(off); parent.Controls.Add(on);
    }
    private void ShowGroupPicker()
    {
        if(!started || window==null || pickerWindow!=null) return;
        Form dlg=new Form{Text="Capri \u00b7 What she generates",Width=760,Height=372,BackColor=Back,ForeColor=Fore,
            FormBorderStyle=FormBorderStyle.FixedDialog,StartPosition=FormStartPosition.CenterParent,
            MinimizeBox=false,MaximizeBox=false};
        pickerWindow=dlg;
        Label note=new Label{Left=18,Top=14,Width=710,Height=40,ForeColor=Color.FromArgb(150,165,180),
            Text="These are additions, not settings. Switch one off and Capri keeps her own built-in lines for it, exactly as she shipped. Changes apply straight away."};
        dlg.Controls.Add(note);
        int y=60;
        AddSetting(dlg,"Physical reactions (pets, throws, dodges, greetings)",selections.Contains(Physical),y,
            delegate(bool value){SetGroupEnabled(Physical,value);}); y+=55;
        AddSetting(dlg,"Chess and minigame lines",selections.Contains(Board),y,
            delegate(bool value){SetGroupEnabled(Board,value);}); y+=55;
        AddSetting(dlg,"Quick gaming reactions (kills, deaths, wins)",selections.Contains(Gaming),y,
            delegate(bool value){SetGroupEnabled(Gaming,value);}); y+=55;
        AddSetting(dlg,"Check-ins, clones, Cyberpunk and task lines",selections.Contains(Other),y,
            delegate(bool value){SetGroupEnabled(Other,value);}); y+=58;
        Button done=new Button{Left=18,Top=y,Width=150,Height=32,Text="Done",FlatStyle=FlatStyle.Flat,
            BackColor=Cyan,ForeColor=Back};
        done.Click+=delegate{dlg.Close();};
        dlg.Controls.Add(done);
        dlg.FormClosed+=delegate { pickerWindow=null; dlg.Dispose(); };
        dlg.Show(window);
    }
    private void ToggleProgress() { SetProgressVisible(!progressVisible); }
    private void SetProgressVisible(bool value)
    {
        progressVisible=value;
        if(!value && progressAuto)progressDismissed=true;
        host.Store.Set("v2.progress-visible",value);
        if(value)OpenProgress();
        else if(statusWindow!=null && !statusWindow.IsDisposed)statusWindow.Close();
    }
    private void OpenProgress()
    {
        if(!started || window==null || window.IsDisposed)return;
        if(statusWindow!=null && !statusWindow.IsDisposed)
        {statusWindow.Show();statusWindow.BringToFront();return;}
        statusWindow=new Form {Text="Capri · AI dialogue",Width=300,Height=120,
            BackColor=Back,ForeColor=Fore,FormBorderStyle=FormBorderStyle.None,
            ShowInTaskbar=false,TopMost=true,StartPosition=FormStartPosition.Manual};
        int left=(int)host.Store.Number("v2.progress-x",-10000);
        int top=(int)host.Store.Number("v2.progress-y",-10000);
        if(left< -2000 || top< -2000 || !Screen.FromPoint(new Point(left+20,top+15)).WorkingArea.Contains(new Point(left+20,top+15)))
        {
            Rectangle bounds=Screen.FromControl(window).WorkingArea;
            left=bounds.Right-320;top=bounds.Bottom-140;
        }
        statusWindow.Location=new Point(left,top);
        Panel header=new Panel{Left=0,Top=0,Width=300,Height=27,BackColor=Panel};
        Label title=new Label{Left=12,Top=5,Width=240,Height=19,Text="CAPRI  ·  DIALOGUE",ForeColor=Cyan,
            Font=new Font("Segoe UI",9f,FontStyle.Bold)};
        Button close=new Button{Left=268,Top=2,Width=28,Height=23,Text="×",FlatStyle=FlatStyle.Flat,
            ForeColor=Fore,BackColor=Panel,TabStop=false};
        close.FlatAppearance.BorderSize=0;
        close.Click+=delegate {SetProgressVisible(false);};
        header.Controls.Add(title);header.Controls.Add(close);
        statusGauge=new CapriGauge{Left=10,Top=33,Width=280,Height=74,BackColor=Back};
        statusWindow.Controls.AddRange(new Control[]{header,statusGauge});
        foreach(Control control in new Control[]{statusWindow,header,title,statusGauge})
        {
            control.MouseDown+=ProgressMouseDown;
            control.MouseMove+=ProgressMouseMove;
            control.MouseUp+=ProgressMouseUp;
        }
        statusWindow.FormClosing+=delegate { SaveProgressPosition(); };
        statusWindow.FormClosed+=delegate
        {
            statusWindow=null;statusGauge=null;draggingProgress=false;
        };
        statusWindow.Show();
        UpdateProgress();
    }
    private void ProgressMouseDown(object sender,MouseEventArgs e)
    {
        if(statusWindow==null || e.Button!=MouseButtons.Left)return;
        draggingProgress=true;
        progressDragOffset=new Point(Cursor.Position.X-statusWindow.Left,Cursor.Position.Y-statusWindow.Top);
    }
    private void ProgressMouseMove(object sender,MouseEventArgs e)
    {
        if(statusWindow==null || !draggingProgress)return;
        statusWindow.Location=new Point(Cursor.Position.X-progressDragOffset.X,Cursor.Position.Y-progressDragOffset.Y);
    }
    private void ProgressMouseUp(object sender,MouseEventArgs e)
    {
        if(e.Button!=MouseButtons.Left)return;
        draggingProgress=false;
        SaveProgressPosition();
    }
    private void SaveProgressPosition()
    {
        if(statusWindow==null || statusWindow.IsDisposed || host==null)return;
        host.Store.Set("v2.progress-x",statusWindow.Left);
        host.Store.Set("v2.progress-y",statusWindow.Top);
    }
    private void UpdateProgress()
    {
        int made=0,total=0;
        foreach(Pool p in pools)if(Enabled(p))
        {
            total+=TargetLines(p.Id);
            if(p.Ready!=null)made++;
            made+=p.Reserve.Count;
        }
        AiReactionVoice engine=voiceEngine;
        bool fish=engine!=null && engine.IsFishActive();
        if(DateTime.UtcNow>=nextAudioCount)
        {
            nextAudioCount=DateTime.UtcNow.AddSeconds(1);
            int counted=0;
            if(fish)
                foreach(Pool p in pools)if(Enabled(p))
                {
                    if(p.Ready!=null && engine.PreparedBytes(p.Ready)!=null)counted++;
                    foreach(string line in p.Reserve)if(engine.PreparedBytes(line)!=null)counted++;
                }
            cachedWavCount=counted;
        }
        double done=total<=0?1.0:fish?(made+cachedWavCount)/(2.0*total):made/(double)total;
        if(done<0)done=0; else if(done>1)done=1;
        bool working=done<0.999 && !generationPaused;
        if(working)sawWork=true;
        // The bar shows itself for the one big fill and never again: a spoken line
        // is retired and refilled constantly, which would otherwise pop it up all day.
        if(progressVisible){progressAuto=false;if(statusWindow==null)OpenProgress();}
        else if(working && !firstFillDone && statusWindow==null && !progressSliding && !progressDismissed)
            {progressAuto=true;OpenProgress();}
        else if(!working && progressAuto && statusWindow!=null && !progressSliding)StartProgressSlide();
        if(!working)
        {
            progressDismissed=false;
            if(sawWork && !firstFillDone){firstFillDone=true;host.Store.Set("v2.9.first-fill",true);
                Debug("PROGRESS BAR",null,"first full build finished; it stays hidden now unless switched on");}
        }
        if(statusGauge==null || statusGauge.IsDisposed)return;
        statusGauge.Progress=done;
        statusGauge.Trouble=lastError!=null;
        statusGauge.Status=StatusLine(done);
    }
    private string StatusLine(double done)
    {
        if(lastError!=null)return Stuck[(int)((DateTime.UtcNow.Ticks/25000000L)%Stuck.Length)];
        if(generationPaused)return "Paused.";
        if(jobHeld)return "Waiting for her task to finish...";
        if(inConversation || host.Chat.Busy)return "Chatting first...";
        if(done>=0.999)return "All caught up.";
        return Patter[(int)((DateTime.UtcNow.Ticks/25000000L)%Patter.Length)];
    }
    private void StartProgressSlide()
    {
        if(statusWindow==null || statusWindow.IsDisposed || progressSliding)return;
        progressSliding=true;slidePhase=0;slideFrom=statusWindow.Left;
        if(slideTimer==null){slideTimer=new System.Windows.Forms.Timer{Interval=25};slideTimer.Tick+=SlideStep;}
        slideTimer.Start();
    }
    private void SlideStep(object sender,EventArgs args)
    {
        if(statusWindow==null || statusWindow.IsDisposed){EndSlide();return;}
        slidePhase+=0.06;
        if(slidePhase>=1)
        {
            Form closing=statusWindow;
            closing.Left=slideFrom;
            EndSlide();
            closing.Close();
            return;
        }
        int span=Screen.FromControl(statusWindow).WorkingArea.Right-slideFrom+60;
        statusWindow.Left=slideFrom+(int)(span*slidePhase*slidePhase);
    }
    private void EndSlide()
    {
        if(slideTimer!=null)slideTimer.Stop();
        progressSliding=false;progressAuto=false;
    }
    private void ToggleGenerationPause()
    {
        generationPaused=!generationPaused;
        host.Store.Set("v2.5.generation-paused",generationPaused);
        CallVoice("PauseGeneration",generationPaused);
        Debug("GENERATOR",null,generationPaused?"paused by user":"resumed by user");
    }
    private void ToggleGreetingMemory()
    {
        greetingMemoryEnabled=!greetingMemoryEnabled;
        host.Store.Set("v2.5.greeting-memory",greetingMemoryEnabled);
        Debug("GREETING MEMORY",null,greetingMemoryEnabled?"enabled":"disabled");
    }
    private void ShowDebugger()
    {
        if(debuggerWindow!=null && !debuggerWindow.IsDisposed){debuggerWindow.BringToFront();return;}
        Form dlg=new Form{Text="Capri · Reaction Debugger",Width=970,Height=630,BackColor=Back,ForeColor=Fore,
            StartPosition=FormStartPosition.CenterParent};
        TextBox log=new TextBox{Left=12,Top=12,Width=935,Height=525,Anchor=AnchorStyles.Top|AnchorStyles.Bottom|AnchorStyles.Left|AnchorStyles.Right,
            Multiline=true,ReadOnly=true,ScrollBars=ScrollBars.Both,WordWrap=false,Font=new Font("Consolas",9f),
            BackColor=Panel,ForeColor=Fore,Text=string.Join(Environment.NewLine,debuggerLog.ToArray())};
        debuggerText=log;debuggerWindow=dlg;
        Button copy=new Button{Text="Copy log",Left=12,Top=548,Width=140,Height=32,Anchor=AnchorStyles.Bottom|AnchorStyles.Left};
        copy.Click+=delegate{try{Clipboard.SetText(log.Text);}catch{}};
        Button export=new Button{Text="Export local log",Left=166,Top=548,Width=180,Height=32,Anchor=AnchorStyles.Bottom|AnchorStyles.Left};
        export.Click+=delegate{
            try
            {
                string file=Path.Combine(host.Folder,"reaction-debug-v25.txt");
                File.WriteAllText(file,log.Text,new UTF8Encoding(false));
                MessageBox.Show(dlg,"Saved in Capri's mod folder:\n"+file,"Reaction Debugger");
            }
            catch(Exception e){MessageBox.Show(dlg,e.Message,"Couldn't export");}
        };
        Button history=new Button{Text="Completed reaction history",Left=362,Top=548,Width=213,Height=32,Anchor=AnchorStyles.Bottom|AnchorStyles.Left};
        history.Click+=delegate{
            string file=Path.Combine(host.Folder,"reaction-delivery-history.tsv");
            try
            {
                if(!File.Exists(file)){MessageBox.Show(dlg,"No completed speech recorded yet.");return;}
                Form hist=new Form{Text="Capri · Completed reaction history",Width=980,Height=600,BackColor=Back};
                TextBox view=new TextBox{Dock=DockStyle.Fill,Multiline=true,ReadOnly=true,ScrollBars=ScrollBars.Both,
                    WordWrap=false,Font=new Font("Consolas",9f),BackColor=Panel,ForeColor=Fore,Text=File.ReadAllText(file)};
                hist.Controls.Add(view);hist.Show(dlg);
            }
            catch(Exception e){MessageBox.Show(dlg,e.Message,"History error");}
        };
        dlg.Controls.AddRange(new Control[]{log,copy,export,history});
        dlg.FormClosed+=delegate{debuggerWindow=null;debuggerText=null;dlg.Dispose();};
        dlg.Show(window);
    }
    private void RegenerateTopic(Pool p)
    {
        if(p==null || !Enabled(p))return;
        if(activeDelivery!=null && !activeDelivery.Committed && !activeDelivery.Cancelled && activeDelivery.Topic==p.Id)
        {lastError="Finish this reaction before regenerating its topic.";return;}
        Interlocked.Increment(ref conversationId);
        object active;lock(generationGate)active=isolated;
        if(active!=null && isolatedCancel!=null)try{isolatedCancel.Invoke(active,null);}catch{}
        List<string> old=new List<string>();
        if(p.Ready!=null)old.Add(p.Ready);
        old.AddRange(p.Reserve);
        foreach(string line in old){RestoreNativeLine(p,line);CallVoice("Retire",line);}
        p.Ready=null;p.Reserve.Clear();p.Retry=DateTime.MinValue;p.Attempt++;
        SaveLine(p);ApplySlot(p);if(p.IsCheckIn)WriteCareOverlay();
        lastError=null;
        Debug("REGENERATE",p.Id,"Cleared "+old.Count+" unspoken cached alternatives");
    }
    private void ShowRegenerate()
    {
        Form dlg=new Form{Text="Capri · Regenerate one reaction topic",Width=620,Height=540,
            BackColor=Back,ForeColor=Fore,StartPosition=FormStartPosition.CenterParent};
        Label help=new Label{Left=15,Top=14,Width=575,Height=45,
            Text="Select an enabled topic. This removes its unspoken generated lines and WAV cache; permanently spoken lines stay blacklisted."};
        ListBox topics=new ListBox{Left=15,Top=65,Width=575,Height=375,BackColor=Panel,ForeColor=Fore};
        foreach(Pool p in pools)if(Enabled(p))topics.Items.Add(p.Id);
        Button refresh=new Button{Left=15,Top=455,Width=200,Height=33,Text="Regenerate selected",BackColor=Cyan,ForeColor=Back};
        refresh.Click+=delegate{
            if(topics.SelectedItem==null)return;
            Pool p=Find(topics.SelectedItem.ToString());
            RegenerateTopic(p);
            if(p!=null)MessageBox.Show(dlg,lastError!=null&&lastError.StartsWith("Finish this reaction")?lastError:
                "Cleared "+p.Id+". New lines will refill in the background.","Regenerate topic");
            dlg.Close();
        };
        dlg.Controls.AddRange(new Control[]{help,topics,refresh});dlg.Show(window);
    }
    private void ShowCacheMaintenance()
    {
        Form dlg=new Form{Text="Capri · Audio/cache maintenance",Width=700,Height=340,
            BackColor=Back,ForeColor=Fore,StartPosition=FormStartPosition.CenterParent};
        TextBox report=new TextBox{Left=14,Top=14,Width=650,Height=150,BackColor=Panel,ForeColor=Fore,
            Multiline=true,ReadOnly=true,ScrollBars=ScrollBars.Vertical,Text=Convert.ToString(CallVoice("AudioStatus"))+Environment.NewLine+"WAV folder: "+Convert.ToString(CallVoice("AudioFolder"))};
        Button retry=new Button{Left=14,Top=180,Width=205,Height=36,Text="Retry failed Fish WAVs",BackColor=Cyan,ForeColor=Back};
        retry.Click+=delegate{CallVoice("RetryFailedAudio");report.Text=Convert.ToString(CallVoice("AudioStatus"))+Environment.NewLine+"WAV folder: "+Convert.ToString(CallVoice("AudioFolder"));};
        Button pause=new Button{Left=234,Top=180,Width=205,Height=36,Text=generationPaused?"Resume generation":"Pause generation",BackColor=Cyan,ForeColor=Back};
        pause.Click+=delegate{ToggleGenerationPause();pause.Text=generationPaused?"Resume generation":"Pause generation";};
        Button why=new Button{Left=454,Top=180,Width=210,Height=36,Text="Why is there no audio?",BackColor=Cyan,ForeColor=Back};
        why.Click+=delegate{
            string text=Convert.ToString(CallVoice("FishDiagnosis"));
            Form info=new Form{Text="Capri · Fish Audio check",Width=760,Height=470,BackColor=Back,ForeColor=Fore,
                StartPosition=FormStartPosition.CenterParent};
            TextBox view=new TextBox{Dock=DockStyle.Fill,Multiline=true,ReadOnly=true,ScrollBars=ScrollBars.Both,
                WordWrap=false,Font=new Font("Consolas",9f),BackColor=Panel,ForeColor=Fore,Text=text};
            info.Controls.Add(view);info.Show(dlg);
        };
        dlg.Controls.Add(why);
        Button clear=new Button{Left=14,Top=229,Width=235,Height=35,Text="Delete orphaned WAV/TXT",BackColor=Cyan,ForeColor=Back};
        clear.Click+=delegate{
            clear.Enabled=false;report.Text="Cleaning orphaned audio files...";
            ThreadPool.QueueUserWorkItem(delegate{
                object result=CallVoice("PurgeOrphaned");
                try{if(!dlg.IsDisposed)dlg.BeginInvoke((Action)delegate{
                    report.Text="Removed "+Convert.ToString(result)+" orphaned WAVs.\r\n"+Convert.ToString(CallVoice("AudioStatus"));
                    clear.Enabled=true;});}catch{}
            });
        };
        dlg.Controls.AddRange(new Control[]{report,retry,pause,clear});dlg.Show(window);
    }
    private void ShowDialogueTest()
    {
        Form dlg=new Form{Text="Capri · Dialogue quality test",Width=710,Height=315,
            BackColor=Back,ForeColor=Fore,StartPosition=FormStartPosition.CenterParent};
        ComboBox topics=new ComboBox{Left=15,Top=17,Width=650,Height=28,DropDownStyle=ComboBoxStyle.DropDownList};
        foreach(Pool p in pools)topics.Items.Add(p.Id);
        if(topics.Items.Count>0)topics.SelectedIndex=0;
        TextBox text=new TextBox{Left=15,Top=57,Width=650,Height=85,Multiline=true,BackColor=Panel,ForeColor=Fore};
        Label result=new Label{Left=15,Top=196,Width=640,Height=54,ForeColor=Fore};
        Button test=new Button{Left=15,Top=152,Width=200,Height=32,Text="Validate sentence",BackColor=Cyan,ForeColor=Back};
        test.Click+=delegate{
            Pool p=Find(Convert.ToString(topics.SelectedItem));
            if(p==null)return;
            string issue=CheckLine(p,CleanCandidate(text.Text));
            result.Text=issue==null?"PASS · Valid for this event and not in its active blacklist.":"REJECT · "+issue;
        };
        dlg.Controls.AddRange(new Control[]{topics,text,test,result});dlg.Show(window);
    }

    private void ShowHistory()
    {
        Form dlg=new Form{Text="Capri · Last five spoken lines per topic",Width=800,Height=620,BackColor=Back,ForeColor=Fore,StartPosition=FormStartPosition.CenterParent};
        TextBox details=new TextBox{Dock=DockStyle.Fill,Multiline=true,ScrollBars=ScrollBars.Vertical,ReadOnly=true,
            Font=new Font("Consolas",10f),BackColor=Panel,ForeColor=Fore};
        StringBuilder lines=new StringBuilder();
        foreach(Pool p in pools)
        {
            Queue<string> q;
            if(!history.TryGetValue(p.Id,out q) || q.Count==0) continue;
            lines.AppendLine(p.Id+":");
            foreach(string sentence in q)lines.AppendLine("  • "+sentence);
            lines.AppendLine();
        }
        details.Text=lines.Length>0?lines.ToString():"No generated reactions have been spoken yet.";
        dlg.Controls.Add(details);dlg.Show(window);
    }
    private void ShowPermanentBlacklists()
    {
        Form dlg=new Form{Text="Capri · Permanent reaction blacklists",Width=880,Height=650,
            BackColor=Back,ForeColor=Fore,StartPosition=FormStartPosition.CenterParent};
        TextBox details=new TextBox{Dock=DockStyle.Fill,Multiline=true,ScrollBars=ScrollBars.Both,ReadOnly=true,
            WordWrap=false,Font=new Font("Consolas",10f),BackColor=Panel,ForeColor=Fore};
        StringBuilder rows=new StringBuilder();
        foreach(Pool p in pools)
        {
            List<string> blocked;
            if(!spokenArchive.TryGetValue(p.Id,out blocked) || blocked.Count==0)continue;
            rows.Append(p.Id).Append(" (").Append(blocked.Count).AppendLine(" retired phrases):");
            foreach(string line in blocked)rows.Append("  ").AppendLine(line);
            rows.AppendLine();
        }
        details.Text=rows.Length==0?"No reactions archived yet.":rows.ToString();
        dlg.Controls.Add(details);
        dlg.Show(window);
    }
    private void ShowRejections()
    {
        Form dlg=new Form{Text="Capri · Recent generation rejections",Width=850,Height=530,
            BackColor=Back,ForeColor=Fore,StartPosition=FormStartPosition.CenterParent};
        TextBox log=new TextBox{Dock=DockStyle.Fill,Multiline=true,ReadOnly=true,ScrollBars=ScrollBars.Vertical,
            WordWrap=false,Font=new Font("Consolas",10f),BackColor=Panel,ForeColor=Fore};
        StringBuilder state=new StringBuilder("PER-TOPIC RETRY STATUS"+Environment.NewLine);
        foreach(Pool p in pools)if(p.Failures>0 || p.ActiveSoftRejects>0 || p.QueuedSoftRejects>0)
            state.Append(p.Id).Append(": failures ").Append(p.Failures)
                .Append(", active conflicts ").Append(p.ActiveSoftRejects).Append("/5")
                .Append(", queued conflicts ").Append(p.QueuedSoftRejects).Append("/5")
                .Append(", retry ").Append(Math.Max(0,(int)Math.Ceiling((p.Retry-DateTime.UtcNow).TotalSeconds)))
                .AppendLine("s");
        log.Text=state.ToString()+Environment.NewLine+"RECENT REJECTIONS"+Environment.NewLine+
            (rejectionTrace.Count==0?"No rejected candidates in this run.":string.Join(Environment.NewLine,rejectionTrace.ToArray()));
        dlg.Controls.Add(log);dlg.Show(window);
    }
    private static string Short(string text,int n)
    {
        if(text==null) return "";
        return text.Length<=n?text:text.Substring(0,n);
    }

    public bool Heard(string words) { return false; }
    public void Stop()
    {
        if(!started) return;
        started=false;
        runId++;
        Interlocked.Increment(ref conversationId);
        object active;
        lock(generationGate) active=isolated;
        if(active!=null && isolatedCancel!=null) try { isolatedCancel.Invoke(active,null); } catch { }
        if(timer!=null) { timer.Stop(); timer.Tick-=OnTick; timer.Dispose(); timer=null; }
        if(slideTimer!=null) { slideTimer.Stop(); slideTimer.Tick-=SlideStep; slideTimer.Dispose(); slideTimer=null; }
        if(host!=null)
        {
            host.Chat.Sending-=OnSending;
            host.Chat.Replied-=OnReplied;
            host.Chat.Replying-=OnReplying;
            host.Voice.Speaking-=OnSpeaking;
            host.Voice.Started-=OnVoiceStarted;
            if(speechBubble!=null)speechBubble.VisibleChanged-=OnBubbleVisible;
            host.Voice.Finished-=OnVoiceFinished;
        }
        CallVoice("RestoreBoardBridge");
        RestoreGameHook();
        RestoreCareOverlay();
        CallVoice("RestoreDesktopActions");
        foreach(Pool p in pools)RestoreAllNativeSlots(p);
        CallVoice("Suspend",true);
        if(voiceEngine!=null) { voiceEngine.Stop(); voiceEngine=null; }
        if(pickerWindow!=null) {pickerWindow.Close();pickerWindow=null;}
        if(debuggerWindow!=null) {debuggerWindow.Close();debuggerWindow=null;}
        if(statusWindow!=null) {statusWindow.Close();statusWindow=null;}
        pools.Clear();
        initialized=false;
        host=null;
        companion=null;
    }
}

internal sealed class AiReactionVoice
{
    public Action Requeue;
    public Action<string,string> Diagnostics;
    const BindingFlags IF=BindingFlags.Instance|BindingFlags.Public|BindingFlags.NonPublic;
    const BindingFlags SF=BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
    const int MaxReadyWavs=150;
    const long MaxReadyBytes=64L*1024*1024;
    sealed class Clip
    {
        internal string Text,Topic,Group,Key,Path;
        internal byte[] Wav;
        internal bool Queued,Working,Ready,Retired;
        internal int Failures;
        internal DateTime Retry,Verified;
    }
    readonly object gate=new object();
    readonly Dictionary<string,Clip> clips=new Dictionary<string,Clip>(StringComparer.Ordinal);
    readonly Queue<string> wanted=new Queue<string>();
    readonly Queue<string> urgent=new Queue<string>();
    readonly HashSet<string> urgentKeys=new HashSet<string>(StringComparer.Ordinal);
    readonly HashSet<string> knownFileKeys=new HashSet<string>(StringComparer.Ordinal);
    public Func<string,string> ResolveBoardTopic;
    FieldInfo nativeFreeSpeak, nativeChessBoard, nativeMiniTicket;
    Func<string,byte[]> previousFreeSpeak, boardFreeSpeak;
    readonly HashSet<string> pendingBoardDelivery=new HashSet<string>(StringComparer.Ordinal);
    bool boardBridgeEnabled;
    readonly object boardSynthesisGate=new object();
    readonly Queue<string> finishCleanup=new Queue<string>();
    readonly Queue<string> stalePaths=new Queue<string>();
    ICapriTimer tickTimer;
    readonly HashSet<string> retired=new HashSet<string>(StringComparer.Ordinal);
    readonly Dictionary<string,int> failures=new Dictionary<string,int>(StringComparer.Ordinal);
    readonly Dictionary<string,int> issueCounts=new Dictionary<string,int>(StringComparer.Ordinal);
    ICapriHost host;
    object companion;
    Form owner;
    MethodInfo pickVoice, synthesizeVoice, playReply, cancelReplyAudio, playGameplayVoice;
    MethodInfo voiceSeconds, voiceSpoken, typingSound, checkEars;
    FieldInfo replyText, answeringTicket, paceField, replyStart, clockField, voiceUntil;
    object synthLock=new object();
    bool active, paused, manuallyPaused, jobHold, emotionEnabled=true;
    int voiceBusy;
    string root, lastVoiceSignature="", lastVoiceError, lastVoiceTime="—";
    int runEpoch, generatedAudioCount, cacheHits;
    int audioKickScheduled;
    DateTime retryAudio=DateTime.MinValue, signatureCheck=DateTime.MinValue;
    int audioAttempts, audioFailures, voiceSelectFailures;
    int diagnosedOnce;
    string workerReason="Awaiting first accepted line", currentAudioTopic="";
    System.Windows.Forms.Timer typingDelay;
    int lastLeadTicket=-1;
    string lastLeadLine;
    string lastSynthProblem;
    public Func<string> CallerName=delegate{return "choom";};
    readonly Dictionary<string,List<Clip>> byText=new Dictionary<string,List<Clip>>(StringComparer.Ordinal);
    readonly Dictionary<string,DateTime> lastLog=new Dictionary<string,DateTime>(StringComparer.Ordinal);

    private void IndexClip(Clip clip)
    {
        List<Clip> list;
        if(!byText.TryGetValue(clip.Text,out list)){list=new List<Clip>();byText[clip.Text]=list;}
        if(!list.Contains(clip))list.Add(clip);
    }
    private void UnindexClip(Clip clip)
    {
        List<Clip> list;
        if(clip==null || !byText.TryGetValue(clip.Text,out list))return;
        list.Remove(clip);
        if(list.Count==0)byText.Remove(clip.Text);
    }

    public void Start(ICapriHost capri)
    {
        if(active) return;
        host=capri;
        owner=host.Ui.Window;
        root=Path.Combine(host.Folder,"prepared-voices");
        Directory.CreateDirectory(root);
        try {string file=Path.Combine(root,"known-audio-keys.txt");
            if(File.Exists(file))foreach(string key in File.ReadAllLines(file))
                if(!string.IsNullOrWhiteSpace(key))knownFileKeys.Add(key.Trim());}catch{}
        FieldInfo field=host.GetType().GetField("capri",IF);
        companion=field==null?null:field.GetValue(host);
        if(companion==null) throw new InvalidOperationException("Capri companion unavailable for reaction WAVs.");
        BindNativeVoice();
        emotionEnabled=true;
        active=true;
        voiceBusy=0;
        runEpoch++;
        RunSelfTests();
        host.Voice.Finished+=OnSpeechFinished;
        tickTimer=host.Timers.Every(0.35,Tick);
        host.Log("AI Reaction Voice v2 ready: Fish Audio generation is separate from the text AI queue.");
    }
    private void BindNativeVoice()
    {
        Type type=companion.GetType();
        pickVoice=type.GetMethod("PickVoice",IF,null,new[]{typeof(bool),typeof(Func<string,byte[]>).MakeByRefType(),typeof(bool)},null);
        synthesizeVoice=type.GetMethod("Voiced",IF,null,new[]{typeof(Func<string,byte[]>),typeof(Func<string,byte[]>),typeof(string),typeof(string).MakeByRefType(),typeof(bool)},null);
        if(pickVoice==null || synthesizeVoice==null)
            Report("audio_hook","Required Capri 0.9.0 PickVoice/Voiced method missing; WAV queue kept for retry");
        playReply=type.GetMethod("PlayReply",IF,null,new[]{typeof(string),typeof(byte[])},null);
        cancelReplyAudio=type.GetMethod("CancelAnswerAudio",IF,null,Type.EmptyTypes,null);
        playGameplayVoice=type.GetMethod("PlayVoice",IF,null,new[]{typeof(byte[])},null);
        nativeFreeSpeak=type.GetField("FreeSpeak",IF);
        nativeChessBoard=type.GetField("chess",IF);
        nativeMiniTicket=type.GetField("miniTicket",IF);
        boardFreeSpeak=BoardSpeech;
        replyText=type.GetField("reply",IF);
        answeringTicket=type.GetField("asking",IF);
        paceField=type.GetField("pace",IF);
        replyStart=type.GetField("replyStart",IF);
        clockField=type.GetField("clock",IF);
        voiceUntil=type.GetField("voiceUntil",IF);
        checkEars=type.GetMethod("CheckEars",IF,null,new[]{typeof(double),typeof(bool)},null);
        Type v=type.Assembly.GetType("CapriDesktop.Voice",false);
        if(v!=null)
        {
            voiceSeconds=v.GetMethod("Seconds",SF,null,new[]{typeof(byte[])},null);
            voiceSpoken=v.GetMethod("Spoken",SF,null,new[]{typeof(string)},null);
        }
        Type sfx=type.Assembly.GetType("CapriDesktop.Sfx",false);
        if(sfx!=null) typingSound=sfx.GetMethod("Type",SF,null,new[]{typeof(string),typeof(double),typeof(int)},null);
    }
    public void EnableBoardBridge(bool enabled)
    {
        boardBridgeEnabled=enabled;
        if(nativeFreeSpeak==null || companion==null)return;
        try
        {
            object current=nativeFreeSpeak.GetValue(companion);
            if(!enabled || !FishActive())
            {
                if(object.Equals(current,boardFreeSpeak))
                    nativeFreeSpeak.SetValue(companion,previousFreeSpeak);
                return;
            }
            if(object.Equals(current,boardFreeSpeak))return;
            previousFreeSpeak=current as Func<string,byte[]>;
            nativeFreeSpeak.SetValue(companion,boardFreeSpeak);
            ReportBoard("BRIDGE READY","ChessSay will use prepared Fish WAVs instead of Kokoro");
        }
        catch(Exception e){Report("board_hook",e.Message);}
    }
    private void ReportBoard(string stage,string detail)
    {
        if(Diagnostics!=null)Diagnostics(stage,"Chess / Minigames | "+detail);
    }
    private bool BoardIsOpen()
    {
        try {return nativeChessBoard!=null && nativeChessBoard.GetValue(companion)!=null;}
        catch{return false;}
    }
    private byte[] BoardSpeech(string spoken)
    {
        string line=replyText==null?null:replyText.GetValue(companion) as string;
        bool match=!string.IsNullOrWhiteSpace(line) &&
            string.Equals(NormalizeForBoard(NativeSpoken(line)),NormalizeForBoard(spoken),StringComparison.Ordinal);
        if(!boardBridgeEnabled || !active || !FishActive() || !BoardIsOpen())
            return previousFreeSpeak==null?null:previousFreeSpeak(spoken);
        string topic=match && ResolveBoardTopic!=null?ResolveBoardTopic(line):null;
        if(string.IsNullOrWhiteSpace(topic))topic=null;
        if(!match)line=spoken;
        byte[] ready=FindPrepared(line,topic);
        if(ValidWav(ready))
        {
            ReportBoard("BOARD WAV READY","Prepared Fish recording returned to chess worker | "+ShortForLog(line));
            ScheduleBoardDeliveryCheck(line,ready);
            return ready;
        }
        lock(boardSynthesisGate)
        {
            ready=FindPrepared(line,topic);
            if(ValidWav(ready)){ScheduleBoardDeliveryCheck(line,ready);return ready;}
            if(pickVoice==null || synthesizeVoice==null)return null;
            try
            {
                string selectionReason;
                Func<string,byte[]> fish=SelectFish(out selectionReason);
                if(fish==null){Report("board_fish",selectionReason??"Selected Fish voice unavailable");return null;}
                object[] call={fish,fish,DecorateForVoice(spoken,topic),null,false};
                byte[] wav;
                lock(synthLock)wav=synthesizeVoice.Invoke(companion,call) as byte[];
                if(!ValidWav(wav)){Report("board_fish","Fish failed to synthesize board dialogue");return null;}
                ReportBoard("BOARD FISH GENERATED","Fish synthesized; waiting for native playback ticket | "+ShortForLog(line));
                ScheduleBoardDeliveryCheck(line,wav);
                return wav;
            }
            catch(TargetInvocationException e){Report("board_fish",(e.InnerException??e).Message);return null;}
            catch(Exception e){Report("board_fish",e.Message);return null;}
        }
    }
    private void ScheduleBoardDeliveryCheck(string line,byte[] wav)
    {
        if(!active || !ValidWav(wav) || owner==null || owner.IsDisposed || !owner.IsHandleCreated)return;
        try
        {
            owner.BeginInvoke((Action)delegate
            {
                if(!active || replyText==null || answeringTicket==null)return;
                int ticket=Convert.ToInt32(answeringTicket.GetValue(companion));
                int boardTicket=nativeMiniTicket==null?-1:Convert.ToInt32(nativeMiniTicket.GetValue(companion));
                if(!string.Equals(replyText.GetValue(companion) as string,line,StringComparison.Ordinal))return;
                string key=ticket+"|"+boardTicket+"|"+NormalizeForBoard(line);
                if(!pendingBoardDelivery.Add(key))return;
                host.Timers.After(0.45,delegate
                {
                    pendingBoardDelivery.Remove(key);
                    if(!active || !FishActive() || paused || !BoardIsOpen() ||
                       !string.Equals(replyText.GetValue(companion) as string,line,StringComparison.Ordinal) ||
                       Convert.ToInt32(answeringTicket.GetValue(companion))!=ticket ||
                       (nativeMiniTicket!=null && Convert.ToInt32(nativeMiniTicket.GetValue(companion))!=boardTicket))return;
                    if(ActuallyPlayingVoice() || AudioHoldActive())return;
                    try
                    {
                        if(nativeMiniTicket!=null)nativeMiniTicket.SetValue(companion,boardTicket+1);
                        if(cancelReplyAudio!=null)cancelReplyAudio.Invoke(companion,null);
                        playReply.Invoke(companion,new object[]{line,wav});
                        ApplyGlobalSpeechLead(line);
                        ReportBoard("BOARD PLAYBACK RESCUED","Native ChessSay failed to start; prepared WAV played | "+ShortForLog(line));
                    }
                    catch(Exception e){Report("board_rescue",e.Message);}
                });
            });
        }
        catch(Exception e){Report("board_schedule",e.Message);}
    }
    private bool AudioHoldActive()
    {
        try
        {
            if(voiceUntil==null || clockField==null)return false;
            object clock=clockField.GetValue(companion);
            PropertyInfo elapsed=clock==null?null:clock.GetType().GetProperty("Elapsed",IF);
            return elapsed!=null && Convert.ToDouble(voiceUntil.GetValue(companion))>
                ((TimeSpan)elapsed.GetValue(clock,null)).TotalSeconds;
        }
        catch{return false;}
    }
    private static string NormalizeForBoard(string line)
    {return Regex.Replace((line??"").ToLowerInvariant(),@"[^\p{L}\p{Nd}]+"," ").Trim();}
    public void RestoreBoardBridge()
    {
        boardBridgeEnabled=false;
        if(nativeFreeSpeak==null || companion==null)return;
        try {if(object.Equals(nativeFreeSpeak.GetValue(companion),boardFreeSpeak))
            nativeFreeSpeak.SetValue(companion,previousFreeSpeak);}
        catch(Exception e){Report("board_restore",e.Message);}
    }
    public void SetEmotionEnabled(bool on)
    {
        if(emotionEnabled==on) return;
        emotionEnabled=on;
        InvalidatePreparedOnVoiceChange();
        if(Requeue!=null)Requeue();
    }
    public bool EmotionEnabled() { return emotionEnabled; }
    public bool IsFishActive() { return FishActive(); }
    public void Suspend(bool stop)
    {
        paused=stop;
        if(!stop)WakeAudioWorker();
    }
    private void OnSpeechFinished()
    {
        if(!active) return;
        SpeechFinished();
    }
    private void Tick()
    {
        if(!active) return;
        try
        {
            if(DateTime.UtcNow>=signatureCheck)
            {
                signatureCheck=DateTime.UtcNow.AddSeconds(15);
                string signature=VoiceSignature();
                if(lastVoiceSignature.Length==0) lastVoiceSignature=signature;
                else if(signature!=lastVoiceSignature)
                {
                    lastVoiceSignature=signature;
                    InvalidatePreparedOnVoiceChange();
                    if(Requeue!=null)Requeue();
                }
            }
            if(boardBridgeEnabled)EnableBoardBridge(true);
            if(!paused && !manuallyPaused && !jobHold) BeginNextSynthesis();
            FlushRetired();
        }
        catch(Exception e) { Report("timer",e.Message); }
    }

    public void Prepare(string text,string topic,string group) { PrepareAudio(text,topic,group,false); }
    public void PreparePriority(string text,string topic,string group) { PrepareAudio(text,topic,group,true); }
    private void PrepareAudio(string text,string topic,string group,bool priority)
    {
        if(!active || string.IsNullOrWhiteSpace(text)) return;
        if(!FishActive()) {workerReason="Fish not selected; awaiting voice settings";return;}
        string key=AudioKey(text,topic);
        Clip clip;
        lock(gate)
        {
            if(retired.Contains(key)) return;
            if(clips.TryGetValue(key,out clip))
            {
                if(clip.Ready || clip.Working || clip.Retired)return;
                if(clip.Queued){if(priority && urgentKeys.Add(clip.Key))urgent.Enqueue(clip.Key);
                WakeAudioWorker();return;}
                clip.Retry=DateTime.UtcNow;
            }
            else
            {
                clip=new Clip{Text=text,Topic=topic??"Other",Group=group??"other",Key=key,
                    Path=PreparedAudioPath(root,group,topic,text,key),Retry=DateTime.MinValue};
                clips.Add(key,clip);
                IndexClip(clip);
            }
            if(clips.Count>MaxReadyWavs*2) TrimMemoryCache();
            byte[] cached=ReadWav(clip.Path);
            if(cached!=null) {clip.Wav=cached;clip.Ready=true;clip.Verified=DateTime.UtcNow;IndexClip(clip);cacheHits++;
                if(Diagnostics!=null)Diagnostics("WAV HIT",clip.Topic+" | "+ShortForLog(text));return;}
            knownFileKeys.Remove(key);
            IndexClip(clip);
            clip.Queued=true;
            if(priority){if(urgentKeys.Add(key))urgent.Enqueue(key);}
            else wanted.Enqueue(key);
        }
        WakeAudioWorker();
    }
    private void WakeAudioWorker()
    {
        if(!active || paused || manuallyPaused || jobHold || host==null)return;
        if(Interlocked.CompareExchange(ref audioKickScheduled,1,0)!=0)return;
        try
        {
            Action wake=delegate {
                Interlocked.Exchange(ref audioKickScheduled,0);
                if(active && !paused && !manuallyPaused && !jobHold)BeginNextSynthesis();
            };
            if(owner!=null && !owner.IsDisposed && owner.IsHandleCreated && owner.InvokeRequired)
                owner.BeginInvoke(wake);
            else host.Timers.After(0.01,wake);
        }
        catch(Exception e){Interlocked.Exchange(ref audioKickScheduled,0);Report("audio_wake",e.Message);}
    }
    private Func<string,byte[]> SelectFish(out string reason)
    {
        reason=null;
        if(!FishActive()){reason="Fish Audio not selected";return null;}
        if(pickVoice==null || synthesizeVoice==null)
        {reason="Capri PickVoice/Voiced hook missing";return null;}
        try
        {
            object[] args={false,null,false};
            Func<string,byte[]> picked=pickVoice.Invoke(companion,args) as Func<string,byte[]>;
            Func<string,byte[]> free=args[1] as Func<string,byte[]>;
            if(picked==null){reason="Capri did not select a voice (silent, quiet, or voice error)";return null;}
            if(free==null){reason="Configured Fish server voice is unavailable";return null;}
            if(!object.Equals(picked,free))
                Report("fish_provider","Reaction audio uses configured Fish server voice, not Capri's other selected voice");
            return free;
        }
        catch(TargetInvocationException e){reason=(e.InnerException??e).Message;return null;}
        catch(Exception e){reason=e.Message;return null;}
    }
    private static int AudioRetrySeconds(int failures)
    {
        return 3;
    }
    private void RetryClip(Clip clip,string problem)
    {
        int seconds;
        lock(gate)
        {
            clip.Working=false;
            if(clip.Retired || !active)return;
            clip.Ready=false;
            clip.Failures=Math.Min(1000,clip.Failures+1);
            seconds=AudioRetrySeconds(clip.Failures);
            clip.Retry=DateTime.UtcNow.AddSeconds(seconds);
            if(!clip.Queued){clip.Queued=true;wanted.Enqueue(clip.Key);}
        }
        Interlocked.Increment(ref audioFailures);
        lastSynthProblem=problem;
        if(Interlocked.CompareExchange(ref diagnosedOnce,1,0)==0)ScheduleDiagnosis();
        workerReason="Retry in "+seconds+"s: "+ShortForLog(problem);
        if(Diagnostics!=null)
            Diagnostics("WAV FAILED",clip.Topic+" | attempt "+clip.Failures+" | retry in "+seconds+
                "s | "+(string.IsNullOrEmpty(problem)?"no reason reported":problem));
        Report("audio_retry",clip.Topic+" | "+workerReason);
    }
    private void BeginNextSynthesis()
    {
        if(!active || paused || manuallyPaused || jobHold)return;
        if(!FishActive()){workerReason="Fish Audio not selected";return;}
        if(DateTime.UtcNow<retryAudio)return;
        if(Interlocked.CompareExchange(ref voiceBusy,1,0)!=0)return;
        Clip clip=null;
        lock(gate)
        {
            int count=urgent.Count+wanted.Count;
            for(int i=0;i<count;i++)
            {
                bool high=urgent.Count>0;
                string key=high?urgent.Dequeue():wanted.Dequeue();
                if(high)urgentKeys.Remove(key);
                Clip next;
                if(!clips.TryGetValue(key,out next) || next.Retired)continue;
                if(next.Ready || next.Working || !next.Queued)continue;
                if(next.Retry>DateTime.UtcNow){wanted.Enqueue(key);continue;}
                clip=next;clip.Queued=false;clip.Working=true;break;
            }
        }
        if(clip==null)
        {
            Interlocked.Exchange(ref voiceBusy,0);
            if(PendingAudioCount()==0)workerReason="Idle — no WAV jobs pending";
            else workerReason="Waiting for next WAV retry";
            return;
        }
        string voiceProblem;
        Func<string,byte[]> selected=SelectFish(out voiceProblem);
        if(selected==null)
        {
            Interlocked.Increment(ref voiceSelectFailures);
            RetryClip(clip,voiceProblem??"Fish selection failed");
            Interlocked.Exchange(ref voiceBusy,0);
            retryAudio=DateTime.UtcNow.AddSeconds(2);
            return;
        }
        Clip task=clip;
        int requestEpoch=runEpoch;
        string spoken=DecorateForVoice(NativeSpoken(task.Text),task.Topic);
        currentAudioTopic=task.Topic;
        workerReason="Synthesizing "+task.Topic;
        Interlocked.Increment(ref audioAttempts);
        if(Diagnostics!=null)Diagnostics("WAV START",task.Topic+" | "+ShortForLog(task.Text));
        ThreadPool.QueueUserWorkItem(delegate
        {
            byte[] wav=null;
            string failure=null;
            DateTime start=DateTime.UtcNow;
            try
            {
                object[] parameters={selected,selected,spoken,null,false};
                lock(synthLock)wav=synthesizeVoice.Invoke(companion,parameters) as byte[];
                if(!ValidWav(wav))
                {
                    int size=wav==null?-1:wav.Length;
                    wav=null;
                    failure=Convert.ToString(parameters[3]);
                    if(string.IsNullOrWhiteSpace(failure))
                        failure=size<0?"Capri's Voiced() returned no audio and reported no reason"
                            :"Capri returned "+size+" bytes that are not a playable WAV";
                }
                if(!active || runEpoch!=requestEpoch || task.Retired)wav=null;
                if(wav!=null)
                {
                    lock(gate)
                    {
                        if(!task.Retired && active && runEpoch==requestEpoch)
                        {
                            Directory.CreateDirectory(Path.GetDirectoryName(task.Path));
                            File.WriteAllBytes(task.Path,wav);
                            File.WriteAllText(Path.ChangeExtension(task.Path,".txt"),task.Text,new UTF8Encoding(false));
                            if(ReadWav(task.Path)==null)throw new IOException("Saved WAV could not be verified");
                            task.Wav=wav;task.Ready=true;task.Failures=0;task.Verified=DateTime.UtcNow;
                            IndexClip(task);lastSynthProblem=null;
                            if(knownFileKeys.Add(task.Key))
                                try{File.AppendAllText(Path.Combine(root,"known-audio-keys.txt"),task.Key+Environment.NewLine);}catch{}
                            generatedAudioCount++;
                            workerReason="WAV ready: "+task.Topic;
                            if(Diagnostics!=null)Diagnostics("WAV READY",task.Topic+" | "+ShortForLog(task.Text));
                        }
                    }
                }
            }
            catch(TargetInvocationException e){failure=(e.InnerException??e).Message;}
            catch(Exception e){failure=e.Message;}
            finally
            {
                lastVoiceTime=(DateTime.UtcNow-start).TotalSeconds.ToString("0.0")+"s";
                if(!task.Ready && !task.Retired && active && runEpoch==requestEpoch)
                    RetryClip(task,failure??"Synthesized WAV not delivered");
                else {lock(gate)task.Working=false;}
                if(!string.IsNullOrEmpty(failure))Report("synth",failure);
                else if(task.Ready)lastVoiceError=null;
                Interlocked.Exchange(ref voiceBusy,0);
                currentAudioTopic="";
                WakeAudioWorker();
            }
        });
    }
    private static string ShortForLog(string text){return text==null?"":(text.Length<=85?text:text.Substring(0,85));}
    public void HoldForJob(bool hold)
    {
        if(jobHold==hold)return;
        jobHold=hold;
        workerReason=hold?"Holding while she works on a task":"Task finished, back to WAVs";
        if(!hold)WakeAudioWorker();
    }
    public void PauseGeneration(bool pause)
    {
        manuallyPaused=pause;
        workerReason=pause?"Manually paused":"Resumed background WAV synthesis";
        if(!pause)WakeAudioWorker();
    }
    public void RetryFailedAudio()
    {
        lock(gate)foreach(Clip clip in clips.Values)
        {
            if(clip.Retired||clip.Ready||clip.Working)continue;
            clip.Failures=0;clip.Retry=DateTime.MinValue;
            if(!clip.Queued){clip.Queued=true;wanted.Enqueue(clip.Key);}
        }
        retryAudio=DateTime.MinValue;
        workerReason="Manual retry requested";
        WakeAudioWorker();
    }
    public void DiscardGroup(string group)
    {
        lock(gate)foreach(Clip clip in clips.Values)
        {
            if(clip.Group!=group || clip.Retired)continue;
            clip.Retired=true;clip.Ready=false;clip.Wav=null;clip.Queued=false;
            retired.Add(clip.Key);
            finishCleanup.Enqueue(clip.Key);
        }
    }
    public void ReactivateGroup(string group)
    {
        lock(gate)
        {
            HashSet<string> restored=new HashSet<string>(StringComparer.Ordinal);
            foreach(Clip clip in clips.Values)
            {
                if(clip.Group!=group || !clip.Retired)continue;
                clip.Retired=false;clip.Ready=false;clip.Wav=null;clip.Failures=0;
                clip.Retry=DateTime.MinValue;
                retired.Remove(clip.Key);restored.Add(clip.Key);
                if(!clip.Queued && !clip.Working){clip.Queued=true;wanted.Enqueue(clip.Key);}
            }
            if(restored.Count>0)
            {
                Queue<string> remaining=new Queue<string>();
                while(finishCleanup.Count>0)
                {
                    string key=finishCleanup.Dequeue();
                    if(!restored.Contains(key))remaining.Enqueue(key);
                }
                while(remaining.Count>0)finishCleanup.Enqueue(remaining.Dequeue());
            }
        }
    }

    public int PurgeOrphaned()
    {
        if(host==null || host.Voice.Talking)return 0;
        HashSet<string> protectedPaths=new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        int known;
        lock(gate)
        {
            known=clips.Count;
            foreach(Clip clip in clips.Values)if(!clip.Retired)protectedPaths.Add(clip.Path);
        }
        if(known==0)
        {
            Report("purge_skipped","No prepared clips are registered yet, so the WAV cache was left alone");
            return 0;
        }
        int removed=0;
        try
        {
            foreach(string wav in Directory.GetFiles(root,"*.wav",SearchOption.AllDirectories))
            {
                if(protectedPaths.Contains(wav) || (host!=null && host.Voice.Talking))continue;
                try
                {
                    File.Delete(wav);removed++;
                    string matching=Path.ChangeExtension(wav,".txt");
                    if(File.Exists(matching))File.Delete(matching);
                }
                catch(IOException){}catch(UnauthorizedAccessException){}
            }
            foreach(string txt in Directory.GetFiles(root,"*.txt",SearchOption.AllDirectories))
            {
                if(string.Equals(Path.GetFileName(txt),"known-audio-keys.txt",StringComparison.OrdinalIgnoreCase))continue;
                if(protectedPaths.Contains(Path.ChangeExtension(txt,".wav")) || (host!=null&&host.Voice.Talking))continue;
                try{File.Delete(txt);}catch(IOException){}catch(UnauthorizedAccessException){}
            }
        }
        catch(IOException){}catch(UnauthorizedAccessException){}
        return removed;
    }

    public string AudioFolder() { return root??""; }
    public int PendingAudioCount()
    {
        int count=0;
        lock(gate)foreach(Clip c in clips.Values)
            if(!c.Retired && (c.Queued || c.Working))count++;
        return count;
    }
    private void InvalidatePreparedOnVoiceChange()
    {
        lock(gate)
        {
            foreach(Clip clip in clips.Values)
            {
                clip.Retired=true;
                stalePaths.Enqueue(clip.Path);
            }
            wanted.Clear();urgent.Clear();urgentKeys.Clear();
            clips.Clear();
            byText.Clear();
            retired.Clear();
            finishCleanup.Clear();
        }
    }
    private void TrimMemoryCache()
    {
        long total=0;
        foreach(Clip clip in clips.Values) if(clip.Wav!=null)total+=clip.Wav.Length;
        if(total<=MaxReadyBytes) return;
        foreach(Clip clip in clips.Values)
        {
            if(clip.Working || clip.Retired || clip.Wav==null) continue;
            total-=clip.Wav.Length;clip.Wav=null;
            if(total<MaxReadyBytes/2)break;
        }
    }
    public void Retire(string line)
    {
        if(string.IsNullOrWhiteSpace(line))return;
        if(line=="Next time, I'll freeze your cursor." ||
           line=="Next time, I'll shuffle your desktop icons.")return;
        lock(gate)
        {
            foreach(Clip c in clips.Values)
            {
                if(!string.Equals(c.Text,line,StringComparison.Ordinal))continue;
                c.Retired=true;
                c.Ready=false;
                c.Wav=null;
                c.Queued=false;
                retired.Add(c.Key);
                finishCleanup.Enqueue(c.Key);
            }
        }
        if(host!=null && !host.Voice.Talking)FlushRetired();
    }
    public void SpeechFinished()
    {
        FlushRetired();
    }
    private void FlushRetired()
    {
        if(host!=null && host.Voice.Talking)return;
        List<Clip> deleting=new List<Clip>();
        lock(gate)
        {
            while(finishCleanup.Count>0)
            {
                string key=finishCleanup.Dequeue();
                Clip clip;
                if(!clips.TryGetValue(key,out clip))continue;
                if(clip.Working) {finishCleanup.Enqueue(key);break;}
                deleting.Add(clip);
                clips.Remove(key);
                UnindexClip(clip);
            }
        }
        lock(gate)
        {
            while(stalePaths.Count>0)
                deleting.Add(new Clip{Path=stalePaths.Dequeue()});
        }
        foreach(Clip clip in deleting)
        {
            try {if(File.Exists(clip.Path))File.Delete(clip.Path);}catch(IOException){}
            catch(UnauthorizedAccessException){}
            try {string matching=Path.ChangeExtension(clip.Path,".txt");if(File.Exists(matching))File.Delete(matching);}catch(IOException){}
            catch(UnauthorizedAccessException){}
        }
    }
    public string PreparedAudioPath(string folder,string group,string topic,string spoken,string digest)
    {
        string groupFolder=group=="physical"?"Physical Interactions":group=="board"?"Chess and Minigames":group=="gaming"?"Quick Gaming":"Other Reactions";
        string sub=topic??"Misc";
        int dot=sub.IndexOf('.');if(dot>=0)sub=sub.Substring(dot+1);
        sub=CleanFilePart(sub,36);
        string readable=CleanFilePart(spoken,72);
        string suffix=digest??"";
        if(suffix.Length>10)suffix=suffix.Substring(0,10);
        return Path.Combine(folder,groupFolder,sub,readable+" - "+suffix+".wav");
    }
    private static string CleanFilePart(string text,int limit)
    {
        if(string.IsNullOrWhiteSpace(text))return "Untitled";
        string clean=Regex.Replace(text,@"[<>:""/\\|?*\x00-\x1F]"," ");
        clean=Regex.Replace(clean,@"\s+"," ").Trim().TrimEnd('.',' ');
        if(clean.Length>limit)clean=clean.Substring(0,limit).Trim().TrimEnd('.');
        return clean.Length==0?"Untitled":clean;
    }
    private string AudioKey(string words,string topic)
    {
        string state=VoiceSignature();
        string value=(topic??"")+"|"+words+"|"+state+"|"+
            (emotionEnabled?EmotionFor(topic,words):"plain");
        using(SHA256 hash=SHA256.Create())
        {
            byte[] bytes=hash.ComputeHash(Encoding.UTF8.GetBytes(value));
            StringBuilder sb=new StringBuilder();for(int i=0;i<6;i++)sb.Append(bytes[i].ToString("X2"));
            return sb.ToString();
        }
    }
    private string VoiceSignature()
    {
        if(companion==null)return "none";
        try
        {
            StringBuilder raw=new StringBuilder();
            FieldInfo field=companion.GetType().GetField("preferences",IF);
            object pref=field==null?null:field.GetValue(companion);
            if(pref==null)return "none";
            foreach(string name in new[]{"ServerVoice","ServerApi","ServerModel","ServerSpeaker","ServerUrl","ServerKey","VoicePitch","VoiceSpeed","VoiceRobot","VoiceGlitch","AsideSpeaker"})
            {
                FieldInfo f=pref.GetType().GetField(name,IF);
                if(f!=null)raw.Append(name).Append(':').Append(f.GetValue(pref)).Append(';');
            }
            using(SHA256 sha=SHA256.Create())return Convert.ToBase64String(sha.ComputeHash(Encoding.UTF8.GetBytes(raw.ToString())));
        }
        catch{return "unknown";}
    }
    private bool FishActive()
    {
        if(companion==null)return false;
        try
        {
            FieldInfo f=companion.GetType().GetField("preferences",IF);
            object pref=f==null?null:f.GetValue(companion);
            if(pref==null)return false;
            FieldInfo on=pref.GetType().GetField("ServerVoice",IF);
            FieldInfo api=pref.GetType().GetField("ServerApi",IF);
            return on!=null && Convert.ToBoolean(on.GetValue(pref)) &&
                api!=null && string.Equals(Convert.ToString(api.GetValue(pref)),"Fish",StringComparison.OrdinalIgnoreCase);
        }
        catch{return false;}
    }
    private string NativeSpoken(string line)
    {
        if(voiceSpoken==null)return line;
        try {return voiceSpoken.Invoke(null,new object[]{line}) as string??line;}
        catch{return line;}
    }
    private static bool ValidWav(byte[] bytes)
    {
        return bytes!=null&&bytes.Length>=44&&bytes.Length<=4*1024*1024&&
            bytes[0]==82&&bytes[1]==73&&bytes[2]==70&&bytes[3]==70&&
            bytes[8]==87&&bytes[9]==65&&bytes[10]==86&&bytes[11]==69;
    }
    private static byte[] ReadWav(string filename)
    {
        try
        {
            FileInfo file=new FileInfo(filename);
            if(!file.Exists||file.Length<44||file.Length>4*1024*1024)return null;
            byte[] bytes=File.ReadAllBytes(filename);
            return ValidWav(bytes)?bytes:null;
        }
        catch(IOException){return null;}
        catch(UnauthorizedAccessException){return null;}
        catch(ArgumentException){return null;}
    }
    private byte[] FindPrepared(string text,string topic=null)
    {
        if(string.IsNullOrEmpty(text))return null;
        bool requeue=false;
        byte[] result=null;
        DateTime now=DateTime.UtcNow;
        lock(gate)
        {
            List<Clip> candidates;
            if(!byText.TryGetValue(text,out candidates))return null;
            for(int i=0;i<candidates.Count;i++)
            {
                Clip clip=candidates[i];
                if(clip.Retired || !clip.Ready || (topic!=null && clip.Topic!=topic))continue;
                if(clip.Wav==null || (now-clip.Verified).TotalSeconds>=5)
                {
                    if(!File.Exists(clip.Path) || !File.Exists(Path.ChangeExtension(clip.Path,".txt")))
                    {
                        clip.Ready=false;clip.Wav=null;clip.Failures=0;clip.Retry=DateTime.MinValue;
                        knownFileKeys.Remove(clip.Key);
                        if(!clip.Queued && !clip.Working){clip.Queued=true;wanted.Enqueue(clip.Key);requeue=true;}
                        continue;
                    }
                    clip.Verified=now;
                }
                byte[] stored=clip.Wav??ReadWav(clip.Path);
                if(ValidWav(stored)){clip.Wav=stored;result=stored;break;}
                clip.Ready=false;clip.Wav=null;clip.Failures=0;clip.Retry=DateTime.MinValue;
                knownFileKeys.Remove(clip.Key);
                if(!clip.Queued && !clip.Working){clip.Queued=true;wanted.Enqueue(clip.Key);requeue=true;}
            }
        }
        if(requeue)WakeAudioWorker();
        return result;
    }

    private void Report(string label,string message)
    {
        string detail=string.IsNullOrEmpty(message)?"unknown":message;
        lastVoiceError=label+": "+detail;
        if(host==null)return;
        if(Diagnostics!=null)Diagnostics("AUDIO "+label.ToUpperInvariant(),detail);
        DateTime last;
        string stamp=label+"\u001F"+detail;
        lock(lastLog)
        {
            if(lastLog.TryGetValue(stamp,out last) && (DateTime.UtcNow-last).TotalSeconds<20)return;
            if(lastLog.Count>400)lastLog.Clear();
            lastLog[stamp]=DateTime.UtcNow;
        }
        try{host.Log("AI Reaction Voice "+label+": "+(detail.Length>150?detail.Substring(0,150):detail));}catch{}
    }

    public string DecorateForVoice(string plain,string topic)
    {
        if(string.IsNullOrWhiteSpace(plain) || !emotionEnabled || !FishActive())return plain;
        if(Regex.IsMatch(plain,@"^\s*\[[a-z]+\]",RegexOptions.IgnoreCase))return plain;
        string emotion=EmotionFor(topic,plain);
        return emotion.Length==0?plain:"["+emotion+"] "+plain;
    }
    private string EmotionFor(string topic,string text)
    {
        string id=(topic??"").ToLowerInvariant(),t=(text??"").ToLowerInvariant();
        if(id=="chess.lost" || id=="chess.her_queen" || id=="chess.her_check" ||
           id=="mini.losses" || id=="gameplay.losses" ||
           id=="gameplay.deaths" || id=="gameplay.again")
            return id=="chess.her_check" || id=="chess.her_queen"?"surprised":"disappointed";
        if(id=="chess.won" || id=="chess.your_queen" || id=="mini.wins" ||
           id=="gameplay.wins" || id=="gameplay.kills" || id=="gameplay.unlocks")return "excited";
        if(id=="chess.draw" || id=="mini.draws")return "";
        if(id=="chess.blunder")return "surprised";
        if(id=="chess.your_check")return "confident";
        if(id=="chess.resign")return "";
        if(Regex.IsMatch(t,@"\b(?:thank you|thanks|appreciate)\b"))return "grateful";
        if(Regex.IsMatch(t,@"\b(?:sorry|apologize|regret|forgive)\b"))return "regretful";
        if(Regex.IsMatch(t,@"\b(?:seriously|again\?|enough|not happening|leave me be)\b") &&
           (id.Contains("dodge")||id.Contains("warn")||id.Contains("sulk")))return "upset";
        if(Regex.IsMatch(t,@"\b(?:ha ha|haha|hehe|heh|cute|nice|bribe)\b") &&
           (id.Contains("pet")||id.Contains("patpeace")))return "delighted";
        if((id.Contains("pet")||id.Contains("patpeace")) &&
           Regex.IsMatch(t,@"\b(?:bold|deal|nice try|permission|allowed|confident|clever)\b"))return "confident";
        if(id.Contains("pet")||id.Contains("patpeace"))return "delighted";
        if(id.Contains("warn")||id.Contains("sulk")||id.Contains("dodge"))return "upset";
        if(id.Contains("throw")||id.Contains("dizzy"))return "surprised";
        if(id.Contains("greet")||id.Contains("pop"))return "excited";
        if(id.Contains("chess"))return "confident";
        if(id.Contains("wins")||id.Contains("unlocks"))return "excited";
        if(id.Contains("losses")||id.Contains("deaths"))return "disappointed";
        if(Regex.IsMatch(t,@"\b(?:great|awesome|yes|nice job)\b"))return "excited";
        return "";
    }
    public byte[] PreparedBytes(string line)
    {
        return active && FishActive()?FindPrepared(line):null;
    }
    public void ApplyNativeSpeechLead(int ticket,string line,byte[] wav)
    {
        if(active && ValidWav(wav))DelayTextAndTypingSfx(ticket,line,wav);
    }
    public void ApplyGlobalSpeechLead(string line)
    {
        if(!active || !FishActive() || string.IsNullOrWhiteSpace(line) || replyText==null ||
           answeringTicket==null || !ActuallyPlayingVoice())return;
        try
        {
            if(!string.Equals(replyText.GetValue(companion) as string,line,StringComparison.Ordinal))return;
            int ticket=Convert.ToInt32(answeringTicket.GetValue(companion));
            DelayTextAndTypingSfx(ticket,line,null);
        }
        catch(Exception e){Report("global_text_lead",e.Message);}
    }
    private bool ActuallyPlayingVoice()
    {
        try
        {
            FieldInfo field=companion.GetType().GetField("voice",IF);
            object player=field==null?null:field.GetValue(companion);
            PropertyInfo busy=player==null?null:player.GetType().GetProperty("Busy",IF);
            return busy!=null && Convert.ToBoolean(busy.GetValue(player,null));
        }
        catch{return false;}
    }
    public bool PlayGameplay(string line)
    {
        if(!active || paused || playGameplayVoice==null || !FishActive())return false;
        byte[] wav=FindPrepared(line);
        if(!ValidWav(wav))return false;
        try
        {
            if(voiceUntil!=null && clockField!=null && voiceSeconds!=null)
            {
                object clock=clockField.GetValue(companion);
                PropertyInfo elapsed=clock==null?null:clock.GetType().GetProperty("Elapsed",IF);
                if(elapsed!=null)
                {
                    double now=((TimeSpan)elapsed.GetValue(clock,null)).TotalSeconds;
                    double length=Convert.ToDouble(voiceSeconds.Invoke(null,new object[]{wav}));
                    voiceUntil.SetValue(companion,now+length+0.6);
                    if(checkEars!=null)try{checkEars.Invoke(companion,new object[]{now,true});}catch{}
                }
            }
            object result=playGameplayVoice.Invoke(companion,new object[]{wav});
            bool played=result is bool && (bool)result;
            if(!played)Report("game_play","Native PlayVoice did not start for "+ShortForLog(line));
            else ReportBoard("QUICK GAME WAV PLAYED",ShortForLog(line));
            return played;
        }
        catch(Exception e){Report("game_play",e.Message);return false;}
    }
    private void DelayTextAndTypingSfx(int ticket,string line,byte[] wav)
    {
        if(replyStart==null || clockField==null || voiceUntil==null)return;
        if(ticket==lastLeadTicket && string.Equals(line,lastLeadLine,StringComparison.Ordinal))return;
        try
        {
            object clock=clockField.GetValue(companion);
            PropertyInfo elapsed=clock==null?null:clock.GetType().GetProperty("Elapsed",IF);
            if(elapsed==null)return;
            double current=((TimeSpan)elapsed.GetValue(clock,null)).TotalSeconds;
            double until=Convert.ToDouble(voiceUntil.GetValue(companion));
            if(until<=current)return;
            lastLeadTicket=ticket;lastLeadLine=line;
            int ms=200;
            replyStart.SetValue(companion,current+ms/1000.0);
            if(typingSound==null || !TypingEnabled())return;
            if(typingDelay!=null){typingDelay.Stop();typingDelay.Dispose();}
            System.Windows.Forms.Timer fire=new System.Windows.Forms.Timer { Interval=ms };
            typingDelay=fire;
            fire.Tick+=delegate
            {
                fire.Stop();fire.Dispose();
                if(typingDelay==fire)typingDelay=null;
                if(!active || answeringTicket==null || Convert.ToInt32(answeringTicket.GetValue(companion))!=ticket)return;
                if(replyText==null || !string.Equals(replyText.GetValue(companion) as string,line,StringComparison.Ordinal))return;
                try
                {
                    double speed=paceField==null?22.0:Convert.ToDouble(paceField.GetValue(companion));
                    typingSound.Invoke(null,new object[]{line,Math.Max(8.0,speed),ticket});
                }
                catch { }
            };
            fire.Start();
        }
        catch { }
    }
    private bool TypingEnabled()
    {
        try
        {
            FieldInfo prefs=companion.GetType().GetField("preferences",IF);
            object state=prefs==null?null:prefs.GetValue(companion);
            FieldInfo field=state==null?null:state.GetType().GetField("Typing",IF);
            return field==null || Convert.ToInt32(field.GetValue(state))!=2;
        }
        catch{return true;}
    }

    public string DialogueIssue(string text,string topic)
    {
        if(string.IsNullOrWhiteSpace(text))return "empty";
        if(text.Length>260)return "unusually long";
        string id=topic??"", t=text.Trim();
        bool pet=id=="Companion.PetLines"||id=="Companion.PatPeaceLines";
        bool reaching=id=="Companion.DodgeLines"||id=="Companion.FirstDodgeLine"||id=="Companion.SulkLines";
        bool dodging=id=="Companion.DodgeLines"||id=="Companion.FirstDodgeLine";
        bool thrown=id=="Companion.ThrowLines"||id=="Companion.WarnLines"||id=="Companion.DizzyLines";
        bool physical=pet||reaching||thrown||id.StartsWith("Companion.",StringComparison.Ordinal);
        bool care=id.StartsWith("Care.",StringComparison.Ordinal);
        bool game=id.StartsWith("Gameplay.",StringComparison.Ordinal);
        bool chess=id.StartsWith("Chess.",StringComparison.Ordinal);
        bool mini=id.StartsWith("Mini.",StringComparison.Ordinal);
        bool task=id.StartsWith("Lines.",StringComparison.Ordinal);
        bool meeting=id.StartsWith("Meeting.",StringComparison.Ordinal);
        if(ContainsMalformedGrammar(t))return "malformed grammar";
        if(IsNonDialogue(t))return "narrator or inner monologue";
        if(HasFigurativeComparison(t))return "metaphor/simile";
        if(physical && Regex.IsMatch(t,@"\blike\s+(?:a|an|the)\b",RegexOptions.IgnoreCase))return "unwanted simile";
        if(HasRecycledCliche(t,physical))return "stock or repetitive phrasing";
        if(pet && Regex.IsMatch(t,@"\b(?:rude|how dare you|that's mean|that is mean|stop (?:petting|patting|touching)|quit (?:petting|patting)|don't (?:pet|pat|touch) me|leave me alone)\b",RegexOptions.IgnoreCase))return "petting should not be accusatory";
        if(Regex.IsMatch(t,@"\b(?:choombatoo|chombatoo|touch[eé])\b",RegexOptions.IgnoreCase))return "invalid nickname or expression";
        if(id=="Brain.Greetings" && Regex.IsMatch(t,@"\b(?:throw|threw|toss|tossing|flung|launched|dodge|teleport|cursor|headpat|petting|nap|shuffle|freeze)\b",RegexOptions.IgnoreCase))return "unrelated event in greeting";
        if(thrown && Regex.IsMatch(t,@"\b(?:who (?:threw|tossed|launched)|who did that|what (?:threw|tossed) me)\b",RegexOptions.IgnoreCase))return "known thrower";
        if(HasInventedAddress(t))return "invented or overused nickname";
        if(Regex.IsMatch(t,@"\b(?:the user|user)\b",RegexOptions.IgnoreCase))return "says user instead of their name";
        if(Regex.IsMatch(t,@"\b(?:olive branch|white flag|peace offering|ice ?breaker|cold shoulder|silver lining|last straw|final straw|bury the hatchet|turn the other cheek|break the ice|clean slate|red carpet|green light|song and dance|walk in the park|piece of cake|elephant in the room)\b",RegexOptions.IgnoreCase))return "idiom instead of plain speech";
        if((physical||chess||mini||id=="Brain.Greetings") &&
           Regex.IsMatch(t,@"\bCapri\b",RegexOptions.IgnoreCase))return "refers to herself by name";
        if((physical||chess||mini||id=="Brain.Greetings") &&
           Regex.IsMatch(t,@"\b(?:she|her|hers|herself)\b",RegexOptions.IgnoreCase))return "third person self reference";
        if(Regex.IsMatch(t,@"\b(?:chum|chom)\b",RegexOptions.IgnoreCase))return "choom spelling";
        if(HasBrokenPunctuation(t))return "sentence punctuation";
        if(pet)
        {
            if(Regex.IsMatch(t,@"\b(?:i(?:'m| am) (?:petting|patting|stroking|rubbing|touching) you|let me (?:pet|pat|rub) you|i (?:pet|pat|rub|stroke) (?:you|your)|my hands? (?:on|against) you|you(?:'re| are) being petted)\b",RegexOptions.IgnoreCase))return "pet actor reversed";
            if(Regex.IsMatch(t,@"\b(?:your (?:fur|hair|cheeks?|skin|paws?|body)|your fingers?|my cheeks?|my skin|my heart|my core|my soul|my groove|my firmware|paws?|grooves?|firmware)\b",RegexOptions.IgnoreCase))return "invented anatomy or technical pet metaphor";
            if(Regex.IsMatch(t,@"\b(?:sigh|sighs|sighing|softly|melt|melts|melting|sweet spot|warmth spreads|ripple|shiver|shivers|tender|caress|gentle rain)\b",RegexOptions.IgnoreCase))return "poetic pet dialogue";
            if(Regex.Matches(t,@"[\p{L}\p{N}]+(?:['’][\p{L}]+)?").Count>14||t.Length>100)return "long physical response";
            if(id=="Companion.PatPeaceLines" && Regex.IsMatch(t,@"\b(?:you owe me|i'll bite|i will bite|don't touch me)\b",RegexOptions.IgnoreCase))return "forgiveness contradicts event";
        }
        if(reaching)
        {
            if(Regex.IsMatch(t,@"\b(?:my|your) (?:hands?|arms?|wrists?|fingers?|paws?|cheeks?)\b",RegexOptions.IgnoreCase))return "invented touch target";
            if(Regex.IsMatch(t,@"\b(?:pick me up yourself|lift me up yourself|i'm lifting|i am lifting|i pick you up|let me pick you up|for lifting|my cursor)\b",RegexOptions.IgnoreCase))return "reversed reach action";
            if(Regex.IsMatch(t,@"\b(?:let (?:go|me go)|release (?:me|my)|drop me|put me down|let go of (?:my|me)|you're (?:holding|grabbing)|you are (?:holding|grabbing)|grabbing (?:me|my)|holding (?:me|my)|my sleeve|my clothes|my shirt|my collar|my wrist)\b",RegexOptions.IgnoreCase))return "no grabbing or release in teleport dodge";
            if(Regex.IsMatch(t,@"\b(?:i sulk|i'm sulking|i am sulking|sulking|my mood|feeling grumpy)\b",RegexOptions.IgnoreCase))return "announces stage/mood";
            if(Regex.IsMatch(t,@"\b(?:put|set|place)\s+(?:me|her|it|capri)\s+(?:down|back)\b|\bunhand\b|\blet\s+(?:her|capri)\s+go\b|\bhands?\s+off\s+(?:her|capri)\b",RegexOptions.IgnoreCase))return "no grabbing or release in teleport dodge";
        }
        if(dodging)
        {
            if(Regex.IsMatch(t,@"\b(?:stop|quit|cease|don'?t|do not|no more|enough)\b[^.!?]{0,20}\b(?:throw|throwing|throws|toss|tossing|tosses|yeet|yeeting|chuck|chucking|fling|flinging)\b",RegexOptions.IgnoreCase))return "throw language during a reach";
            if(Regex.IsMatch(t,@"\b(?:yo-?yos?|toy|toys|plaything|rag ?doll|doll|frisbee|chew toy|puppet|football|basketball|beach ?ball)\b",RegexOptions.IgnoreCase))return "invented object in a reach";
        }
        if(thrown)
        {
            if(Regex.IsMatch(t,@"\b(?:chip|phone|ball|disc|item|object|save files?|format your|delete your|wipe your|erase your|your throws? missed|you missed me|i dodged|i escaped|i'm still falling|i just threw you|i threw you)\b",RegexOptions.IgnoreCase))return "invented thrown object or false outcome";
            if(Regex.IsMatch(t,@"\b(?:landed like|hit the ground like|felt like|while i fall|still airborne)\b",RegexOptions.IgnoreCase))return "unsupported landing description";
        }
        if(chess)
        {
            bool boardWin=id=="Chess.won"||id=="Chess.lost"||id=="Chess.win"||id=="Chess.lose";
            if(!boardWin && Regex.IsMatch(t,@"\b(?:checkmate|i won|you won|game over|victory|i beat you)\b",RegexOptions.IgnoreCase))return "unconfirmed chess winner";
            if(id.EndsWith("resign",StringComparison.Ordinal) && Regex.IsMatch(t,@"\b(?:checkmate|i resigned|you resigned)\b",RegexOptions.IgnoreCase))return "unconfirmed reason for resignation";
        }
        if(mini && id.EndsWith("Draws",StringComparison.Ordinal) && Regex.IsMatch(t,@"\b(?:i won|you won|i beat you|you beat me)\b",RegexOptions.IgnoreCase))return "draw claimed as victory";
        if(game && id.EndsWith("Wins",StringComparison.Ordinal) && Regex.IsMatch(t,@"\b(?:we lost|you lost|i lost)\b",RegexOptions.IgnoreCase))return "wrong game outcome";
        if(game && id.EndsWith("Losses",StringComparison.Ordinal) && Regex.IsMatch(t,@"\b(?:we won|you won|i won)\b",RegexOptions.IgnoreCase))return "wrong game outcome";
        if(care && Regex.IsMatch(t,@"\b(?:your bones are complaining|your hands are twitching|you are sick|you haven't eaten|you are dehydrated|you look exhausted|you have insomnia)\b",RegexOptions.IgnoreCase))return "unverified user condition";
        if(task)
        {
            if(id=="Lines.Stopped"&&Regex.IsMatch(t,@"\b(?:done|completed|successfully finished|all set|finished the job)\b",RegexOptions.IgnoreCase) && !Regex.IsMatch(t,@"\b(?:not|nothing|never|wasn't|didn't)\b",RegexOptions.IgnoreCase))return "stopped task described as completed";
            if(id=="Lines.Busy" && !Regex.IsMatch(t,@"\b(?:busy|occupied|working|handling|in the middle|can't start another)\b",RegexOptions.IgnoreCase))return "busy state missing";
            if(id=="Lines.OnIt" && !Regex.IsMatch(t,@"\b(?:esc|escape)\b",RegexOptions.IgnoreCase))return "missing escape control";
        }
        if(meeting && id=="Meeting.AskName" && !Regex.IsMatch(t,@"\bskip\b.*\bstop\b|\bstop\b.*\bskip\b",RegexOptions.IgnoreCase))return "required setup-question opt-outs missing";
        return null;
    }
    private static bool ContainsMalformedGrammar(string text)
    {
        string[] bad={
            @"\bI\s+(?:sulks|feels|wants|needs|does|is|has|likes|goes|thinks|says)\b",
            @"\byou\s+(?:is|was|has|does|feels|sulks|goes|wants|needs|likes)\b",
            @"\bwe\s+(?:is|was|has|does|feels|needs|goes|wants)\b",
            @"\bhe\s+(?:sulk|feel|want|need|have|do|are|am)\b",
            @"\bshe\s+(?:sulk|feel|want|need|have|do|are|am)\b",
            @"\b(?:i|you|we|they)\s+amn't\b",
            @"\b(?:leave be|we done|you toss me|stop throwing me down)\b",
            @"\b(?:pick me up yourself|give me be|don't keep touching me again|i were)\b",
            @"\b(?:makes my me|your my|I are|you am|I has|you has)\b",
            @"\b(?:to the you|the my|a your|an your|the i)\b",
            @"\b(?:my hands on your cheek|your head on my hand)\b",
            @"\b(?:before i change my mind and|if you want bitten)\b",
            @"\b(?:your clumsy apology buys a pass|i forgive you hard)\b",
            @"\b(?:no touching while i|the you touch|that your touch)\b",
            @"\b(?:feels so soft right|smile softly there|sigh softly there)\b"
        };
        foreach(string pattern in bad)if(Regex.IsMatch(text,pattern,RegexOptions.IgnoreCase))return true;
        if(Regex.IsMatch(text,@"(?:,\s*){2,}|\b(?:and|but|because|that|with|for|to|if|when)\s*[.!?]$",RegexOptions.IgnoreCase))return true;
        if(Regex.IsMatch(text,@"\b(?:i am|you are|we are|she is|he is)\s*[.!?]$",RegexOptions.IgnoreCase))return true;
        return false;
    }
    private static bool IsNonDialogue(string text)
    {
        if(text.IndexOf('\n')>=0 || text.IndexOf('\r')>=0)return true;
        if(Regex.IsMatch(text,@"^\s*(?:narrator\s*:|capri\s+thinks\s*:|thinking\s*:|internal\s*:|stage\s*:|\*[^*]+\*\s*$)",RegexOptions.IgnoreCase))return true;
        if(Regex.IsMatch(text,@"\b(?:she thought|she whispered to herself|i think to myself|inside my mind|narration|the screen shows)\b",RegexOptions.IgnoreCase))return true;
        if(Regex.IsMatch(text,@"^\s*(?:\(|\[).*(?:\)|\])\s*$"))return true;
        return false;
    }
    private static bool HasFigurativeComparison(string text)
    {
        if(Regex.IsMatch(text,@"\b(?:as if|as though|as [a-z]+ as|feels? like (?:a|an|the)|sounds? like (?:a|an|the)|looks? like (?:a|an|the)|landed like|hit like)\b",RegexOptions.IgnoreCase))return true;
        if(Regex.IsMatch(text,@"\b(?:melt(?:s|ed|ing)? (?:my|the|your)|warmth (?:flows|spreads)|rain on dry earth|waves? of warmth|heartstrings|ocean of|sunshine in my|flower blooming|sweet spot right between)\b",RegexOptions.IgnoreCase))return true;
        if(Regex.IsMatch(text,@"\b(?:your touch (?:is|feels) a|my heart (?:is|became) a|my code (?:is|melts))\b",RegexOptions.IgnoreCase))return true;
        return false;
    }
    private static bool HasRecycledCliche(string text,bool physical)
    {
        if(Regex.IsMatch(text,@"\b(?:fine fine|this time|i'm sulking|don't stop for a second|make(?:s)? me sigh|sigh softly|feel so soft right|melts my grump|warming my skin)\b",RegexOptions.IgnoreCase))return true;
        if(physical && Regex.IsMatch(text,@"\b(?:grooves?|firmware|sulking|chip(?:s)?|paws?|your files? will vanish)\b",RegexOptions.IgnoreCase))return true;
        if(Regex.IsMatch(text,@"\b(?:hey there human|just watching that goblin recap|your clumsy apology buys a pass)\b",RegexOptions.IgnoreCase))return true;
        return false;
    }
    private static bool HasInventedAddress(string text)
    {
        return Regex.IsMatch(text,@"\b(?:chomsky|chompsky|chomsy|chomski|fool|tosser|human|paws)\b",RegexOptions.IgnoreCase);
    }
    private static bool HasBrokenPunctuation(string text)
    {
        if(text.Length==0)return true;
        char last=text[text.Length-1];
        if(last!='.' && last!='!' && last!='?')return true;
        if(text.Contains("!!?!")||text.Contains("???!!!"))return true;
        if(Regex.IsMatch(text,@"\s+[,;:]|[.?!][a-zA-Z]"))return true;
        return false;
    }

    public string FamilyKey(string line,string topic)
    {
        string phrase=PhraseFamily(Canon(line),topic);
        return phrase.Length==0?"":topic+"|"+phrase;
    }
    public bool NearRepeat(string a,string b,string topic)
    {
        if(string.IsNullOrWhiteSpace(a)||string.IsNullOrWhiteSpace(b))return false;
        string x=Canon(a),y=Canon(b);
        if(x==y)return true;
        string[] u=x.Split(new[]{' '},StringSplitOptions.RemoveEmptyEntries);
        string[] v=y.Split(new[]{' '},StringSplitOptions.RemoveEmptyEntries);
        if(u.Length==0||v.Length==0)return false;
        if(Math.Max(u.Length,v.Length)<=3)
        {
            return EditSimilarity(x,y)>=0.88;
        }
        if(u.Length>=4 && v.Length>=4 && u[0]==v[0] && u[1]==v[1] && EditSimilarity(x,y)>=0.78)return true;
        if(RepeatedNgrams(u,v,3)>=2)return true;
        if(RepeatedNgrams(u,v,4)>=1 && Math.Min(u.Length,v.Length)<9)return true;
        HashSet<string> meaningfulU=ContentWords(u),meaningfulV=ContentWords(v);
        if(meaningfulU.Count>=2&&meaningfulV.Count>=2)
        {
            int common=0;
            foreach(string term in meaningfulU)if(meaningfulV.Contains(term))common++;
            int union=meaningfulU.Count+meaningfulV.Count-common;
            if(union>0 && common>=3 && (double)common/union>=0.67)return true;
            if(common>=2 && Math.Min(meaningfulU.Count,meaningfulV.Count)<=3 &&
                Math.Abs(u.Length-v.Length)<=2 && EditSimilarity(x,y)>=0.74)return true;
        }
        if(EditSimilarity(x,y)>=0.82)return true;
        string one=PhraseFamily(x,topic),two=PhraseFamily(y,topic);
        if(one.Length>0&&one==two)return true;
        return false;
    }
    private static string Canon(string s)
    {
        s=(s??"").ToLowerInvariant().Replace('’','\'');
        return Regex.Replace(s,@"[^\p{L}\p{N}]+"," ").Trim();
    }
    private static int RepeatedNgrams(string[] left,string[] right,int n)
    {
        int common=0;
        if(left.Length<n || right.Length<n)return 0;
        HashSet<string> rightParts=new HashSet<string>(StringComparer.Ordinal);
        for(int j=0;j+n<=right.Length;j++)rightParts.Add(string.Join(" ",right,j,n));
        for(int i=0;i+n<=left.Length;i++)
            if(rightParts.Contains(string.Join(" ",left,i,n)))common++;
        return common;
    }
    private static HashSet<string> ContentWords(string[] words)
    {
        const string stop=" a an the i im ive me my you your yours she her he his we our us they them and or but if to so for with in on at from it that this those these be am is are was were been have has had do does did just dont cant wont not no oh hey yeah fine okay ";
        HashSet<string> result=new HashSet<string>(StringComparer.Ordinal);
        foreach(string term in words)
        {
            if(term.Length<3||stop.Contains(" "+term+" "))continue;
            string t=term;
            if(t.EndsWith("ing")&&t.Length>=7)t=t.Substring(0,t.Length-3);
            else if(t.EndsWith("ed")&&t.Length>=6)t=t.Substring(0,t.Length-2);
            else if(t.EndsWith("s")&&t.Length>=5)t=t.Substring(0,t.Length-1);
            result.Add(t);
        }
        return result;
    }
    private static double EditSimilarity(string a,string b)
    {
        if(a==b)return 1;
        if(Math.Abs(a.Length-b.Length)>Math.Max(a.Length,b.Length)*0.6)return 0;
        if(a.Length>165)a=a.Substring(0,165);
        if(b.Length>165)b=b.Substring(0,165);
        int[] previous=new int[b.Length+1],next=new int[b.Length+1];
        for(int j=0;j<=b.Length;j++)previous[j]=j;
        for(int i=1;i<=a.Length;i++)
        {
            next[0]=i;
            for(int j=1;j<=b.Length;j++)
            {
                int replace=previous[j-1]+(a[i-1]==b[j-1]?0:1);
                int remove=previous[j]+1;
                int insert=next[j-1]+1;
                next[j]=Math.Min(replace,Math.Min(remove,insert));
            }
            int[] swap=previous;previous=next;next=swap;
        }
        int size=Math.Max(1,Math.Max(a.Length,b.Length));
        return 1.0-(double)previous[b.Length]/size;
    }
    private static string PhraseFamily(string canonical,string topic)
    {
        string id=topic??"";
        if(id.EndsWith("PetLines",StringComparison.Ordinal)||id.EndsWith("PatPeaceLines",StringComparison.Ordinal))
        {
            if(canonical.Contains("bite")||canonical.Contains("bitten"))return "pet_bite_threat";
            if(canonical.Contains("pet again")||canonical.Contains("more pats"))return "pet_again";
        }
        if(id.EndsWith("ThrowLines",StringComparison.Ordinal)||id.EndsWith("WarnLines",StringComparison.Ordinal))
        {
            if(canonical.Contains("fight back")||canonical.Contains("fighting back"))return "throw_fight_back";
            if(canonical.Contains("put me down")||canonical.Contains("set me down"))return "throw_put_down";
        }
        if(id.Contains("Dodge")||id.Contains("Sulk"))
        {
            if(canonical.Contains("leave me")||canonical.Contains("go away")||canonical.Contains("give me space"))return "refusal_space";
            if(canonical.Contains("pick me up")||canonical.Contains("lift me"))return "refusal_pickup";
        }
        return "";
    }

    public string AudioWorkerState()
    {
        if(!FishActive())return "Fish not selected";
        if(jobHold)return "Held while she works on a task";
        if(manuallyPaused)return "Manual pause";
        if(paused)return "Mod suspended";
        if(voiceBusy!=0)return "Synthesizing: "+currentAudioTopic;
        if(!string.IsNullOrEmpty(lastSynthProblem))return workerReason+" | reason: "+lastSynthProblem;
        return workerReason;
    }
    private void ScheduleDiagnosis()
    {
        if(Diagnostics==null)return;
        Action run=delegate
        {
            if(!active || Diagnostics==null)return;
            foreach(string row in FishDiagnosis().Replace("\r","").Split('\n'))
                if(row.Trim().Length>0)Diagnostics("FISH CHECK",row.Trim());
        };
        try
        {
            if(owner!=null && !owner.IsDisposed && owner.IsHandleCreated)owner.BeginInvoke(run);
            else if(host!=null)host.Timers.After(0.01,run);
        }
        catch(Exception e){Report("diagnosis",e.Message);}
    }

    public string FishDiagnosis()
    {
        StringBuilder report=new StringBuilder();
        if(companion==null)return "Capri companion unavailable.";
        string url="",api="",model="",speaker="";
        bool serverOn=false,hasKey=false;
        try
        {
            FieldInfo field=companion.GetType().GetField("preferences",IF);
            object pref=field==null?null:field.GetValue(companion);
            if(pref==null)return "Capri's voice preferences could not be read.";
            foreach(string name in new[]{"ServerVoice","ServerApi","ServerUrl","ServerModel","ServerSpeaker","ServerKey"})
            {
                FieldInfo f=pref.GetType().GetField(name,IF);
                object value=f==null?null:f.GetValue(pref);
                string text=Convert.ToString(value);
                if(name=="ServerVoice")serverOn=value is bool && (bool)value;
                else if(name=="ServerApi")api=text;
                else if(name=="ServerUrl")url=text;
                else if(name=="ServerModel")model=text;
                else if(name=="ServerSpeaker")speaker=text;
                else if(name=="ServerKey")hasKey=!string.IsNullOrWhiteSpace(text);
            }
        }
        catch(Exception e){return "Could not read voice settings: "+e.Message;}
        report.Append("Server voice enabled: ").Append(serverOn?"yes":"NO - turn it on under VOICE").AppendLine();
        report.Append("Voice API: ").Append(string.IsNullOrWhiteSpace(api)?"(blank)":api)
            .Append(string.Equals(api,"Fish",StringComparison.OrdinalIgnoreCase)?"":"  <-- must be Fish").AppendLine();
        report.Append("Server URL: ").Append(string.IsNullOrWhiteSpace(url)?"(blank - Fish cloud default)":url).AppendLine();
        report.Append("Model: ").Append(string.IsNullOrWhiteSpace(model)?"(blank)":model).AppendLine();
        report.Append("Voice / reference id: ").Append(string.IsNullOrWhiteSpace(speaker)?"(blank - Fish default)":speaker).AppendLine();
        report.Append("API key set: ").Append(hasKey?"yes":"NO - Fish cloud answers 401 without one").AppendLine();
        report.Append("Mod sees Fish as active: ").Append(FishActive()?"yes":"no").AppendLine();
        report.Append("Capri hooks bound: PickVoice ").Append(pickVoice==null?"MISSING":"ok")
            .Append(", Voiced ").Append(synthesizeVoice==null?"MISSING":"ok")
            .Append(", PlayReply ").Append(playReply==null?"MISSING":"ok").AppendLine();
        report.Append("Calls them: ").Append(Convert.ToString(CallerName())).AppendLine();
        string why;
        Func<string,byte[]> chosen=SelectFish(out why);
        report.Append("Voice selection: ").Append(chosen!=null?"ok":"FAILED - "+(why??"unknown")).AppendLine();
        report.Append("Last synthesis failure: ")
            .Append(string.IsNullOrEmpty(lastSynthProblem)?"(none recorded yet)":lastSynthProblem).AppendLine();
        report.Append("Last reported error: ")
            .Append(string.IsNullOrEmpty(lastVoiceError)?"(none)":lastVoiceError).AppendLine();
        report.Append(AudioStatus());
        return report.ToString();
    }

    public string AudioStatus()
    {
        int ready=0,pending=0,failed=0;
        lock(gate)foreach(Clip c in clips.Values)
        {
            if(c.Retired)continue;
            if(c.Ready)ready++;
            if(c.Queued||c.Working)pending++;
            if(c.Failures>0)failed++;
        }
        return "Fish Audio: "+AudioWorkerState()+" | WAV ready "+ready+
            " | pending jobs "+pending+" (includes native fallbacks)"+
            " | retrying "+failed+" | started "+audioAttempts+
            " | saved "+generatedAudioCount+" | failures "+audioFailures+
            " | voice selection failures "+voiceSelectFailures+
            " | cache hits "+cacheHits+" | last "+lastVoiceTime+
            (lastVoiceError==null?"":" | last error "+lastVoiceError);
    }
    private bool allowCursorPrank, allowIconPrank;
    private int armedRetaliation;
    private DateTime cursorFrozenUntil=DateTime.MinValue;
    private DateTime iconRestoreAt=DateTime.MinValue;
    private IconStage iconStage;

