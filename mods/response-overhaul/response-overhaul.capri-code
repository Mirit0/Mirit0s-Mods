    public void Start(ICapriHost capri)
    {
        if (started) return;
        host = capri;
        window = host.Ui.Window;
        ReadSettings();
        BindCapri();
        voiceEngine = new AiReactionVoice();
        voiceEngine.Start(host);
        voiceEngine.Requeue = PrepareExisting;
        voiceEngine.Diagnostics = DebugAudio;
        voiceEngine.ResolveBoardTopic = ResolveBoardSpeechTopic;
        voiceEngine.CallerName = UserName;
        voiceEngine.SetEmotionEnabled(fishEmotions);
        voiceEngine.PauseGeneration(generationPaused);
        started = true;
        runId++;
        host.Chat.Sending += OnSending;
        host.Chat.Replied += OnReplied;
        host.Chat.Replying += OnReplying;
        host.Voice.Speaking += OnSpeaking;
        host.Voice.Started += OnVoiceStarted;
        if(speechBubble!=null)speechBubble.VisibleChanged+=OnBubbleVisible;
        host.Voice.Finished += OnVoiceFinished;
        host.Ui.AddMenuItem("Choose AI reaction groups", ShowGroupPicker);
        host.Ui.AddMenuItem("Show / hide dialogue loading bar", ToggleProgress);
        host.Ui.AddMenuItem("Last 5 spoken reactions per topic", ShowHistory);
        host.Ui.AddMenuItem("Permanent reaction blacklists", ShowPermanentBlacklists);
        host.Ui.AddMenuItem("Recent generation rejections", ShowRejections);
        host.Ui.AddMenuItem("Reaction debugger (live)", ShowDebugger);
        host.Ui.AddMenuItem("Regenerate one reaction topic", ShowRegenerate);
        host.Ui.AddMenuItem("Pause / resume background generation", ToggleGenerationPause);
        host.Ui.AddMenuItem("Audio cache maintenance", ShowCacheMaintenance);
        host.Ui.AddMenuItem("Toggle greeting memory context", ToggleGreetingMemory);
        host.Ui.SetOptions("AI Response Overhaul", MakeOptions);
        BuildPools();
        LoadHistory();
        LoadPermanentBlacklist();
        LoadShownHistory();
        LoadSelectedHistory();
        LoadReachQuota();
        RetireOldPreparedOnce();
        RetireBadPhysicalQueueOnce();
        ImportLegacyPreparedLines();
        LoadGenerated();
        RevalidateGreetingCache();
        SyncTakeoffSilence();
        EnableCareOverlay();
        SyncGameHook();
        initialized = true;
        PrepareExisting();
        timer = new System.Windows.Forms.Timer();
        timer.Interval = 150;
        timer.Tick += OnTick;
        timer.Start();
        host.Timers.After(1, delegate { if (started) { RefreshSlots();
            if(progressVisible) OpenProgress(); } });
        host.Log("AI Response Overhaul v" + Version + ": fresh scheduler, physical reactions enabled by default.");
    }

    private void ReadSettings()
    {
        cursorLock = host.Store.Flag("v2.cursor", false);
        iconShuffle = host.Store.Flag("v2.icons", false);
        fishEmotions = host.Store.Flag("v2.fish-emotions", true);
        progressVisible = host.Store.Flag("v2.progress-visible", false);
        firstFillDone = host.Store.Flag("v2.9.first-fill", false);
        generationPaused = host.Store.Flag("v2.5.generation-paused", false);
        greetingMemoryEnabled = host.Store.Flag("v2.5.greeting-memory", true);
        string saved = host.Store.Get("v2.groups", Physical);
        selections = new HashSet<string>(StringComparer.Ordinal);
        foreach (string part in saved.Split(',')) if (Array.IndexOf(groupIds, part) >= 0) selections.Add(part);
    }
    private void SaveSettings()
    {
        host.Store.Set("v2.cursor", cursorLock);
        host.Store.Set("v2.icons", iconShuffle);
        host.Store.Set("v2.fish-emotions", fishEmotions);
        host.Store.Set("v2.progress-visible", progressVisible);
        host.Store.Set("v2.5.generation-paused", generationPaused);
        host.Store.Set("v2.5.greeting-memory", greetingMemoryEnabled);
        List<string> enabled = new List<string>();
        foreach (string id in groupIds) if (selections.Contains(id)) enabled.Add(id);
        host.Store.Set("v2.groups", string.Join(",", enabled.ToArray()));
        CallVoice("SetEmotionEnabled", fishEmotions);
    }
    private AiReactionVoice Voice() { return voiceEngine; }
    private object CallVoice(string method, params object[] args)
    {
        object voice = Voice();
        if (voice == null) return null;
        try
        {
            MethodInfo target = voice.GetType().GetMethod(method, IF);
            return target == null ? null : target.Invoke(voice, args);
        }
        catch (TargetInvocationException e) { lastError = Short((e.InnerException ?? e).Message, 120); return null; }
        catch (Exception e) { lastError = Short(e.Message, 120); return null; }
    }
    private void RevalidateGreetingCache()
    {
        Pool p=Find("Brain.Greetings");
        if(p==null)return;
        if(p.Ready!=null && CheckLine(p,p.Ready,true)!=null)
        { ExcludeLineGlobally(p.Ready); CallVoice("Retire",p.Ready); p.Ready=null; }
        for(int i=p.Reserve.Count-1;i>=0;i--)
            if(CheckLine(p,p.Reserve[i],true)!=null)
            { ExcludeLineGlobally(p.Reserve[i]); CallVoice("Retire",p.Reserve[i]); p.Reserve.RemoveAt(i); }
        SaveLine(p);
    }
    private void PrepareExisting()
    {
        if(!started || Voice()==null) return;
        PrepareGreetingFallbacks();
        PrepareReachPriority();
        PrepareRetaliationAnnouncements();
        PrepareThrowFallbacks();
        PreparePhysicalFallbacks();
        PrepareBoardFallbacks();
        foreach(Pool p in pools) if(Enabled(p))
        {
            if(p.Ready!=null) CallVoice("Prepare",p.Ready,p.Id,p.Group);
            foreach(string line in p.Reserve) CallVoice("Prepare",line,p.Id,p.Group);
        }
    }
    private void PrepareGreetingFallbacks()
    {
        Pool p=Find("Brain.Greetings");
        if(!Enabled(p))return;
        if(p.Originals!=null && p.Originals.Length>0)
        {
            int i=GreetingSlot(p);
            if(i>=0 && i<p.Originals.Length && !IsGloballyExcluded(p.Originals[i]))
                CallVoice("PreparePriority",p.Originals[i],p.Id,p.Group);
        }
        if(p.Ready!=null)CallVoice("PreparePriority",p.Ready,p.Id,p.Group);
    }
    private void PrepareRetaliationAnnouncements()
    {
        if(cursorLock)CallVoice("PreparePriority",CursorThreat,"Companion.DodgeLines",Physical);
        if(iconShuffle)CallVoice("PreparePriority",IconThreat,"Companion.DodgeLines",Physical);
    }
    private const string CursorThreat="Next time, I'll freeze your cursor.";
    private const string IconThreat="Next time, I'll shuffle your desktop icons.";
    private bool IsRetaliationBusy()
    { object busy=CallVoice("RetaliationBusy");return busy is bool && (bool)busy; }
    private string RollRetaliationAnnouncement()
    {
        if((!cursorLock && !iconShuffle) || IsRetaliationBusy() || choiceDice.NextDouble()>=0.10)return null;
        string candidate=cursorLock && iconShuffle ? (choiceDice.Next(2)==0 ? CursorThreat : IconThreat) :
            cursorLock ? CursorThreat : IconThreat;
        byte[] wav=CallVoice("PreparedBytes",candidate) as byte[];
        if(wav==null || wav.Length<44)
        { CallVoice("PreparePriority",candidate,"Companion.DodgeLines",Physical); return null; }
        return candidate;
    }
    private void PrepareBoardFallbacks()
    {
        if(!selections.Contains(Board))return;
        foreach(Pool p in pools)
        {
            if(p.Group!=Board || p.Originals==null)continue;
            int seen=0;
            foreach(string line in p.Originals)
            {
                if(string.IsNullOrWhiteSpace(line) || IsGloballyExcluded(line))continue;
                CallVoice("PreparePriority",line,p.Id,p.Group);
                if(++seen>=4)break;
            }
        }
    }
    private string ResolveBoardSpeechTopic(string line)
    {
        if(!selections.Contains(Board) || string.IsNullOrWhiteSpace(line))return null;
        string key=Normalized(line);
        foreach(Pool p in pools)
        {
            if(p.Group!=Board)continue;
            if(p.Ready!=null && Normalized(p.Ready)==key)return p.Id;
            foreach(string alt in p.Reserve)if(Normalized(alt)==key)return p.Id;
            if(p.Originals!=null)foreach(string alt in p.Originals)
                if(!string.IsNullOrWhiteSpace(alt) && Normalized(alt)==key)return p.Id;
        }
        return null;
    }
    private void BindCapri()
    {
        FieldInfo ownerField = host.GetType().GetField("capri", IF);
        companion = ownerField == null ? null : ownerField.GetValue(host);
        if (companion == null) throw new InvalidOperationException("Capri 0.9.0 companion wasn't found.");
        Type ct = companion.GetType();
        FieldInfo brainLink = ct.GetField("brain", IF);
        brain = brainLink == null ? null : brainLink.GetValue(companion);
        if (brain == null) throw new InvalidOperationException("Capri 0.9.0 Brain wasn't found.");
        brainType = brain.GetType();
        transcriptMethod=brainType.GetMethod("Transcribe",SF,null,
            new[]{typeof(string),typeof(string),typeof(bool)},null);
        isolatedQuick = brainType.GetMethod("Quick", IF, null, new Type[] { typeof(string), typeof(string), typeof(int), typeof(bool), typeof(byte[][]) }, null);
        isolatedAside = brainType.GetMethod("Aside", IF, null, new Type[] { typeof(string), typeof(string), typeof(int), typeof(bool) }, null);
        isolatedCancel = brainType.GetMethod("Cancel", IF, null, Type.EmptyTypes, null);
        copyServer = brainType.GetMethod("CopyServer", IF, null, new Type[] { brainType }, null);
        if (isolatedQuick == null && isolatedAside == null) throw new InvalidOperationException("The 0.9.0 text-generation methods are missing.");
        modelField = brainType.GetField("Model", IF);
        personaProperty = brainType.GetProperty("Persona", SF);
        nicknameField = brainType.GetField("Nickname", SF);
        nativeVoiceField = ct.GetField("voice", IF);
        speechField = ct.GetField("speech", IF);
        anchorField = ct.GetField("anchor", IF);
        speechStartedField = ct.GetField("speechStart", IF);
        heardField = ct.GetField("heard", IF);
        askingField = ct.GetField("asking", IF);
        replyField = ct.GetField("reply", IF);
        answerVoiceField = ct.GetField("answerVoice", IF);
        paceField = ct.GetField("pace", IF);
        replyStartField = ct.GetField("replyStart", IF);
        clockField = ct.GetField("clock", IF);
        voiceUntilField = ct.GetField("voiceUntil", IF);
        nativePlayReply = ct.GetMethod("PlayReply", IF, null, new Type[] { typeof(string), typeof(byte[]) }, null);
        nativeCancelAudio = ct.GetMethod("CancelAnswerAudio", IF, null, Type.EmptyTypes, null);
        Type voice = ct.Assembly.GetType("CapriDesktop.Voice", false);
        if (voice != null) nativeSeconds = voice.GetMethod("Seconds", SF, null, new Type[] { typeof(byte[]) }, null);
        Type sfx = ct.Assembly.GetType("CapriDesktop.Sfx", false);
        if (sfx != null) nativeTypingSfx = sfx.GetMethod("Type", SF, null, new Type[] { typeof(string), typeof(double), typeof(int) }, null);
        jobField=ct.GetField("job",IF);
        modelProperty=brainType.GetProperty("Model",IF);
        thrownField=ct.GetField("thrown",IF);
        fallingField=ct.GetField("falling",IF);
        yelpTicketField=ct.GetField("yelpTicket",IF);
        hiddenField=ct.GetField("hidden",IF);
        workingField=ct.GetField("working",IF);
        talkStateField=ct.GetField("talkState",IF);
        FieldInfo box=ct.GetField("box",IF);
        speechBubble=box==null?null:box.GetValue(companion) as Control;
        if(speechBubble!=null)speechPromptField=speechBubble.GetType().GetField("Prompt",IF);
        closeTalkMethod=ct.GetMethod("CloseTalk",IF,null,new[]{typeof(bool)},null);
        foreach(MethodInfo method in ct.GetMethods(IF))
        {
            if(method.Name!="Answer" || method.ReturnType!=typeof(void))continue;
            ParameterInfo[] args=method.GetParameters();
            if(args.Length!=5 || args[0].ParameterType!=typeof(int) || args[1].ParameterType!=typeof(string) ||
                !args[2].ParameterType.IsEnum || args[3].ParameterType!=typeof(bool) || args[4].ParameterType!=typeof(bool))continue;
            answerNativeMethod=method;
            try {talkingState=Enum.Parse(args[2].ParameterType,"Talking");}catch{}
            beginNativeMethod=ct.GetMethod("Begin",IF,null,new[]{typeof(int),typeof(string),args[2].ParameterType,typeof(byte[]),typeof(double)},null);
            if(beginNativeMethod==null) beginNativeMethod=ct.GetMethod("Begin",IF,null,new[]{typeof(int),typeof(string),args[2].ParameterType,typeof(byte[])},null);
            break;
        }
        nativeGameDisplay = ct.GetMethod("ReactionShow", IF, null, new Type[] { typeof(string), typeof(bool) }, null);
        nativeGameTest = ct.GetField("reactVoiceTest", IF);
        Type rt = ct.Assembly.GetType("CapriDesktop.Reactions", false);
        if (rt != null)
        {
            nativeGameAsk = rt.GetField("Ask", SF);
            nativeGameShow = rt.GetField("Show", SF);
        }
    }

    private void Register(string type, string field, string id, string group, string eventText, string kind)
    {
        Type source = companion.GetType().Assembly.GetType(type, false);
        FieldInfo member = source == null ? null : source.GetField(field, SF);
        string[] slots = member == null ? null : member.GetValue(null) as string[];
        if (slots == null || slots.Length == 0 || slots.Length > 60) return;
        Pool pool = new Pool { Id = id, Group = group, Kind = kind, Event = eventText,
            Slots = slots, Originals = (string[])slots.Clone(), Examples = (string[])slots.Clone(),
            IsGreeting = id == "Brain.Greetings" };
        pools.Add(pool);
    }
    private void RegisterRow(string type, string field, int row, string id, string group, string eventText, string kind)
    {
        Type source = companion.GetType().Assembly.GetType(type, false);
        FieldInfo member = source == null ? null : source.GetField(field, SF);
        string[][] rows = member == null ? null : member.GetValue(null) as string[][];
        if (rows == null || row >= rows.Length || rows[row] == null || rows[row].Length == 0) return;
        string[] arr = rows[row];
        pools.Add(new Pool { Id=id, Group=group, Event=eventText, Kind=kind,
            Slots=arr, Originals=(string[])arr.Clone(), Examples=(string[])arr.Clone() });
    }
    private void RegisterSynthetic(string id, string group, string eventText, string kind, string[] examples, bool game, bool care)
    {
        pools.Add(new Pool { Id=id, Group=group, Event=eventText, Kind=kind,
            Slots=new [] { "" }, Originals=new [] { "" }, Examples=examples ?? new string[0],
            Synthetic=true, IsGame=game, IsCheckIn=care });
    }
    private void BuildPools()
    {
        string ct="CapriDesktop.Companion", bt="CapriDesktop.Brain", task="CapriDesktop.Lines";
        Register(ct,"PetLines","Companion.PetLines",Physical,"User gently pets Capri. Capri is the one being petted; she responds aloud, cheekily.","pet");
        Register(ct,"PatPeaceLines","Companion.PatPeaceLines",Physical,"User pats Capri after upsetting her. Capri reluctantly forgives them.","peace");
        Register(ct,"ThrowLines","Companion.ThrowLines",Physical,"User threw Capri. Capri has landed. She reacts to being thrown herself.","throw");
        Register(ct,"WarnLines","Companion.WarnLines",Physical,"User has thrown Capri repeatedly and Capri warns them.","warn");
        Register(ct,"DizzyLines","Companion.DizzyLines",Physical,"Capri landed hard and is briefly dizzy.","dizzy");
