        Register(ct,"SorryLines","Companion.SorryLines",Physical,"User apologized to Capri. She accepts the apology.","peace");
        Register(ct,"AloneLines","Companion.AloneLines",Physical,"Capri has cooled off after being left alone.","refuse");
        Register(bt,"Greetings","Brain.Greetings",Physical,"Capri greets the user. Keep to the current time of day, no invented accomplishments.","greet");
        Register(ct,"WakeLines","Companion.WakeLines",Physical,"User called Capri. She acknowledges them very briefly.","social");
        Register(ct,"PopLines","Companion.PopLines",Physical,"Capri pops onto the desktop with a playful remark.","social");
        Register(ct,"NudgeLines","Companion.NudgeLines",Physical,"Capri briefly asks user for attention.","social");
        Register(ct,"NoticedLines","Companion.NoticedLines",Physical,"User noticed Capri asking for attention.","social");
        Register(ct,"SnubbedLines","Companion.SnubbedLines",Physical,"User ignored Capri's attention request. Respond playfully.","social");
        Register(ct,"HomeGameLines","Companion.HomeGameLines",Other,"Cyberpunk 2077 started. Capri is excited.","other");
        Register(ct,"HomeSongLines","Companion.HomeSongLines",Other,"Music associated with Night City started.","other");
        Register(ct,"LagLines","Companion.LagLines",Other,"Computer is lagging. Capri gives a quick remark without diagnostics.","other");
        Register(bt,"HalloweenLines","Brain.HalloweenLines",Other,"It is October 31. Capri says happy Halloween.","greet");
        Register(task,"OnIt","Lines.OnIt",Other,"Capri is starting a task; remind the user Escape can stop her.","task");
        Register(task,"GotIt","Lines.GotIt",Other,"Capri acknowledges an addition to an ongoing task.","task");
        Register(task,"Changed","Lines.Changed",Other,"Capri acknowledges a change in an ongoing task.","task");
        Register(task,"Stopped","Lines.Stopped",Other,"A task was stopped and has not necessarily finished.","task");
        Register(task,"Busy","Lines.Busy",Other,"Capri is busy and cannot start another task.","task");
        string[] games={"Kills","Streaks","Comebacks","Deaths","Again","Ended","Hits","Flashes","Sounds","Scenes","Darks","Wins","Losses","Unlocks"};
        string[] events={"The user eliminated an opponent in a game.","The user is on a confirmed game kill streak.","The user made a comeback after dying repeatedly.","The user's game character died.","The user died again in game.","The user's kill streak just ended.","The user's game character took damage.","The game showed a bright flash.","The game made a sudden loud sound.","The game changed scenes.","The game screen became dark.","The user won this game or round.","The user lost this game or round.","The user unlocked an in-game achievement."};
        Type reaction=companion.GetType().Assembly.GetType("CapriDesktop.Reactions",false);
        for(int i=0;i<games.Length;i++)
        {
            FieldInfo fld=reaction==null?null:reaction.GetField(games[i],SF);
            RegisterSynthetic("Gameplay."+games[i],Gaming,events[i],"gaming",fld==null?null:fld.GetValue(null) as string[],true,false);
