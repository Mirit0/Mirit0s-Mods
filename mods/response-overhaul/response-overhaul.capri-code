        string[] chessIds={"your_queen","her_queen","your_check","her_check","won","lost","blunder","draw","resign"};
        string[] chessEvents={"Capri captured the USER's queen. No winner is established.","USER captured Capri's queen. No winner is established.","Capri put USER in check, not necessarily checkmate.","USER put Capri in check, not necessarily checkmate.","Capri WON chess.","USER WON chess.","A blunder occurred in chess; no invented piece or winner.","Chess ended in a draw.","A chess player resigned; do not infer checkmate or who won without confirmed context."};
        for(int i=0;i<chessIds.Length;i++) RegisterRow("CapriDesktop.ChessLines","Lines",i,"Chess."+chessIds[i],Board,chessEvents[i],"chess");
        string[] mini={"Moves","Wins","Losses","Draws"};
