        for(int i=0;i<mini.Length;i++) Register("CapriDesktop.MiniChat",mini[i],"Mini."+mini[i],Board,miniEvent[i],"mini");
        Register("CapriDesktop.Swarm","HaulLines","Clones.Haul",Other,"A clone moves a desktop window, without harming a file.","clone");
